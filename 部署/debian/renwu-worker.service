[Unit]
Description=Renwu Apalis and MQTT worker
After=network-online.target postgresql.service emqx.service
Wants=network-online.target

[Service]
Type=simple
User=renwu
Group=renwu
WorkingDirectory=/opt/renwu
EnvironmentFile=/etc/renwu/renwu.env
ExecStart=/opt/renwu/bin/renwu-houduan worker
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/renwu
UMask=0077

[Install]
WantedBy=multi-user.target
