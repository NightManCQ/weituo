									<view class="sj_jing_you_shang">
										<image class="sj_tu_14" :src="项.右上图标" mode="aspectFit"></image>
										<text class="sj_jing_you_zi" :class="项.右上类">{{ 项.右上文 }}</text>
									</view>
								</view>
								<text class="sj_jing_biao_ti" :class="项.两行 ? 'sj_jing_biao_ti_2' : ''">{{ 项.标题 }}</text>
								<text class="sj_jing_miao">{{ 项.描述 }}</text>
							</view>
							<view class="sj_jing_di">
								<view class="sj_jing_jia_hang">
									<text class="sj_jing_jia">{{ 项.价 }}</text>
									<text class="sj_jing_pts">PTS</text>
								</view>
								<view class="sj_jing_an" :class="项.按钮底类">
									<text class="sj_jing_an_zi" :class="项.按钮字类">{{ 项.按钮 }}</text>
								</view>
							</view>
						</view>
					</view>
				</scroll-view>
			</view>

			<!-- ④ 圈子热帖 -->
			<view class="sj_duan4">
				<view class="sj_re_biao_hang">
					<text class="sj_biao">圈子热帖</text>
					<view class="sj_fen_duan">
						<view class="sj_fen_an" :class="当前分段 == '关注' ? 'sj_fen_an_ji' : ''" data-key="关注" @click="切换分段">
							<text class="sj_fen_zi" :class="当前分段 == '关注' ? 'sj_fen_zi_ji' : ''">关注</text>
						</view>
						<view class="sj_fen_an" :class="当前分段 == '推荐' ? 'sj_fen_an_ji' : ''" data-key="推荐" @click="切换分段">
							<text class="sj_fen_zi" :class="当前分段 == '推荐' ? 'sj_fen_zi_ji' : ''">推荐</text>
						</view>
						<view class="sj_fen_an" :class="当前分段 == '同城' ? 'sj_fen_an_ji' : ''" data-key="同城" @click="切换分段">
							<text class="sj_fen_zi" :class="当前分段 == '同城' ? 'sj_fen_zi_ji' : ''">同城</text>
						</view>
					</view>
				</view>

				<view class="sj_tie_lie">
					<!-- 帖 1 -->
