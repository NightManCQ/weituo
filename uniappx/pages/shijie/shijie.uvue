<script setup lang="ts">
import { computed, ref } from 'vue'

/**
 * 设计图/世界.html 的迁移版（深色 World 发现页）。
 *
 * 界面按设计稿 1:1 落地：快速搜索 → 同城互助雷达 HUD → 快捷探索矩阵 6 卡 →
 * 委托广场精选横滑 3 卡 → 圈子热帖（关注/推荐/同城 + 2 帖）→ 右下悬浮发布按钮。
 * 顶栏 / 底栏不在本页渲染：本页由首页 pages/shou_ye/shou_ye 当组件用 v-if 挂载，
 * 顶栏统一由首页那份 ding_lan 渲染（世界页标题 World），底栏统一由首页 di_lan 渲染；
 * 本页只留顶部 / 底部占位做内容避让。页面级滚动：根容器不锁死高度，内容自然撑开。
 *
 * 设计稿里的运营位（雷达人数、精选委托、圈子热帖）都是静态展示内容，后端没有对应
 * 接口，按原样落地而不编造数据。图标本地化为 static/shijie/icons/*.svg，
 * 头像与配图落地为 static/shijie/img/*.jpg；模糊光晕用预烘焙的径向渐隐 PNG
 * （uvue 没有 blur 滤镜，App 端也不支持 radial-gradient）。
 *
 * 交互照设计稿 JS 还原：分段切换、点赞、打赏、报名、雷达按压、发布提示。
 * 「委托广场」「发布委托」是 pages.json 注册的独立页面：矩阵第一卡、精选「全部 320+」
 * 与精选卡用 uni.navigateTo 打开委托广场页，右下悬浮按钮打开发布委托页。
 * 不再通过 change-tab 在首页内用 v-if 切换（设计稿 FAB 只弹 toast，这里接真实发布页）。
 */

type 矩阵项 = {
	键 : string
	标题 : string
	副标题 : string
	图标 : string
	图底类 : string
	徽章 : string
	徽章底类 : string
	徽章字类 : string
	光晕 : string
}
type 精选项 = {
	键 : string
	分类 : string
	分类底类 : string
	分类字类 : string
	右上图标 : string
	右上文 : string
	右上类 : string
	标题 : string
	两行 : boolean
	描述 : string
	价 : string
	按钮 : string
	按钮底类 : string
	按钮字类 : string
}

// 组件的 onLoad 不触发，窗口信息在 setup 期间同步取值
const 系统信息 : any = uni.getSystemInfoSync()
const 状态栏高 = ref(系统信息.statusBarHeight ?? 0)
const 窗口底高 = ref(系统信息.windowBottom ?? 0)

// 顶部 = 顶栏 64 + 状态栏；底部照设计稿 main pb-20(80) + 容器 pb-6(24) = 104
const 顶部占位 = computed(() : number => 64 + 状态栏高.value)
const 底部占位 = computed(() : number => 104 + 窗口底高.value)
const 悬浮底距 = computed(() : number => 96 + 窗口底高.value)

const 图标 = '/static/shijie/icons/'
const 配图 = '/static/shijie/img/'
const 光斑 = '/static/guang/'

/* ---------------- 交互状态 ---------------- */
const 搜索词 = ref('')
const 当前分段 = ref('推荐')
const 已点赞 = ref(false)
const 点赞数 = ref(48)
const 已打赏 = ref(false)
const 已报名 = ref(false)
const 雷达按下 = ref(false)
const 提示可见 = ref(false)
const 提示文字 = ref('')
let 提示计时器 : any = null

const 赞图标 = computed(() => 已点赞.value ? 图标 + 'favorite.svg' : 图标 + 'favorite_border.svg')
const 打赏文字 = computed(() => 已打赏.value ? '已打赏!' : '赏花 5 PTS')
const 报名文字 = computed(() => 已报名.value ? '已报名 (19)' : '报名想去 (18)')

function 显示提示(文字 : string) {
	提示文字.value = 文字
	提示可见.value = true
	if (提示计时器 != null) clearTimeout(提示计时器)
	提示计时器 = setTimeout(() => { 提示可见.value = false }, 2200)
}

function 通用提示(事件 : any) {
	const 文案 = 事件.currentTarget.dataset['msg']
	显示提示(文案 == null ? '功能即将上线' : String(文案))
}

function 切换分段(事件 : any) {
	const 键 = 事件.currentTarget.dataset['key']
	当前分段.value = 键 == null ? '推荐' : String(键)
}

function 点赞() {
	if (已点赞.value) 点赞数.value = 点赞数.value - 1
	else 点赞数.value = 点赞数.value + 1
	已点赞.value = !已点赞.value
}

function 打赏() {
	已打赏.value = true
}

function 报名() {
	已报名.value = !已报名.value
}

function 开雷达() {
	雷达按下.value = !雷达按下.value
}

/** 页面级跳转：委托广场是独立页面，不在首页内用 v-if 切换 */
function 去委托广场() {
	uni.navigateTo({ url: '/pages/weituo/wei_tuo_guang_chang' })
}

/** 页面级跳转：发布委托同样是独立页面 */
function 去发布() {
	uni.navigateTo({ url: '/pages/fabuweituo/fa_bu_w_t' })
}

function 矩阵点击(事件 : any) {
	const 键 = 事件.currentTarget.dataset['key']
	if (键 == '委托广场') {
		去委托广场()
		return
	}
	const 找到 = 矩阵列表.find((项) => 项.键 == 键)
	显示提示((找到 == null ? '该服务' : 找到.标题) + ' 即将上线')
}

/* ---------------- 静态内容 ---------------- */
const 矩阵列表 : 矩阵项[] = [
	{
		键: '委托广场', 标题: '委托广场', 副标题: '海量任务 积分变现',
		图标: 图标 + 'fire.svg', 图底类: 'sj_ju_tu_cheng',
		徽章: '99+新悬赏', 徽章底类: 'sj_hui_hong', 徽章字类: 'sj_hui_hong_zi',
		光晕: 光斑 + 'cheng_15.png',
	},
	{
		键: '圈子动态', 标题: '圈子动态', 副标题: '伙伴生活与接单日常',
		图标: 图标 + 'auto_awesome.svg', 图底类: 'sj_ju_tu_zi',
		徽章: '好友更新', 徽章底类: 'sj_hui_zi', 徽章字类: 'sj_hui_zi_zi',
		光晕: 光斑 + 'zi_20.png',
	},
	{
		键: '互助公会', 标题: '互助公会', 副标题: '组队开黑与协同攻坚',
		图标: 图标 + 'shield.svg', 图底类: 'sj_ju_tu_lv',
		徽章: '公会争霸', 徽章底类: 'sj_hui_lv', 徽章字类: 'sj_hui_lv_zi',
		光晕: '',
	},
	{
		键: '技能集市', 标题: '技能集市', 副标题: '认证专家 随时呼叫',
		图标: 图标 + 'terminal.svg', 图底类: 'sj_ju_tu_liang',
		徽章: '达人推荐', 徽章底类: 'sj_hui_gao', 徽章字类: 'sj_hui_gao_zi',
		光晕: '',
	},
	{
		键: '积分商城', 标题: '积分商城', 副标题: '兑换周边与专属徽章',
		图标: 图标 + 'toll.svg', 图底类: 'sj_ju_tu_huang',
		徽章: '限时换礼', 徽章底类: 'sj_hui_gao', 徽章字类: 'sj_hui_cheng_zi',
		光晕: '',
	},
	{
		键: '信用法庭', 标题: '信用法庭', 副标题: '公平仲裁与纠纷裁决',
		图标: 图标 + 'balance.svg', 图底类: 'sj_ju_tu_liang',
		徽章: '评审陪审', 徽章底类: 'sj_hui_gao', 徽章字类: 'sj_hui_gao_zi',
		光晕: '',
	},
]

const 精选列表 : 精选项[] = [
	{
		键: 'figma', 分类: 'UI/UX 设计', 分类底类: 'sj_biao_zi', 分类字类: 'sj_biao_zi_zi',
		右上图标: 图标 + 'schedule.svg', 右上文: '剩 4h', 右上类: 'sj_you_cheng',
		标题: 'Figma 移动端设计规范重构', 两行: false,
		描述: '重构暗黑主题组件库与 Token 映射', 价: '1,200',
		按钮: '立即竞标', 按钮底类: 'sj_an_zhu', 按钮字类: 'sj_an_zhu_zi',
	},
	{
		键: 'song', 分类: '同城速递', 分类底类: 'sj_biao_cheng', 分类字类: 'sj_biao_cheng_zi',
		右上图标: 图标 + 'near_me.svg', 右上文: '距你 1.2km', 右上类: 'sj_you_lv',
		标题: '同城极速取送 · 展会紧急物料', 两行: true,
		描述: '静安大悦城至博览中心，今日14点前送达', 价: '350',
		按钮: '抢单接下', 按钮底类: 'sj_an_lv', 按钮字类: 'sj_an_lv_zi',
	},
	{
		键: 'heyue', 分类: '区块链安全', 分类底类: 'sj_biao_liang', 分类字类: 'sj_biao_liang_zi',
		右上图标: 图标 + 'group.svg', 右上文: '招募中', 右上类: 'sj_you_hui',
		标题: '智能合约安全审计与复核', 两行: false,
		描述: 'ERC-4337 抽象账户钱包逻辑白盒渗透测试', 价: '2,500',
		按钮: '了解详情', 按钮底类: 'sj_an_liang', 按钮字类: 'sj_an_liang_zi',
	},
]
</script>

<template>
	<view class="sj_ye">
		<view class="sj_nei" :style="{ paddingTop: 顶部占位 + 'px', paddingBottom: 底部占位 + 'px' }">

			<!-- ① 搜索 + 同城互助雷达 -->
			<view class="sj_duan1">
				<view class="sj_sou_suo">
					<image class="sj_sou_tu" :src="图标 + 'search.svg'" mode="aspectFit"></image>
					<input
						class="sj_sou_kuang"
						v-model="搜索词"
						placeholder="探索圈子、互助热门、同城雷达..."
						placeholder-class="sj_zhan_wei"
					/>
					<view class="sj_sou_you" data-msg="语音搜索即将上线" @click="通用提示">
						<image class="sj_tu_18" :src="图标 + 'mic.svg'" mode="aspectFit"></image>
					</view>
				</view>

				<view class="sj_lei_da">
					<image class="sj_lei_guang" :src="光斑 + 'lv_20.png'" mode="scaleToFill"></image>
					<view class="sj_lei_nei">
						<view class="sj_lei_zuo">
							<view class="sj_lei_tu_kuai">
								<view class="sj_lei_bo"></view>
								<image class="sj_tu_24" :src="图标 + 'radar.svg'" mode="aspectFit"></image>
								<view class="sj_lei_dian"></view>
							</view>
							<view class="sj_lei_wen">
								<view class="sj_lei_biao_hang">
									<text class="sj_lei_biao">面对面互助雷达</text>
									<view class="sj_live"><text class="sj_live_zi">LIVE</text></view>
								</view>
								<text class="sj_lei_fu">同城 128 位伙伴在线 · 3项急约发生中</text>
							</view>
						</view>
						<view class="sj_lei_an" :class="雷达按下 ? 'sj_lei_an_ya' : ''" @click="开雷达">
							<text class="sj_lei_an_zi">开启雷达</text>
							<image class="sj_tu_16" :src="图标 + 'chevron_right.svg'" mode="aspectFit"></image>
						</view>
					</view>
				</view>
			</view>

			<!-- ② 快捷探索矩阵 -->
			<view class="sj_duan2">
				<view class="sj_biao_hang">
					<text class="sj_biao">快捷探索矩阵</text>
					<text class="sj_biao_fu">HUB SERVICES</text>
				</view>
				<view class="sj_wang_ge">
					<view
						v-for="(项, 序) in 矩阵列表"
						:key="项.键"
						class="sj_ju_ka"
						:class="序 + 2 >= 矩阵列表.length ? 'sj_ju_ka_wei' : ''"
						:data-key="项.键"
						@click="矩阵点击"
					>
						<image v-if="项.光晕 != ''" class="sj_ju_guang" :src="项.光晕" mode="scaleToFill"></image>
						<view class="sj_ju_ding">
							<view class="sj_ju_tu_kuai" :class="项.图底类">
								<image class="sj_tu_22" :src="项.图标" mode="aspectFit"></image>
							</view>
							<view class="sj_ju_hui" :class="项.徽章底类">
								<text class="sj_ju_hui_zi" :class="项.徽章字类">{{ 项.徽章 }}</text>
							</view>
						</view>
						<text class="sj_ju_biao">{{ 项.标题 }}</text>
						<text class="sj_ju_fu">{{ 项.副标题 }}</text>
					</view>
				</view>
			</view>

			<!-- ③ 委托广场精选（横向滚动） -->
			<view class="sj_duan3">
				<view class="sj_jing_biao_hang">
					<view class="sj_jing_biao_zuo">
						<image class="sj_tu_20" :src="图标 + 'fire.svg'" mode="aspectFit"></image>
						<text class="sj_biao">委托广场精选</text>
					</view>
					<view class="sj_jing_geng" @click="去委托广场">
						<text class="sj_jing_geng_zi">全部 320+</text>
						<image class="sj_tu_16" :src="图标 + 'chevron_right_lan.svg'" mode="aspectFit"></image>
					</view>
				</view>
				<scroll-view class="sj_jing_gui" direction="horizontal" :show-scrollbar="false">
					<view class="sj_jing_hang">
						<view
							v-for="项 in 精选列表"
							:key="项.键"
							class="sj_jing_ka"
							@click="去委托广场"
						>
							<view class="sj_jing_shang">
								<view class="sj_jing_ding_hang">
