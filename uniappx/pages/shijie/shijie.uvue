								<view class="sj_zai_xian"></view>
							</view>
							<view class="sj_tou_wen">
								<view class="sj_tou_ming_hang">
									<text class="sj_tou_ming">林栖 · Maya</text>
									<image class="sj_tu_16" :src="图标 + 'verified.svg'" mode="aspectFit"></image>
								</view>
								<view class="sj_tou_fu_hang">
									<text class="sj_tou_fu">资深设计专家</text>
