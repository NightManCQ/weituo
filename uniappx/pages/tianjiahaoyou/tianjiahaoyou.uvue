<script setup lang="ts">
import { onShow } from '@dcloudio/uni-app'
import { ref } from 'vue'
import type { 用户 } from '../../common/leixing'
import { 发送请求, 读取当前用户 } from '../../common/wangluo'

type 搜索结果 = { 用户编号: string; 登录名: string; 昵称: string; 好友状态: string }
const 当前用户 = ref<用户 | null>(null)
const 登录名 = ref('')
const 附言 = ref('')
const 结果 = ref<搜索结果 | null>(null)
const 正在搜索 = ref(false)
const 正在发送 = ref(false)

async function 搜索用户() {
  if (当前用户.value == null) return
  const 查询 = 登录名.value.trim()
  if (!查询) return
  正在搜索.value = true
  try {
    const 用户列表 = await 发送请求<搜索结果[]>(`/my/friends/search?login_name=${encodeURIComponent(查询)}`)
    结果.value = 用户列表[0] || null
    if (结果.value == null) uni.showToast({ title: '没有找到该登录名对应的用户', icon: 'none' })
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '搜索失败', icon: 'none' })
  } finally {
    正在搜索.value = false
  }
}

async function 发送申请() {
  if (当前用户.value == null || 结果.value == null || 正在发送.value) return
  正在发送.value = true
  try {
    await 发送请求('/my/friend-requests', {
      method: 'POST',
      data: { target_user_id: 结果.value.用户编号, message: 附言.value.trim() } as UTSJSONObject,
    })
    uni.showToast({ title: '好友申请已发送', icon: 'success' })
    await 搜索用户()
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '发送申请失败', icon: 'none' })
  } finally {
    正在发送.value = false
  }

  onShow(() => { 当前用户.value = 读取当前用户() })
}
</script>

<template>
  <view class="ye_mian">
    <view class="ye_mian_biao_ti"><text class="fu_biao_ti">联系人</text><text class="biao_ti">添加好友</text></view>
    <view v-if="当前用户 == null" class="kong_zhuang_tai">
      <text>登录后添加好友</text>
      <button class="zhu_yao_an_niu" @click="uni.switchTab({ url: '/pages/wode/wode' })">前往登录</button>
    </view>
    <view v-else class="ka_pian">
      <text class="biao_qian">用户登录名</text>
      <input v-model="登录名" class="shu_ru_kuang" maxlength="64" placeholder="输入完整登录名" />
      <button class="zhu_yao_an_niu" :disabled="正在搜索" @click="搜索用户">{{ 正在搜索 ? '搜索中…' : '搜索' }}</button>
    </view>
    <view v-if="结果 != null" class="ka_pian">
      <text class="ka_pian_biao_ti">{{ 结果.昵称 }} (@{{ 结果.登录名 }})</text>
      <text class="fu_zhu_wen_ben">{{ 结果.好友状态 }}</text>
      <template v-if="结果.好友状态 == '可添加'">
        <input v-model="附言" class="shu_ru_kuang" maxlength="200" placeholder="验证消息（可选）" />
        <button class="zhu_yao_an_niu" :disabled="正在发送" @click="发送申请">{{ 正在发送 ? '发送中…' : '发送好友申请' }}</button>
      </template>
    </view>
    <button class="wen_ben_an_niu ju_zuo" @click="uni.navigateBack()">返回联系人</button>
  </view>
</template>
