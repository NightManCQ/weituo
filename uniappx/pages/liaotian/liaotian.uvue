<script setup lang="ts">
import { onHide, onLoad, onShow } from '@dcloudio/uni-app'
import { ref } from 'vue'
import type { 好友消息, 群消息, 用户 } from '../../common/leixing'
import { 创建编号, 发送请求, 格式化时间, 读取当前用户 } from '../../common/wangluo'
import { 连接实时消息, 订阅实时事件 } from '../../common/shishi'
import type { 实时事件 } from '../../common/shishi'

type 群成员 = { 用户编号: string; 昵称: string; 成员角色: string }
type 群详情 = {
  群组编号: string
  关联任务编号: string | null
  群组状态: string
  群组名称: string
  群组公告: string
  群主编号: string
  成员列表: 群成员[]
}
type 好友 = { 用户编号: string; 昵称: string }

const 当前用户 = ref<用户 | null>(null)
const 群组编号 = ref('')
const 好友编号 = ref('')
const 联系人昵称 = ref('好友')
const 群组 = ref<群详情 | null>(null)
const 群消息列表 = ref<群消息[]>([])
const 好友消息列表 = ref<好友消息[]>([])
const 好友列表 = ref<好友[]>([])
const 消息正文 = ref('')
const 好友消息待确认 = ref<{ 客户端消息编号: string; 正文: string } | null>(null)
const 邀请用户编号 = ref('')
const 正在加载 = ref(false)
const 正在发送 = ref(false)
const 错误 = ref('')
const 滚动位置 = ref(0)
const 接近底部 = ref(true)
let 正在刷新 = false
let 取消订阅: (() => void) | null = null

function 滚动到最新消息() {
  滚动位置.value += 100000
}

function 记录滚动位置(事件: { detail: { scrollTop: number; scrollHeight: number } }) {
  滚动位置.value = 事件.detail.scrollTop
  接近底部.value = 事件.detail.scrollHeight - 事件.detail.scrollTop <= 440
}

function 合并好友消息(消息列表: 好友消息[]): 好友消息[] {
  const 去重消息 = 消息列表.filter((消息, 索引, 列表) =>
    列表.findIndex((候选) =>
      候选.消息编号 == 消息.消息编号 ||
      候选.客户端消息编号 == 消息.客户端消息编号,
    ) == 索引,
  )
  return 去重消息.sort((左侧, 右侧) => 左侧.创建时间.localeCompare(右侧.创建时间)).slice(-200)
}

function 添加好友消息(消息: 好友消息) {
  const 已有消息 = 好友消息列表.value.some((项目) =>
    项目.消息编号 == 消息.消息编号 ||
    项目.客户端消息编号 == 消息.客户端消息编号,
  )
  if (已有消息) return
  好友消息列表.value = 合并好友消息([...好友消息列表.value, 消息])
  if (接近底部.value) 滚动到最新消息()
}

function 处理好友实时事件(事件: 实时事件) {
  if (事件.事件类型 != 'friend.message_created' || 事件.数据 == null) return
  const 数据 = 事件.数据
  const 联系人编号 = 数据['联系人编号'] ?? 数据['contact_user_id']
  if (
    !好友编号.value ||
    !当前用户.value ||
    联系人编号 != 好友编号.value
  ) return
  const 消息编号 = 数据['消息编号'] ?? 数据['message_id']
  const 会话编号 = 数据['会话编号'] ?? 数据['conversation_id'] ?? 事件.会话编号
  const 发送者编号 = 数据['发送者编号'] ?? 数据['sender_id']
  const 发送者昵称 = 数据['发送者昵称'] ?? 数据['sender_nickname']
  const 客户端消息编号 = 数据['客户端消息编号'] ?? 数据['client_message_id']
  const 消息正文 = 数据['消息正文'] ?? 数据['content']
  const 创建时间 = 数据['创建时间'] ?? 数据['created_at']
  if (
    typeof 消息编号 != 'string' ||
    typeof 会话编号 != 'string' ||
    typeof 发送者编号 != 'string' ||
    typeof 发送者昵称 != 'string' ||
    typeof 客户端消息编号 != 'string' ||
    typeof 消息正文 != 'string' ||
    typeof 创建时间 != 'string'
  ) {
    console.error('好友私聊 MQTT 事件缺少消息字段', 事件.原始事件)
    return
  }
  if (
    发送者编号 != 当前用户.value.用户编号 &&
    发送者编号 != 好友编号.value
  ) return
  添加好友消息({
    消息编号,
    会话编号,
    发送者编号,
    发送者昵称,
    客户端消息编号,
    消息正文,
    创建时间,
  })
}

function 处理群聊实时事件(事件: 实时事件) {
  if (
    事件.事件类型 == 'task.completed' &&
    事件.任务编号 == 群组.value?.关联任务编号
  ) {
    void 刷新()
    return
  }
  if (事件.事件类型 != 'group.message_created' || 事件.数据 == null) return
  const 数据 = 事件.数据
  const 当前群组 = 群组.value
  if (!当前群组) return
  const 群编号 = 数据['群组编号'] ?? 事件.原始事件['群组编号']
  if (群编号 != 当前群组.群组编号) return
  const 消息编号 = 数据['消息编号']
  const 群内序号 = 数据['群内序号']
  const 发送者编号 = 数据['发送者编号']
  const 发送者昵称 = 数据['发送者昵称']
  const 客户端消息编号 = 数据['客户端消息编号']
  const 正文 = 数据['消息正文']
  const 创建时间 = 数据['创建时间']
  if (
    typeof 消息编号 != 'string' ||
    typeof 群内序号 != 'number' ||
    typeof 发送者编号 != 'string' ||
    typeof 发送者昵称 != 'string' ||
    typeof 客户端消息编号 != 'string' ||
    typeof 正文 != 'string' ||
    typeof 创建时间 != 'string'
  ) {
    console.error('群聊 MQTT 事件缺少消息字段', 事件.原始事件)
    return
  }
  if (群消息列表.value.some((消息) =>
    消息.消息编号 == 消息编号 ||
    消息.客户端消息编号 == 客户端消息编号,
  )) return
  群消息列表.value = [...群消息列表.value, {
    消息编号,
    群组编号: 当前群组.群组编号,
    群内序号,
    发送者编号,
    发送者昵称,
    客户端消息编号,
    消息正文: 正文,
    创建时间,
  }].sort((左侧, 右侧) => 左侧.群内序号 - 右侧.群内序号).slice(-100)
  当前群组.最后消息序号 = Math.max(当前群组.最后消息序号, 群内序号)
  if (接近底部.value) 滚动到最新消息()
}

async function 刷新() {
  if (当前用户.value == null) {
    群消息列表.value = []
    好友消息列表.value = []
    错误.value = '登录后才能查看和发送消息'
    return
  }
  if (正在刷新) return
  正在刷新 = true
  正在加载.value = true
  错误.value = ''
  try {
    if (群组编号.value || (任务编号.value && !好友编号.value)) {
      if (!群组编号.value && 任务编号.value) {
        const 结果 = await 发送请求<{ 群组编号: string }>(`/tasks/${encodeURIComponent(任务编号.value)}/group-chat`)
        群组编号.value = 结果.群组编号
      }
      const 群编号 = 群组编号.value
      const [详情, 消息] = await Promise.all([
        发送请求<群详情>(`/groups/${encodeURIComponent(群编号)}`),
        发送请求<群消息[]>(`/groups/${encodeURIComponent(群编号)}/messages?limit=100`),
      ])
      const 首次加载 = 群消息列表.value.length == 0
      群组.value = 详情
      const 合并消息 = [...群消息列表.value, ...消息]
      群消息列表.value = 合并消息.filter((项目, 索引, 列表) =>
        列表.findIndex((候选) =>
          候选.消息编号 == 项目.消息编号 ||
          候选.客户端消息编号 == 项目.客户端消息编号,
        ) == 索引,
      ).sort((左侧, 右侧) => 左侧.群内序号 - 右侧.群内序号).slice(-100)
      if (首次加载 || 接近底部.value) 滚动到最新消息()
      if (详情.关联任务编号 == null) 好友列表.value = await 发送请求<好友[]>('/my/friends')
    } else if (好友编号.value) {
      const 消息 = await 发送请求<好友消息[]>(`/my/friends/${encodeURIComponent(好友编号.value)}/messages?limit=200`)
      const 首次加载 = 好友消息列表.value.length == 0
      好友消息列表.value = 合并好友消息([...好友消息列表.value, ...消息])
      if (首次加载 || 接近底部.value) 滚动到最新消息()
    }
  } catch (原因) {
    错误.value = 原因 instanceof Error ? 原因.message : '加载聊天失败'
  } finally {
    正在刷新 = false
    正在加载.value = false
  }
}

async function 发送() {
  const 正文 = 消息正文.value.trim()
  if (!正文 || 正在发送.value || 当前用户.value == null) return
  正在发送.value = true
  错误.value = ''
  try {
    if (好友编号.value) {
      const 待发送消息 = 好友消息待确认.value ?? {
        客户端消息编号: 创建编号(),
        正文,
      }
      好友消息待确认.value = 待发送消息
      const 消息 = await 发送请求<好友消息>(`/my/friends/${encodeURIComponent(好友编号.value)}/messages`, {
        method: 'POST',
        data: {
          client_message_id: 待发送消息.客户端消息编号,
          content: 待发送消息.正文,
        } as UTSJSONObject,
      })
      添加好友消息(消息)
      好友消息待确认.value = null
    } else if (群组.value != null) {
      const 消息 = await 发送请求<群消息>(`/groups/${encodeURIComponent(群组.value.群组编号)}/messages`, {
        method: 'POST',
        data: { client_message_id: 创建编号(), content: 正文 } as UTSJSONObject,
      })
      if (!群消息列表.value.some((项目) => 项目.消息编号 == 消息.消息编号)) 群消息列表.value.push(消息)
    }
    消息正文.value = ''
    滚动到最新消息()
  } catch (原因) {
    错误.value = 原因 instanceof Error ? 原因.message : '发送消息失败'
  } finally {
    正在发送.value = false
  }
}

async function 邀请好友() {
  if (!邀请用户编号.value || 群组.value == null) return
  try {
    await 发送请求(`/groups/${encodeURIComponent(群组.value.群组编号)}/invitations`, {
      method: 'POST',
      data: { user_id: 邀请用户编号.value } as UTSJSONObject,
    })
    邀请用户编号.value = ''
    uni.showToast({ title: '已发送群邀请', icon: 'success' })
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '邀请失败', icon: 'none' })
  }
}

async function 移除成员(编号: string, 名称: string) {
  const 确认 = await new Promise<boolean>((resolve) => uni.showModal({
    title: '移除群成员',
    content: `确定将 ${名称} 移出群聊吗？`,
    success: (结果) => resolve(结果.confirm),
    fail: () => resolve(false),
  }))
  if (!确认 || 群组.value == null) return
  try {
    await 发送请求(`/groups/${encodeURIComponent(群组.value.群组编号)}/members/${encodeURIComponent(编号)}`, { method: 'DELETE' })
    await 刷新()
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '移除失败', icon: 'none' })
  }
}

async function 退出群聊() {
  if (群组.value == null) return
  const 确认 = await new Promise<boolean>((resolve) => uni.showModal({
    title: '退出群聊',
    content: '确定退出这个群聊吗？',
    success: (结果) => resolve(结果.confirm),
    fail: () => resolve(false),
  }))
  if (!确认) return
  try {
    await 发送请求(`/groups/${encodeURIComponent(群组.value.群组编号)}/leave`, { method: 'DELETE' })
    uni.navigateBack()
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '退出群聊失败', icon: 'none' })
  }
}

function 返回() {
  uni.navigateBack({ fail: () => uni.switchTab({ url: '/pages/xiaoxi/xiaoxi' }) })
}

let 任务编号 = ''
onLoad((参数) => {
  当前用户.value = 读取当前用户()
  群组编号.value = 参数['groupId'] as string || ''
  好友编号.value = 参数['friendId'] as string || ''
  联系人昵称.value = decodeURIComponent(参数['nickname'] as string || '好友')
  任务编号 = 参数['taskId'] as string || ''
})
onShow(() => {
  void 连接实时消息(当前用户.value)
  if (取消订阅 == null) {
    取消订阅 = 订阅实时事件((事件) => {
      if (好友编号.value) 处理好友实时事件(事件)
      else 处理群聊实时事件(事件)
    })
  }
  void 刷新()
})
onHide(() => {
  取消订阅?.()
  取消订阅 = null
})
</script>

<template>
  <view class="page chat-page">
    <view class="page-heading row-between">
      <view><text class="eyebrow">{{ 好友编号 ? '好友私聊' : '群聊' }}</text><text class="title">{{ 好友编号 ? 联系人昵称 : 群组?.群组名称 || '委托会话' }}</text></view>
      <button class="secondary" @click="返回">返回</button>
    </view>
    <view v-if="错误" class="notice error">{{ 错误 }}</view>
    <button v-if="当前用户 == null" class="primary" @click="uni.switchTab({ url: '/pages/wode/wode' })">前往登录</button>
    <view class="actions"><button class="secondary" @click="刷新">{{ 正在加载 ? '同步中…' : '刷新消息' }}</button></view>
    <view v-if="群组 != null" class="card">
      <text class="card-title">群成员 · {{ 群组.成员列表.length }}</text>
      <view v-for="成员 in 群组.成员列表" :key="成员.用户编号" class="list-row">
        <text class="grow">{{ 成员.昵称 }} · {{ 成员.成员角色 }}</text>
        <button v-if="群组.关联任务编号 == null && ['群主', '管理员'].includes(群组.成员列表.find((项) => 项.用户编号 == 当前用户?.用户编号)?.成员角色 || '') && 成员.用户编号 != 当前用户?.用户编号 && 成员.成员角色 != '群主'" class="text-button" @click="移除成员(成员.用户编号, 成员.昵称)">移除</button>
      </view>
      <template v-if="群组.关联任务编号 == null">
        <picker :range="好友列表" range-key="昵称" @change="(事件) => 邀请用户编号 = 好友列表[Number(事件.detail.value)].用户编号">
          <view class="list-row clickable"><text class="grow">{{ 邀请用户编号 ? (好友列表.find((好友) => 好友.用户编号 == 邀请用户编号)?.昵称 || '选择好友') : '选择好友邀请入群' }}</text><text class="arrow">⌄</text></view>
        </picker>
        <button class="secondary" @click="邀请好友">邀请好友</button>
        <button v-if="当前用户?.用户编号 != 群组.群主编号" class="text-button left" @click="退出群聊">退出群聊</button>
      </template>
    </view>
    <view v-if="群组?.群组状态 == '已归档'" class="notice">
      该委托已完成，群聊已归档；历史消息仅供查看。
    </view>
    <scroll-view class="message-list" :scroll-top="滚动位置" @scroll="记录滚动位置">
      <view v-if="好友编号" v-for="消息 in 好友消息列表" :key="消息.消息编号" class="message" :class="消息.发送者编号 == 当前用户?.用户编号 ? 'message-mine' : 'message-other'">
        <text class="muted">{{ 消息.发送者编号 == 当前用户?.用户编号 ? '我' : 消息.发送者昵称 }} · {{ 格式化时间(消息.创建时间) }}</text>
        <text class="body">{{ 消息.消息正文 }}</text>
      </view>
      <view v-else v-for="消息 in 群消息列表" :key="消息.消息编号" class="message" :class="消息.发送者编号 == 当前用户?.用户编号 ? 'message-mine' : 'message-other'">
        <text class="muted">{{ 消息.发送者编号 == 当前用户?.用户编号 ? '我' : 消息.发送者昵称 }} · {{ 格式化时间(消息.创建时间) }}</text>
        <text class="body">{{ 消息.消息正文 }}</text>
      </view>
      <view v-if="好友编号 && 好友消息列表.length == 0 && !错误" class="empty">还没有消息，发起一段对话吧。</view>
      <view v-if="!好友编号 && 群消息列表.length == 0 && !错误" class="empty">还没有群消息。</view>
    </scroll-view>
    <view v-if="当前用户 != null && (好友编号 || 群组?.群组状态 == '正常')" class="compose">
      <input v-model="消息正文" class="field compose-field grow" maxlength="4000" placeholder="输入消息…" confirm-type="send" :disabled="好友消息待确认 != null" @confirm="发送" />
      <button class="primary" :disabled="正在发送 || 消息正文.trim().length == 0" @click="发送">{{ 正在发送 ? '发送中' : 好友消息待确认 != null ? '重试发送' : '发送' }}</button>
    </view>
  </view>
</template>

<style>
.message-mine { align-self: flex-end; background-color: #e7f4ef; }
.message-other { align-self: flex-start; }
</style>
