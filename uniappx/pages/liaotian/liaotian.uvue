<script setup lang="ts">
import { onHide, onLoad, onPageScroll, onShow } from '@dcloudio/uni-app'
import { nextTick, ref } from 'vue'
import type { 好友消息, 群消息, 用户 } from '../../common/leixing'
import { 创建编号, 发送请求, 格式化时间, 读取当前用户 } from '../../common/wangluo'
import { 订阅实时事件 } from '../../common/实时'
import type { 实时事件 } from '../../common/实时'

type 群成员 = { 用户编号: string; 昵称: string; 成员角色: string }
type 群详情 = {
  群组编号: string
  关联任务编号: string | null
  群组状态: string
  群组名称: string
  群组公告: string
  群主编号: string
  成员列表: 群成员[]
}
type 好友 = { 用户编号: string; 昵称: string }

const 当前用户 = ref<用户 | null>(null)
const 群组编号 = ref('')
const 好友编号 = ref('')
const 联系人昵称 = ref('好友')
const 群组 = ref<群详情 | null>(null)
const 群消息列表 = ref<群消息[]>([])
const 好友消息列表 = ref<好友消息[]>([])
const 好友列表 = ref<好友[]>([])
const 消息正文 = ref('')
const 好友消息待确认 = ref<{ 客户端消息编号: string; 正文: string } | null>(null)
const 邀请用户编号 = ref('')
const 正在加载 = ref(false)
const 正在发送 = ref(false)
const 错误 = ref('')
const 群管理面板已展开 = ref(false)
const 接近底部 = ref(true)
let 页面内容高度 = 0
let 页面滚动高度 = 0
let 页面视口高度 = 0
let 正在刷新 = false
let 取消订阅: (() => void) | null = null

function 格式化消息时间(值: string): string {
  const 日期 = new Date(值)
  if (Number.isNaN(日期.getTime())) return ''
  return `${String(日期.getHours()).padStart(2, '0')}:${String(日期.getMinutes()).padStart(2, '0')}`
}

function 消息日期键(值: string): string {
  const 日期 = new Date(值)
  if (Number.isNaN(日期.getTime())) return 值.slice(0, 10)
  return `${日期.getFullYear()}-${日期.getMonth() + 1}-${日期.getDate()}`
}

function 是否显示日期(消息列表: 好友消息[] | 群消息[], 索引: number): boolean {
  return 索引 == 0 || 消息日期键(消息列表[索引 - 1].创建时间) != 消息日期键(消息列表[索引].创建时间)
}

function 格式化日期标签(值: string): string {
  const 日期 = new Date(值)
  if (Number.isNaN(日期.getTime())) return 值.slice(0, 10)
  const 今天 = new Date()
  const 日期零点 = new Date(日期.getFullYear(), 日期.getMonth(), 日期.getDate()).getTime()
  const 今天零点 = new Date(今天.getFullYear(), 今天.getMonth(), 今天.getDate()).getTime()
  const 相差天数 = Math.floor((今天零点 - 日期零点) / 86400000)
  if (相差天数 == 0) return '今天'
  if (相差天数 == 1) return '昨天'
  return `${日期.getFullYear()}年${日期.getMonth() + 1}月${日期.getDate()}日`
}

function 滚动到最新消息() {
  nextTick(() => {
    uni.createSelectorQuery().select('.chat-shell').boundingClientRect((位置) => {
      if (位置 == null) return
      页面内容高度 = 位置.height
      页面滚动高度 = Math.max(页面内容高度 - 页面视口高度, 0)
      接近底部.value = true
      uni.pageScrollTo({ scrollTop: 页面滚动高度, duration: 0 })
    }).exec()
  })
}

function 更新是否接近底部() {
  接近底部.value = 页面内容高度 - 页面滚动高度 - 页面视口高度 <= 440
}

function 更新页面高度() {
  nextTick(() => {
    uni.createSelectorQuery().select('.chat-shell').boundingClientRect((位置) => {
      if (位置 == null) return
      页面内容高度 = 位置.height
      更新是否接近底部()
    }).exec()
  })
}

function 合并好友消息(消息列表: 好友消息[]): 好友消息[] {
  const 去重消息 = 消息列表.filter((消息, 索引, 列表) =>
    列表.findIndex((候选) =>
      候选.消息编号 == 消息.消息编号 ||
      候选.客户端消息编号 == 消息.客户端消息编号,
    ) == 索引,
  )
  return 去重消息.sort((左侧, 右侧) => 左侧.创建时间.localeCompare(右侧.创建时间)).slice(-200)
}

function 添加好友消息(消息: 好友消息) {
  const 已有消息 = 好友消息列表.value.some((项目) =>
    项目.消息编号 == 消息.消息编号 ||
    项目.客户端消息编号 == 消息.客户端消息编号,
  )
  if (已有消息) return
  好友消息列表.value = 合并好友消息([...好友消息列表.value, 消息])
  if (接近底部.value) 滚动到最新消息()
  else 更新页面高度()
}

function 处理好友实时事件(事件: 实时事件) {
  if (事件.事件类型 != 'friend.message_created' || 事件.数据 == null) return
  const 数据 = 事件.数据
  const 联系人编号 = 数据['联系人编号'] ?? 数据['contact_user_id']
  if (
    !好友编号.value ||
    !当前用户.value ||
    联系人编号 != 好友编号.value
  ) return
  const 消息编号 = 数据['消息编号'] ?? 数据['message_id']
  const 会话编号 = 数据['会话编号'] ?? 数据['conversation_id'] ?? 事件.会话编号
  const 发送者编号 = 数据['发送者编号'] ?? 数据['sender_id']
  const 发送者昵称 = 数据['发送者昵称'] ?? 数据['sender_nickname']
  const 客户端消息编号 = 数据['客户端消息编号'] ?? 数据['client_message_id']
  const 消息正文 = 数据['消息正文'] ?? 数据['content']
  const 创建时间 = 数据['创建时间'] ?? 数据['created_at']
  if (
    typeof 消息编号 != 'string' ||
    typeof 会话编号 != 'string' ||
    typeof 发送者编号 != 'string' ||
    typeof 发送者昵称 != 'string' ||
    typeof 客户端消息编号 != 'string' ||
    typeof 消息正文 != 'string' ||
    typeof 创建时间 != 'string'
  ) {
    console.error('好友私聊 MQTT 事件缺少消息字段', 事件.原始事件)
    return
  }
  if (
    发送者编号 != 当前用户.value.用户编号 &&
    发送者编号 != 好友编号.value
  ) return
  添加好友消息({
    消息编号,
    会话编号,
    发送者编号,
    发送者昵称,
    客户端消息编号,
    消息正文,
    创建时间,
  })
}

function 处理群聊实时事件(事件: 实时事件) {
  if (
    事件.事件类型 == 'task.completed' &&
    事件.任务编号 == 群组.value?.关联任务编号
  ) {
    void 刷新()
    return
  }
  if (事件.事件类型 != 'group.message_created' || 事件.数据 == null) return
  const 数据 = 事件.数据
  const 当前群组 = 群组.value
  if (!当前群组) return
  const 群编号 = 数据['群组编号'] ?? 事件.原始事件['群组编号']
  if (群编号 != 当前群组.群组编号) return
  const 消息编号 = 数据['消息编号']
  const 群内序号 = 数据['群内序号']
  const 发送者编号 = 数据['发送者编号']
  const 发送者昵称 = 数据['发送者昵称']
  const 客户端消息编号 = 数据['客户端消息编号']
  const 正文 = 数据['消息正文']
  const 创建时间 = 数据['创建时间']
  if (
    typeof 消息编号 != 'string' ||
    typeof 群内序号 != 'number' ||
    typeof 发送者编号 != 'string' ||
    typeof 发送者昵称 != 'string' ||
    typeof 客户端消息编号 != 'string' ||
    typeof 正文 != 'string' ||
    typeof 创建时间 != 'string'
  ) {
    console.error('群聊 MQTT 事件缺少消息字段', 事件.原始事件)
    return
  }
  if (群消息列表.value.some((消息) =>
    消息.消息编号 == 消息编号 ||
    消息.客户端消息编号 == 客户端消息编号,
  )) return
  群消息列表.value = [...群消息列表.value, {
    消息编号,
    群组编号: 当前群组.群组编号,
    群内序号,
    发送者编号,
    发送者昵称,
    客户端消息编号,
    消息正文: 正文,
    创建时间,
  }].sort((左侧, 右侧) => 左侧.群内序号 - 右侧.群内序号).slice(-100)
  当前群组.最后消息序号 = Math.max(当前群组.最后消息序号, 群内序号)
  if (接近底部.value) 滚动到最新消息()
  else 更新页面高度()
}

async function 刷新() {
  if (当前用户.value == null) {
    群消息列表.value = []
    好友消息列表.value = []
    错误.value = '登录后才能查看和发送消息'
    return
  }
  if (正在刷新) return
  正在刷新 = true
  正在加载.value = true
  错误.value = ''
  try {
    if (群组编号.value || (任务编号.value && !好友编号.value)) {
      if (!群组编号.value && 任务编号.value) {
        const 结果 = await 发送请求<{ 群组编号: string }>(`/tasks/${encodeURIComponent(任务编号.value)}/group-chat`)
        群组编号.value = 结果.群组编号
      }
      const 群编号 = 群组编号.value
      const [详情, 消息] = await Promise.all([
        发送请求<群详情>(`/groups/${encodeURIComponent(群编号)}`),
        发送请求<群消息[]>(`/groups/${encodeURIComponent(群编号)}/messages?limit=100`),
      ])
      const 首次加载 = 群消息列表.value.length == 0
      群组.value = 详情
      const 合并消息 = [...群消息列表.value, ...消息]
      群消息列表.value = 合并消息.filter((项目, 索引, 列表) =>
        列表.findIndex((候选) =>
          候选.消息编号 == 项目.消息编号 ||
          候选.客户端消息编号 == 项目.客户端消息编号,
        ) == 索引,
      ).sort((左侧, 右侧) => 左侧.群内序号 - 右侧.群内序号).slice(-100)
      if (首次加载 || 接近底部.value) 滚动到最新消息()
      else 更新页面高度()
      if (详情.关联任务编号 == null) 好友列表.value = await 发送请求<好友[]>('/my/friends')
    } else if (好友编号.value) {
      const 消息 = await 发送请求<好友消息[]>(`/my/friends/${encodeURIComponent(好友编号.value)}/messages?limit=200`)
      const 首次加载 = 好友消息列表.value.length == 0
      好友消息列表.value = 合并好友消息([...好友消息列表.value, ...消息])
      if (首次加载 || 接近底部.value) 滚动到最新消息()
      else 更新页面高度()
    }
  } catch (原因) {
    错误.value = 原因 instanceof Error ? 原因.message : '加载聊天失败'
  } finally {
    正在刷新 = false
    正在加载.value = false
  }
}

async function 发送() {
  const 正文 = 消息正文.value.trim()
  if (!正文 || 正在发送.value || 当前用户.value == null) return
  正在发送.value = true
  错误.value = ''
  try {
    if (好友编号.value) {
      const 待发送消息 = 好友消息待确认.value ?? {
        客户端消息编号: 创建编号(),
        正文,
      }
      好友消息待确认.value = 待发送消息
      const 消息 = await 发送请求<好友消息>(`/my/friends/${encodeURIComponent(好友编号.value)}/messages`, {
        method: 'POST',
        data: {
          client_message_id: 待发送消息.客户端消息编号,
          content: 待发送消息.正文,
        } as UTSJSONObject,
      })
      添加好友消息(消息)
      好友消息待确认.value = null
    } else if (群组.value != null) {
      const 消息 = await 发送请求<群消息>(`/groups/${encodeURIComponent(群组.value.群组编号)}/messages`, {
        method: 'POST',
        data: { client_message_id: 创建编号(), content: 正文 } as UTSJSONObject,
      })
      if (!群消息列表.value.some((项目) => 项目.消息编号 == 消息.消息编号)) 群消息列表.value.push(消息)
    }
    消息正文.value = ''
    滚动到最新消息()
  } catch (原因) {
    错误.value = 原因 instanceof Error ? 原因.message : '发送消息失败'
  } finally {
    正在发送.value = false
  }
}

async function 邀请好友() {
  if (!邀请用户编号.value || 群组.value == null) return
  try {
    await 发送请求(`/groups/${encodeURIComponent(群组.value.群组编号)}/invitations`, {
      method: 'POST',
      data: { user_id: 邀请用户编号.value } as UTSJSONObject,
    })
    邀请用户编号.value = ''
    uni.showToast({ title: '已发送群邀请', icon: 'success' })
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '邀请失败', icon: 'none' })
  }
}

async function 移除成员(编号: string, 名称: string) {
  const 确认 = await new Promise<boolean>((resolve) => uni.showModal({
    title: '移除群成员',
    content: `确定将 ${名称} 移出群聊吗？`,
    success: (结果) => resolve(结果.confirm),
    fail: () => resolve(false),
  }))
  if (!确认 || 群组.value == null) return
  try {
    await 发送请求(`/groups/${encodeURIComponent(群组.value.群组编号)}/members/${encodeURIComponent(编号)}`, { method: 'DELETE' })
    await 刷新()
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '移除失败', icon: 'none' })
  }
}

async function 退出群聊() {
  if (群组.value == null) return
  const 确认 = await new Promise<boolean>((resolve) => uni.showModal({
    title: '退出群聊',
    content: '确定退出这个群聊吗？',
    success: (结果) => resolve(结果.confirm),
    fail: () => resolve(false),
  }))
  if (!确认) return
  try {
    await 发送请求(`/groups/${encodeURIComponent(群组.value.群组编号)}/leave`, { method: 'DELETE' })
    uni.navigateBack()
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '退出群聊失败', icon: 'none' })
  }
}

function 返回() {
  uni.navigateBack({ fail: () => uni.switchTab({ url: '/pages/xiaoxi/xiaoxi' }) })
}

let 任务编号 = ''
onLoad((参数) => {
  页面视口高度 = uni.getSystemInfoSync().windowHeight
  当前用户.value = 读取当前用户()
  群组编号.value = 参数['groupId'] as string || ''
  好友编号.value = 参数['friendId'] as string || ''
  联系人昵称.value = decodeURIComponent(参数['nickname'] as string || '好友')
  任务编号 = 参数['taskId'] as string || ''
})
onPageScroll((事件) => {
  页面滚动高度 = 事件.scrollTop
  更新是否接近底部()
})
onShow(() => {
  if (取消订阅 == null) {
    取消订阅 = 订阅实时事件((事件) => {
      if (好友编号.value) 处理好友实时事件(事件)
      else 处理群聊实时事件(事件)
    })
  }
  void 刷新()
})
onHide(() => {
  取消订阅?.()
  取消订阅 = null
})
</script>

<template>
  <view class="chat-shell">
    <view class="chat-header">
      <button class="chat-back" @click="返回">‹</button>
      <view class="chat-avatar">
        <text>{{ (好友编号 ? 联系人昵称 : 群组?.群组名称 || '群').slice(0, 1) }}</text>
      </view>
      <view class="chat-contact">
        <text class="chat-contact-name">{{ 好友编号 ? 联系人昵称 : 群组?.群组名称 || '委托会话' }}</text>
        <text class="chat-contact-detail">{{ 好友编号 ? '好友私聊' : `${群组?.成员列表.length || 0} 位成员` }}</text>
      </view>
      <button v-if="群组 != null" class="chat-menu-button" @click="群管理面板已展开 = !群管理面板已展开">
        {{ 群管理面板已展开 ? '收起' : '⋮' }}
      </button>
    </view>

    <view v-if="群管理面板已展开 && 群组 != null" class="group-panel">
      <text class="group-panel-title">群成员 · {{ 群组.成员列表.length }}</text>
      <view v-for="成员 in 群组.成员列表" :key="成员.用户编号" class="group-member-row">
        <text class="group-member-name">{{ 成员.昵称 }} · {{ 成员.成员角色 }}</text>
        <button v-if="群组.关联任务编号 == null && ['群主', '管理员'].includes(群组.成员列表.find((项) => 项.用户编号 == 当前用户?.用户编号)?.成员角色 || '') && 成员.用户编号 != 当前用户?.用户编号 && 成员.成员角色 != '群主'" class="group-member-action" @click="移除成员(成员.用户编号, 成员.昵称)">移除</button>
      </view>
      <picker v-if="群组.关联任务编号 == null" :range="好友列表" range-key="昵称" @change="(事件) => 邀请用户编号 = 好友列表[Number(事件.detail.value)].用户编号">
        <view class="group-invite-picker">{{ 邀请用户编号 ? (好友列表.find((好友) => 好友.用户编号 == 邀请用户编号)?.昵称 || '选择好友') : '选择好友邀请入群' }}</view>
      </picker>
      <view class="group-panel-actions">
        <button v-if="群组.关联任务编号 == null" class="group-member-action" @click="邀请好友">邀请好友</button>
        <button v-if="当前用户?.用户编号 != 群组.群主编号 && 群组.关联任务编号 == null" class="group-member-action" @click="退出群聊">退出群聊</button>
      </view>
    </view>

    <view v-if="错误 && 当前用户 != null" class="chat-error">
      <text>{{ 错误 }}</text>
      <button class="chat-retry" :disabled="正在加载" @click="刷新">{{ 正在加载 ? '加载中…' : '重试' }}</button>
    </view>
    <view v-if="群组?.群组状态 == '已归档'" class="chat-archive">
      该委托已完成，群聊已归档；历史消息仅供查看。
    </view>

    <view class="chat-messages">
      <view v-if="正在加载 && 好友编号 && 好友消息列表.length == 0" class="chat-empty">正在加载消息…</view>
      <template v-if="好友编号">
        <template v-for="(消息, 索引) in 好友消息列表" :key="消息.消息编号">
          <view v-if="是否显示日期(好友消息列表, 索引)" class="chat-date-row">
            <text class="chat-date">{{ 格式化日期标签(消息.创建时间) }}</text>
          </view>
          <view class="message-row" :class="消息.发送者编号 == 当前用户?.用户编号 ? 'message-row-mine' : 'message-row-other'">
            <view class="chat-bubble" :class="消息.发送者编号 == 当前用户?.用户编号 ? 'chat-bubble-mine' : 'chat-bubble-other'">
              <text class="chat-message-text">{{ 消息.消息正文 }}</text>
              <text class="chat-message-time">{{ 格式化消息时间(消息.创建时间) }}</text>
            </view>
          </view>
        </template>
      </template>
      <template v-else>
        <template v-for="(消息, 索引) in 群消息列表" :key="消息.消息编号">
          <view v-if="是否显示日期(群消息列表, 索引)" class="chat-date-row">
            <text class="chat-date">{{ 格式化日期标签(消息.创建时间) }}</text>
          </view>
          <view class="message-row" :class="消息.发送者编号 == 当前用户?.用户编号 ? 'message-row-mine' : 'message-row-other'">
            <view class="chat-bubble" :class="消息.发送者编号 == 当前用户?.用户编号 ? 'chat-bubble-mine' : 'chat-bubble-other'">
              <text v-if="消息.发送者编号 != 当前用户?.用户编号" class="chat-sender">{{ 消息.发送者昵称 }}</text>
              <text class="chat-message-text">{{ 消息.消息正文 }}</text>
              <text class="chat-message-time">{{ 格式化消息时间(消息.创建时间) }}</text>
            </view>
          </view>
        </template>
      </template>
      <view v-if="!正在加载 && !错误 && 好友编号 && 好友消息列表.length == 0" class="chat-empty">还没有消息，发起一段对话吧。</view>
      <view v-if="!正在加载 && !错误 && !好友编号 && 群消息列表.length == 0" class="chat-empty">还没有群消息。</view>
    </view>

    <view v-if="当前用户 == null" class="chat-login">
      <button class="chat-login-button" @click="uni.switchTab({ url: '/pages/wode/wode' })">登录后开始聊天</button>
    </view>
    <view v-else-if="好友编号 || 群组?.群组状态 == '正常'" class="chat-compose">
      <input
        v-model="消息正文"
        class="chat-input"
        maxlength="4000"
        :placeholder="好友消息待确认 != null ? '发送失败，可重试原消息' : '输入消息'"
        confirm-type="send"
        :disabled="好友消息待确认 != null"
        @confirm="发送"
      />
      <button class="chat-send" :class="{ 'chat-send-disabled': 正在发送 || 消息正文.trim().length == 0 }" :disabled="正在发送 || 消息正文.trim().length == 0" @click="发送">
        {{ 正在发送 ? '…' : 好友消息待确认 != null ? '↻' : '➤' }}
      </button>
    </view>
  </view>
</template>

<style>
.chat-shell { display: flex; flex-direction: column; width: 100%; max-width: 720px; margin: 0 auto; padding: 0; background-color: #efeae2; }
.chat-header { display: flex; flex-direction: row; align-items: center; min-height: 64px; padding: 8px 12px; background-color: #075e54; }
.chat-back { width: 36px; min-width: 36px; height: 42px; margin: 0 7px 0 0; padding: 0; border: 0; background-color: transparent; color: #ffffff; font-size: 34px; line-height: 36px; }
.chat-avatar { display: flex; align-items: center; justify-content: center; width: 42px; min-width: 42px; height: 42px; border-radius: 21px; background-color: #d7eee4; color: #075e54; font-size: 19px; font-weight: 700; }
.chat-contact { display: flex; flex: 1; flex-direction: column; min-width: 0; margin-left: 10px; }
.chat-contact-name { overflow: hidden; color: #ffffff; font-size: 16px; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.chat-contact-detail { margin-top: 3px; color: #d2e8e3; font-size: 12px; }
.chat-menu-button { min-width: 38px; height: 38px; margin: 0 0 0 8px; padding: 0 8px; border: 0; background-color: transparent; color: #ffffff; font-size: 20px; }
.group-panel { padding: 10px 16px; border-bottom: 1px solid #d5ded9; background-color: #ffffff; }
.group-panel-title { display: flex; margin-bottom: 5px; color: #075e54; font-size: 14px; font-weight: 700; }
.group-member-row { display: flex; flex-direction: row; align-items: center; justify-content: space-between; min-height: 38px; border-bottom: 1px solid #eef0ed; }
.group-member-name { color: #25332e; font-size: 13px; }
.group-member-action { min-height: 30px; margin: 2px; padding: 0 10px; border: 1px solid #d5e5dd; border-radius: 15px; background-color: #ffffff; color: #087e67; font-size: 12px; }
.group-invite-picker { margin-top: 8px; padding: 9px 10px; border: 1px solid #e1e8e3; border-radius: 8px; color: #52635c; font-size: 13px; }
.group-panel-actions { display: flex; flex-direction: row; flex-wrap: wrap; margin-top: 5px; }
.chat-error { display: flex; flex-direction: row; align-items: center; justify-content: space-between; padding: 8px 12px; background-color: #fff3ef; color: #9c3c2b; font-size: 13px; }
.chat-retry { min-height: 30px; margin: 0; padding: 0 10px; border: 1px solid #e7c7bb; border-radius: 15px; background-color: #ffffff; color: #9c3c2b; font-size: 12px; }
.chat-archive { padding: 8px 12px; background-color: #fff8df; color: #71633b; text-align: center; font-size: 12px; }
.chat-messages { padding: 12px 12px 8px; background-color: #efeae2; }
.chat-date-row { display: flex; flex-direction: row; justify-content: center; margin: 8px 0 14px; }
.chat-date { padding: 5px 11px; border-radius: 12px; background-color: #faf4df; color: #68716b; font-size: 11px; }
.message-row { display: flex; flex-direction: row; margin: 4px 0; }
.message-row-mine { justify-content: flex-end; }
.message-row-other { justify-content: flex-start; }
.chat-bubble { display: flex; flex-direction: column; width: auto; max-width: 560px; margin: 0; padding: 8px 10px 5px; border-radius: 10px; }
.chat-bubble-mine { border-bottom-right-radius: 3px; background-color: #d9fdd3; }
.chat-bubble-other { border-bottom-left-radius: 3px; background-color: #ffffff; }
.chat-sender { margin-bottom: 3px; color: #087e67; font-size: 12px; font-weight: 700; }
.chat-message-text { color: #17211d; font-size: 15px; line-height: 1.4; }
.chat-message-time { align-self: flex-end; margin-top: 4px; color: #78827d; font-size: 10px; }
.chat-empty { display: flex; justify-content: center; margin-top: 28px; color: #748078; font-size: 13px; }
.chat-compose { display: flex; flex-direction: row; align-items: center; padding: 8px 10px; border-top: 1px solid #e4e6e2; background-color: #f7f5f0; }
.chat-input { flex: 1; min-width: 0; height: 42px; margin: 0 8px 0 0; padding: 0 15px; border: 1px solid #e0e4df; border-radius: 22px; background-color: #ffffff; color: #17211d; font-size: 14px; }
.chat-send { display: flex; align-items: center; justify-content: center; width: 42px; min-width: 42px; height: 42px; margin: 0; padding: 0; border: 0; border-radius: 21px; background-color: #087e67; color: #ffffff; font-size: 18px; font-weight: 700; }
.chat-send-disabled { background-color: #9aaca4; color: #edf2ef; }
.chat-login { display: flex; justify-content: center; padding: 12px; background-color: #f7f5f0; }
.chat-login-button { min-height: 40px; margin: 0; padding: 0 18px; border: 0; border-radius: 20px; background-color: #087e67; color: #ffffff; font-size: 14px; font-weight: 600; }
</style>
