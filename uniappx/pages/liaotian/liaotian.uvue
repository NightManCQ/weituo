<script setup lang="ts">
	import { onHide, onLoad, onShow } from '@dcloudio/uni-app'
	import { nextTick, ref } from 'vue'
	import type { 好友消息, 群消息, 用户 } from '../../common/leixing'
	import { 创建编号, 发送请求, 读取当前用户 } from '../../common/wangluo'
	import { 订阅实时事件 } from '../../common/实时'
	import type { 实时事件 } from '../../common/实时'
	import { 使用全局变量 } from "../../状态/全局.ts"
	import { 清零会话新消息条数 } from '../xiaoxi/会话列表'
	import { 格式化日期标签, 格式化消息时间, 消息日期键 } from '../xiaoxi/时间'

	const 当前用户 = ref<用户 | null>(null)
	const 会话编号 = ref('')
	const 会话类型 = ref('')
	const 会话名称 = ref('聊天')
	const 业务编号 = ref('')
	const 群消息列表 = ref<群消息[]>([])
	const 好友消息列表 = ref<好友消息[]>([])
	const 消息正文 = ref('')
	const 键盘高度 = ref(0)
	const 好友消息待确认 = ref<{ 客户端消息编号 : string; 正文 : string } | null>(null)
	const 正在加载 = ref(false)
	const 正在发送 = ref(false)
	const 错误 = ref('')
	let 正在刷新 = false
	let 取消订阅 : (() => void) | null = null

	function 是否显示日期(消息列表 : 好友消息[] | 群消息[], 索引 : number) : boolean {
		return 索引 == 0 || 消息日期键(消息列表[索引 - 1].创建时间) != 消息日期键(消息列表[索引].创建时间)
	}

	function 滚动到最新消息() {
		nextTick(() => {
			uni.createSelectorQuery().select('.liao_tian_rong_qi').boundingClientRect((位置) => {
				if (位置 == null) return
				const 页面视口高度 = uni.getSystemInfoSync().windowHeight
				const 最新消息滚动位置 = Math.max(位置.height - 页面视口高度, 0)
				uni.pageScrollTo({ scrollTop: 最新消息滚动位置, duration: 0 })
			}).exec()
		})
	}

	function 合并好友消息(消息列表 : 好友消息[]): 好友消息[] {
		const 去重消息 = 消息列表.filter((消息, 索引, 列表) =>
			列表.findIndex((候选) =>
				候选.消息编号 == 消息.消息编号 ||
				候选.客户端消息编号 == 消息.客户端消息编号,
			) == 索引,
		)
		return 去重消息.sort((左侧, 右侧) => 左侧.创建时间.localeCompare(右侧.创建时间)).slice(-200)
	}

	function 添加好友消息(消息 : 好友消息) {
		const 已有消息 = 好友消息列表.value.some((项目) =>
			项目.消息编号 == 消息.消息编号 ||
			项目.客户端消息编号 == 消息.客户端消息编号,
		)
		if (已有消息) return
		好友消息列表.value = 合并好友消息([...好友消息列表.value, 消息])
		滚动到最新消息()
	}

	function 处理好友实时事件(事件 : 实时事件) {
		if (事件.事件类型 != '私聊消息已创建' || 事件.数据 == null) return
		const 数据 = 事件.数据
		const 联系人编号 = 数据['联系人编号'] ?? 数据['contact_user_id']
		if (
			会话类型.value != '好友' ||
			!当前用户.value ||
			联系人编号 != 业务编号.value
		) return
		const 消息编号 = 数据['消息编号'] ?? 数据['message_id']
		const 会话编号 = 数据['会话编号'] ?? 数据['conversation_id'] ?? 事件.会话编号
		const 发送者编号 = 数据['发送者编号'] ?? 数据['sender_id']
		const 发送者昵称 = 数据['发送者昵称'] ?? 数据['sender_nickname']
		const 客户端消息编号 = 数据['客户端消息编号'] ?? 数据['client_message_id']
		const 消息正文 = 数据['消息正文'] ?? 数据['content']
		const 创建时间 = 数据['创建时间'] ?? 数据['created_at']
		if (
			typeof 消息编号 != 'string' ||
			typeof 会话编号 != 'string' ||
			typeof 发送者编号 != 'string' ||
			typeof 发送者昵称 != 'string' ||
			typeof 客户端消息编号 != 'string' ||
			typeof 消息正文 != 'string' ||
			typeof 创建时间 != 'string'
		) {
			console.error('好友私聊 MQTT 事件缺少消息字段', 事件.原始事件)
			return
		}
		if (
			发送者编号 != 当前用户.value.用户编号 &&
			发送者编号 != 业务编号.value
		) return
		添加好友消息({
			消息编号,
			会话编号,
			发送者编号,
			发送者昵称,
			客户端消息编号,
			消息正文,
			创建时间,
		})
	}

	function 处理群聊实时事件(事件 : 实时事件) {
		if (
			事件.事件类型 == 'task.completed' &&
			事件.任务编号 == 业务编号.value
		) {
			void 刷新()
			return
		}
		if (事件.事件类型 != '群聊消息已创建' || 事件.数据 == null) return
		const 数据 = 事件.数据
		const 群编号 = 数据['群组编号'] ?? 事件.原始事件['群组编号']
		if (群编号 != 会话编号.value) return
		const 消息编号 = 数据['消息编号']
		const 群内序号 = 数据['群内序号']
		const 发送者编号 = 数据['发送者编号']
		const 发送者昵称 = 数据['发送者昵称']
		const 客户端消息编号 = 数据['客户端消息编号']
		const 正文 = 数据['消息正文']
		const 创建时间 = 数据['创建时间']
		if (
			typeof 消息编号 != 'string' ||
			typeof 群内序号 != 'number' ||
			typeof 发送者编号 != 'string' ||
			typeof 发送者昵称 != 'string' ||
			typeof 客户端消息编号 != 'string' ||
			typeof 正文 != 'string' ||
			typeof 创建时间 != 'string'
		) {
			console.error('群聊 MQTT 事件缺少消息字段', 事件.原始事件)
			return
		}
		if (群消息列表.value.some((消息) =>
			消息.消息编号 == 消息编号 ||
			消息.客户端消息编号 == 客户端消息编号,
		)) return
		群消息列表.value = [...群消息列表.value, {
			消息编号,
			群组编号: 会话编号.value,
			群内序号,
			发送者编号,
			发送者昵称,
			客户端消息编号,
			消息正文: 正文,
			创建时间,
		}].sort((左侧, 右侧) => 左侧.群内序号 - 右侧.群内序号).slice(-100)
		滚动到最新消息()
	}

	async function 刷新() {
		if (当前用户.value == null) {
			群消息列表.value = []
			好友消息列表.value = []
			错误.value = '登录后才能查看和发送消息'
			return
		}
		if (正在刷新) return
		正在刷新 = true
		正在加载.value = true
		错误.value = ''
		try {
			if (会话类型.value == '群聊' || 会话类型.value == '委托') {
				const 消息 = await 发送请求<群消息[]>(`/groups/${encodeURIComponent(会话编号.value)}/messages?limit=100`)
				const 合并消息 = [...群消息列表.value, ...消息]
				群消息列表.value = 合并消息.filter((项目, 索引, 列表) =>
					列表.findIndex((候选) =>
						候选.消息编号 == 项目.消息编号 ||
						候选.客户端消息编号 == 项目.客户端消息编号,
					) == 索引,
				).sort((左侧, 右侧) => 左侧.群内序号 - 右侧.群内序号).slice(-100)
				滚动到最新消息()
			} else if (会话类型.value == '好友') {
				const 消息 = await 发送请求<好友消息[]>(`/my/friends/${encodeURIComponent(会话编号.value)}/messages?limit=200`)
				好友消息列表.value = 合并好友消息([...好友消息列表.value, ...消息])
				滚动到最新消息()
			}
		} catch (原因) {
			错误.value = 原因 instanceof Error ? 原因.message : '加载聊天失败'
		} finally {
			正在刷新 = false
			正在加载.value = false
		}
	}

	async function 发送() {
		const 正文 = 消息正文.value.trim()
		if (!正文 || 正在发送.value || 当前用户.value == null) return
		正在发送.value = true
		错误.value = ''
		try {
			if (会话类型.value == '好友') {
				const 待发送消息 = 好友消息待确认.value ?? {
					客户端消息编号: 创建编号(),
					正文,
				}
				好友消息待确认.value = 待发送消息
				const 消息 = await 发送请求<好友消息>(`/my/friends/${encodeURIComponent(业务编号.value)}/messages`, {
					method: 'POST',
					data: {
						client_message_id: 待发送消息.客户端消息编号,
						content: 待发送消息.正文,
					} as UTSJSONObject,
				})
				添加好友消息(消息)
				好友消息待确认.value = null
			} else if (会话编号.value) {
				const 消息 = await 发送请求<群消息>(`/groups/${encodeURIComponent(会话编号.value)}/messages`, {
					method: 'POST',
					data: { client_message_id: 创建编号(), content: 正文 } as UTSJSONObject,
				})
				if (!群消息列表.value.some((项目) => 项目.消息编号 == 消息.消息编号)) 群消息列表.value.push(消息)
			}
			消息正文.value = ''
			滚动到最新消息()
		} catch (原因) {
			错误.value = 原因 instanceof Error ? 原因.message : '发送消息失败'
		} finally {
			正在发送.value = false
		}
	}

	function 返回() {
		uni.navigateBack({ fail: () => uni.switchTab({ url: '/pages/xiaoxi/xiaoxi' }) })
	}

	function 打开联系人详情() {
		if (会话类型.value == '委托') {
			uni.navigateTo({
				url: `/pages/weituo/weituo?id=${encodeURIComponent(业务编号.value)}`,
			})
			return
		}
		if (会话类型.value == '群聊') {
			uni.navigateTo({
				url: `/pages/lianxiren/qun_liao?groupId=${encodeURIComponent(业务编号.value)}`,
			})
			return
		}
		if (会话类型.value != '好友') return
		uni.navigateTo({
			url: `/pages/lianxiren/hao_you?userId=${encodeURIComponent(业务编号.value)}`,
		})
	}

	function 处理键盘高度变化(事件 : { detail : { height : number } }) {
		键盘高度.value = Math.max(事件.detail.height, 0)
		滚动到最新消息()
	}

	onLoad((参数) => {
		当前用户.value = 读取当前用户()
		会话编号.value = 参数['hui_hua'] as string || ''
		会话类型.value = 参数['lei_xing'] as string || ''
		会话名称.value = 参数['ming_cheng'] as string || '聊天'
		业务编号.value = 参数['bian_hao'] as string || ''
		群消息列表.value = []
		好友消息列表.value = []
		if (会话编号.value) 清零会话新消息条数(会话编号.value)
	})
	onShow(() => {
		if (取消订阅 == null) {
			取消订阅 = 订阅实时事件((事件) => {
				if (会话类型.value == '好友') 处理好友实时事件(事件)
				else 处理群聊实时事件(事件)
			})
		}
		void 刷新()
	})
	onHide(() => {
		取消订阅?.()
		取消订阅 = null
	})
</script>

<template>
	<view class="liao_tian_rong_qi">
		<view class="liao_tian_ding_bu_zhan_wei"></view>
		<view class="liao_tian_ding_bu" :style="`padding-top:${使用全局变量.系统信息.窗口顶高}px`">
			<button class="liao_tian_fan_hui" @click="返回">‹</button>
			<view class="liao_tian_tou_xiang" @click="打开联系人详情">
				<text>{{ 会话名称.slice(0, 1) }}</text>
			</view>
			<view class="liao_tian_lian_xi_ren">
				<text class="liao_tian_lian_xi_ren_ming_cheng">{{ 会话名称 }}</text>
				<text class="liao_tian_lian_xi_ren_xin_xi">{{ 会话类型 == '好友' ? '好友私聊' : 会话类型 == '委托' ? '委托群聊' : '群聊消息' }}</text>
			</view>
		</view>

		<view v-if="错误 && 当前用户 != null" class="liao_tian_cuo_wu">
			<text>{{ 错误 }}</text>
			<button class="liao_tian_chong_shi" :disabled="正在加载" @click="刷新">{{ 正在加载 ? '加载中…' : '重试' }}</button>
		</view>

		<view class="liao_tian_xiao_xi_lie_biao">
			<view v-if="正在加载 && 会话类型 == '好友' && 好友消息列表.length == 0" class="liao_tian_kong_zhuang_tai">正在加载消息…</view>
			<template v-if="会话类型 == '好友'">
				<template v-for="(消息, 索引) in 好友消息列表" :key="消息.消息编号">
					<view v-if="是否显示日期(好友消息列表, 索引)" class="liao_tian_ri_qi_hang">
						<text class="liao_tian_ri_qi">{{ 格式化日期标签(消息.创建时间) }}</text>
					</view>
					<view class="liao_tian_xiao_xi_hang"
						:class="消息.发送者编号 == 当前用户?.用户编号 ? 'liao_tian_zi_ji_xiao_xi_hang' : 'liao_tian_dui_fang_xiao_xi_hang'">
						<view class="liao_tian_xiao_xi_kuang"
							:class="消息.发送者编号 == 当前用户?.用户编号 ? 'liao_tian_zi_ji_xiao_xi_kuang' : 'liao_tian_dui_fang_xiao_xi_kuang'">
							<text class="liao_tian_xiao_xi_zheng_wen">{{ 消息.消息正文 }}</text>
							<text class="liao_tian_xiao_xi_shi_jian">{{ 格式化消息时间(消息.创建时间) }}</text>
						</view>
					</view>
				</template>
			</template>
			<template v-else>
				<template v-for="(消息, 索引) in 群消息列表" :key="消息.消息编号">
					<view v-if="是否显示日期(群消息列表, 索引)" class="liao_tian_ri_qi_hang">
						<text class="liao_tian_ri_qi">{{ 格式化日期标签(消息.创建时间) }}</text>
					</view>
					<view class="liao_tian_xiao_xi_hang"
						:class="消息.发送者编号 == 当前用户?.用户编号 ? 'liao_tian_zi_ji_xiao_xi_hang' : 'liao_tian_dui_fang_xiao_xi_hang'">
						<view class="liao_tian_xiao_xi_kuang"
							:class="消息.发送者编号 == 当前用户?.用户编号 ? 'liao_tian_zi_ji_xiao_xi_kuang' : 'liao_tian_dui_fang_xiao_xi_kuang'">
							<text v-if="消息.发送者编号 != 当前用户?.用户编号" class="liao_tian_fa_song_zhe">{{ 消息.发送者昵称 }}</text>
							<text class="liao_tian_xiao_xi_zheng_wen">{{ 消息.消息正文 }}</text>
							<text class="liao_tian_xiao_xi_shi_jian">{{ 格式化消息时间(消息.创建时间) }}</text>
						</view>
					</view>
				</template>
			</template>
			<view v-if="!正在加载 && !错误 && 会话类型 == '好友' && 好友消息列表.length == 0" class="liao_tian_kong_zhuang_tai">还没有消息，发起一段对话吧。
			</view>
			<view v-if="!正在加载 && !错误 && 会话类型 != '好友' && 群消息列表.length == 0" class="liao_tian_kong_zhuang_tai">还没有群消息。</view>
		</view>

		<view v-if="当前用户 == null" class="liao_tian_deng_lu">
			<button class="liao_tian_deng_lu_an_niu"
				@click="uni.switchTab({ url: '/pages/wode/wode' })">登录后开始聊天</button>
		</view>
		<template v-else>
			<view class="liao_tian_bian_ji_zhan_wei"></view>
			<view class="liao_tian_bian_ji_lan" :style="`bottom:${键盘高度}px`">
				<input v-model="消息正文" class="liao_tian_shu_ru_kuang" maxlength="4000"
					:placeholder="好友消息待确认 != null ? '发送失败，可重试原消息' : '输入消息'" confirm-type="send"
					:adjust-position="true" :confirm-hold="true" :hold-keyboard="true"
					:disabled="好友消息待确认 != null" @confirm="发送"
					@keyboardheightchange="处理键盘高度变化" />
				<button class="liao_tian_fa_song"
					:class="{ 'liao_tian_fa_song_jin_yong': 正在发送 || 消息正文.trim().length == 0 }"
					:disabled="正在发送 || 消息正文.trim().length == 0" @click="发送">
					{{ 正在发送 ? '…' : 好友消息待确认 != null ? '↻' : '➤' }}
				</button>
			</view>
		</template>
	</view>
</template>

<style lang="scss">
	page{

		background-color: #efeae2;
	}
	.liao_tian_rong_qi {
		display: flex;
		flex-direction: column;
		width: 100%;
		max-width: 720px;
		margin: 0 auto;
		padding: 0;
	}

	.liao_tian_ding_bu_zhan_wei {
		height: 64px;
		min-height: 64px;
	}

	.liao_tian_ding_bu {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 10;
		width: 100%;
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		flex-direction: row;
		align-items: center;
		min-height: 64px;
		padding: 8px 12px;
		background-color: #075e54;
	}

	.liao_tian_fan_hui {
		width: 36px;
		min-width: 36px;
		height: 42px;
		margin: 0 7px 0 0;
		padding: 0;
		border: 0;
		background-color: transparent;
		color: #ffffff;
		font-size: 34px;
		line-height: 36px;
	}

	.liao_tian_tou_xiang {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		min-width: 42px;
		height: 42px;
		border-radius: 21px;
		background-color: #d7eee4;
		color: #075e54;
		font-size: 19px;
		font-weight: 700;
	}

	.liao_tian_lian_xi_ren {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
		margin-left: 10px;
	}

	.liao_tian_lian_xi_ren_ming_cheng {
		overflow: hidden;
		color: #ffffff;
		font-size: 16px;
		font-weight: 700;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.liao_tian_lian_xi_ren_xin_xi {
		margin-top: 3px;
		color: #d2e8e3;
		font-size: 12px;
	}


	.liao_tian_cuo_wu {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 8px 12px;
		background-color: #fff3ef;
		color: #9c3c2b;
		font-size: 13px;
	}

	.liao_tian_chong_shi {
		min-height: 30px;
		margin: 0;
		padding: 0 10px;
