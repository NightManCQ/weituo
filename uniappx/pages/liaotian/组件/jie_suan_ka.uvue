<script setup lang="ts">
/**
 * 聊天里的「委托状态 / 结算卡」。
 * 对应设计稿 对话.html 中 class="bg-surface-container-high rounded-xl p-space-md shadow-xl relative overflow-hidden" 那一块：
 * 右上角绿色环境光晕 + 验收标题 + 赏金条 + 「验收结算 / 提出修改意见」两个按钮。
 */
const 属性 = defineProps({
	标题: { type: String, default: '成果物验收与托管释放' },
	副标题: { type: String, default: '请核实源文件无误后确认放行赏金' },
	金额说明: { type: String, default: '本次结算赏金' },
	金额: { type: String, default: '500' },
	单位: { type: String, default: '积分' },
	验收文字: { type: String, default: '验收委托成果并结算' },
	修改文字: { type: String, default: '提出修改意见' },
})

const 发出 = defineEmits(['验收', '修改'])
</script>

<template>
	<view class="jsk_wai">
		<view class="jsk">
			<!-- 右上角光晕：设计稿用 blur-2xl，这里用预烘焙的径向渐隐 PNG（边缘 alpha 为 0） -->
