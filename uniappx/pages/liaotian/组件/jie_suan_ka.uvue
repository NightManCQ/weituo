					<image class="jsk_an_niu_tu" src="/static/liaotian/icons/edit_note.svg" mode="aspectFit"></image>
					<text class="jsk_an_niu_zi_hui">{{ 属性.修改文字 }}</text>
				</view>
			</view>
		</view>
	</view>
</template>

