<script setup lang="ts">
/**
 * 聊天消息里的「文件附件卡」。
 * 对应设计稿 对话.html 中 class="w-full bg-surface-container-low rounded-xl p-space-md shadow-sm" 那一块：
 * 左侧 ZIP 图标 + 文件名 + 大小/安全扫描说明，底部「快速预览 / 原文件下载」两个按钮。
 * 只负责展示与上报点击，真正的下载/预览逻辑交给页面。
 */
const 属性 = defineProps({
	文件名: { type: String, default: 'Blender_Final_Render_v2.zip' },
	文件大小: { type: String, default: '42.5 MB' },
	安全说明: { type: String, default: '已完成安全扫描' },
	预览文字: { type: String, default: '快速预览' },
	下载文字: { type: String, default: '原文件下载' },
})

const 发出 = defineEmits(['预览', '下载'])
</script>

<template>
	<view class="wjk">
		<view class="wjk_hang">
			<view class="wjk_tu_kuang">
				<image class="wjk_tu" src="/static/liaotian/icons/folder_zip.svg" mode="aspectFit"></image>
			</view>
			<view class="wjk_ming_qu">
				<text class="wjk_ming">{{ 属性.文件名 }}</text>
				<view class="wjk_xin_xi_hang">
					<text class="wjk_da_xiao">{{ 属性.文件大小 }}</text>
					<view class="wjk_dian"></view>
					<text class="wjk_an_quan">{{ 属性.安全说明 }}</text>
				</view>
			</view>
		</view>

		<view class="wjk_an_niu_hang">
			<view class="wjk_an_niu wjk_an_niu_hui" @click="发出('预览')">
				<image class="wjk_an_niu_tu" src="/static/liaotian/icons/visibility_2.svg" mode="aspectFit"></image>
				<text class="wjk_an_niu_zi_hui">{{ 属性.预览文字 }}</text>
			</view>
			<view class="wjk_an_niu wjk_an_niu_zhu" @click="发出('下载')">
				<image class="wjk_an_niu_tu" src="/static/liaotian/icons/download.svg" mode="aspectFit"></image>
				<text class="wjk_an_niu_zi_zhu">{{ 属性.下载文字 }}</text>
			</view>
		</view>
	</view>
</template>

