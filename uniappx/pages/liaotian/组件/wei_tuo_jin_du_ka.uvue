<script setup lang="ts">
import { ref } from 'vue'

/**
 * 会话页顶部钉住的「委托进度卡」。
 * 对应设计稿 对话.html 中 id="questCard" 的那一块：
 * 标题 + 托管徽章 + 可折叠的（状态摘要 / 四步进度 / 查看详情·申请提前验收）。
 * 折叠状态收在组件内，页面只管传文案。
 */
const 属性 = defineProps({
	标题: { type: String, default: '【委托中】3D插画渲染源文件制作' },
	托管文案: { type: String, default: '500 积分平台托管' },
	状态说明: { type: String, default: '进行中 · 待对方提交验收成果' },
	编号: { type: String, default: '托管编号 #QK-8821' },
	默认展开: { type: Boolean, default: true },
})

const 发出 = defineEmits(['查看详情', '申请验收'])

const 展开 = ref(属性.默认展开)

function 切换() {
	展开.value = !展开.value
}
</script>

<template>
	<view class="wtj">
		<view class="wtj_tou" @click="切换">
			<view class="wtj_tou_zuo">
				<view class="wtj_dian"></view>
				<text class="wtj_biao_ti">{{ 属性.标题 }}</text>
			</view>
			<view class="wtj_tou_you">
				<view class="wtj_tuo_guan">
					<text class="wtj_tuo_guan_zi">{{ 属性.托管文案 }}</text>
				</view>
				<view class="wtj_jian_tou" :style="展开 ? '' : 'transform: rotate(180deg)'">
					<image class="wtj_jian_tou_tu" src="/static/liaotian/icons/expand_less.svg" mode="aspectFit"></image>
				</view>
			</view>
		</view>

		<view v-if="展开" class="wtj_ti">
			<!-- 状态摘要 + 托管编号 -->
			<view class="wtj_zhai_yao_hang">
				<view class="wtj_zhai_yao_zuo">
					<image class="wtj_tu_16" src="/static/liaotian/icons/sync.svg" mode="aspectFit"></image>
					<text class="wtj_zhai_yao_zi">{{ 属性.状态说明 }}</text>
				</view>
				<text class="wtj_bian_hao">{{ 属性.编号 }}</text>
			</view>

			<!-- 四步进度 -->
			<view class="wtj_bu_kuang">
				<view class="wtj_bu_hang">
					<view class="wtj_bu_xiang">
						<view class="wtj_bu_quan wtj_bu_quan_wancheng">
							<image class="wtj_bu_tu" src="/static/liaotian/icons/check.svg" mode="aspectFit"></image>
						</view>
						<text class="wtj_bu_zi wtj_bu_zi_wancheng">已接单</text>
					</view>
					<view class="wtj_bu_xiang">
						<view class="wtj_bu_quan wtj_bu_quan_zhizuo">
							<image class="wtj_bu_tu" src="/static/liaotian/icons/brush.svg" mode="aspectFit"></image>
						</view>
						<text class="wtj_bu_zi wtj_bu_zi_zhizuo">制作中</text>
					</view>
					<view class="wtj_bu_xiang">
						<view class="wtj_bu_quan wtj_bu_quan_yanshou">
							<image class="wtj_bu_tu" src="/static/liaotian/icons/hourglass_top.svg" mode="aspectFit"></image>
						</view>
						<text class="wtj_bu_zi wtj_bu_zi_yanshou">待验收</text>
					</view>
					<view class="wtj_bu_xiang">
						<view class="wtj_bu_quan wtj_bu_quan_wei">
							<image class="wtj_bu_tu" src="/static/liaotian/icons/lock.svg" mode="aspectFit"></image>
						</view>
						<text class="wtj_bu_zi wtj_bu_zi_wei">结算完成</text>
					</view>
				</view>
			</view>

			<!-- 快捷操作 -->
			<view class="wtj_an_niu_hang">
				<view class="wtj_an_niu" @click="发出('查看详情')">
					<image class="wtj_tu_16" src="/static/liaotian/icons/visibility.svg" mode="aspectFit"></image>
					<text class="wtj_an_niu_zi_zhu">查看委托详情</text>
				</view>
				<view class="wtj_an_niu" @click="发出('申请验收')">
					<image class="wtj_tu_16" src="/static/liaotian/icons/bolt.svg" mode="aspectFit"></image>
					<text class="wtj_an_niu_zi_huang">申请提前验收</text>
				</view>
			</view>
		</view>
	</view>
</template>

