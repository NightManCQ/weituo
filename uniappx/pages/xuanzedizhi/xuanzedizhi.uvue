<script setup lang="ts">
import { ref } from 'vue'
import type { 任务位置 } from '../../common/leixing'

const 正在定位 = ref(false)
const 错误 = ref('')

function 选择当前位置() {
  正在定位.value = true
  错误.value = ''
  uni.chooseLocation({
    success: (结果) => {
      uni.setStorageSync('renwu_location', {
        经度: 结果.longitude,
        纬度: 结果.latitude,
        国: null,
        省: null,
        市: null,
        县: null,
        镇: null,
        村: null,
        地址: `${结果.name || ''} ${结果.address || ''}`.trim() || null,
      } as 任务位置)
      uni.navigateBack()
    },
    fail: (原因) => {
      if (!原因.errMsg.includes('cancel')) 错误.value = 原因.errMsg || '无法打开系统地图选点'
    },
    complete: () => { 正在定位.value = false },
  })
}
</script>

<template>
  <view class="page">
    <view class="page-heading"><text class="eyebrow">委托位置</text><text class="title">选择委托地址</text></view>
    <view class="card">
      <text class="body">使用系统地图搜索地点并选择位置。选择后会将地点名称和经纬度带回委托表单。</text>
      <text v-if="错误" class="notice error">{{ 错误 }}</text>
      <button class="primary" :disabled="正在定位" @click="选择当前位置">{{ 正在定位 ? '正在打开地图…' : '打开地图选点' }}</button>
      <button class="secondary" @click="uni.navigateBack()">取消</button>
    </view>
  </view>
</template>
