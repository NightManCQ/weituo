		min-height: 800px;
		background-color: #0b1326;
	}
	.dl_guang_ceng {
		position: absolute;
		top: 0; left: 0; right: 0;
		height: 560px;
		overflow: hidden;
	}
	.dl_guang { position: absolute; }
	.dl_guang_1 {
		top: -64px; left: 50%; margin-left: -160px;
		width: 320px; height: 320px;
	}
	.dl_guang_2 {
		top: 192px; right: -80px;
		width: 256px; height: 256px;
	}
	/* 设计稿顶栏是空的：只保留半透明底和一条细阴影 */
	.dl_ding_lan {
		position: fixed;
		top: 0; left: 0; right: 0;
		z-index: 50;
		background-color: rgba(11, 19, 38, 0.80);
		box-shadow: 0 1px 8px rgba(0, 0, 0, 0.04);
	}
	.dl_nei_rong {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		width: 100%;
	}
	.dl_wei_bu { width: 100%; height: 48px; }

	/* ---------- Hero ---------- */
	.dl_hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 8px 24px 20px 24px;
	}
	.dl_biao_qu {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 80px; height: 80px;
		margin-bottom: 12px;
	}
	.dl_biao_guang {
		position: absolute;
		left: -8px; top: -8px;
		width: 96px; height: 96px;
		border-radius: 9999px;
		/* App 端 linear-gradient 仅支持两色，取原三色的首尾 */
		background-image: linear-gradient(to bottom right, rgba(192, 193, 255, 0.45), rgba(128, 131, 255, 0.10));
	}
	.dl_biao_kuang {
		position: relative;
		width: 80px; height: 80px;
		border-radius: 16px;
		padding: 8px;
		background-color: rgba(34, 42, 61, 0.80);
		display: flex;
		align-items: center;
		justify-content: center;
	}
