		background-image: linear-gradient(to right, rgba(0, 165, 114, 0.40), rgba(0, 165, 114, 0));
	}
	.dl_li_bao_guang_you {
		right: 0;
		background-image: linear-gradient(to left, rgba(128, 131, 255, 0.20), rgba(128, 131, 255, 0));
	}
	.dl_li_bao_kuang {
		position: relative;
		z-index: 1;
		flex-shrink: 0;
		width: 36px; height: 36px;
		border-radius: 8px;
		background-color: rgba(78, 222, 163, 0.15);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.dl_li_bao_zhong {
		position: relative;
		z-index: 1;
		flex: 1;
		display: flex;
		flex-direction: column;
		margin-left: 12px;
		margin-right: 12px;
		overflow: hidden;
	}
	.dl_li_bao_hang { display: flex; flex-direction: row; align-items: center; }
	.dl_li_bao_qian {
		font-size: 10px; line-height: 14px;
		letter-spacing: 0.5px;
		padding: 0 4px;
		border-radius: 4px;
		background-color: rgba(78, 222, 163, 0.20);
		color: #4edea3;
		font-family: 'SG700';
	}
	.dl_li_bao_ming {
		font-size: 12px; line-height: 16px;
		color: #dae2fd;
		font-family: 'PJS600';
		margin-left: 6px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.dl_li_bao_fu_hang {
		display: flex;
		flex-direction: row;
		align-items: center;
		margin-top: 2px;
		overflow: hidden;
	}
	.dl_li_bao_fu {
		font-size: 12px; line-height: 16px;
