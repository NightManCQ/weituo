<script setup lang="ts">
	import { onUnmounted, ref } from 'vue'
	import type { 用户 } from '../../common/leixing'
	import { 发送请求 } from '../../common/wangluo'
	import { 连接实时消息 } from '../../common/实时'
	import { 存储MQTT地址, 存储令牌, 存储用户信息 } from '../../common/本地存储'

	// 设计稿「登录注册.html」的 1:1 迁移版。
	// 深色主题、Ambient Glow、卡片层级、字号/字重/间距都按设计稿换算成 px；
	// 图标为本地 SVG（按设计稿配色着色，见 /static/deng_lu/icons），
	// 字体用项目内已有的 Plus Jakarta Sans / Space Grotesk 本地 ttf，App 端不依赖外链。
	//
	// 登录逻辑由 pages/wode/yong_hu.uvue（原个人中心的登录面板）整体迁入：
	// /auth/login、/auth/register → 存储令牌 / MQTT 地址 / 用户信息 → 连接实时消息 → 刷新会话列表。
	// 登录成功后返回上一页，「我的」页 onShow 会重新读取当前用户并刷新积分。

	type 登录结果 = { 访问令牌 : string; 用户 : 用户; 消息地址 : string }
	type 社交项 = { 键 : string; 名称 : string; 图标 : string }

	// 窗口信息在 setup 同步取值，避免首帧顶栏 padding 抖动
	const 系统信息 : any = uni.getSystemInfoSync()
	const 状态栏高 = ref(系统信息.statusBarHeight ?? 0)

	// ---------- 界面状态 ----------
	const 模式 = ref('login') // login | register
	const 登录方式 = ref('sms') // sms | pwd
	const 显示密码 = ref(false)
	const 保持在线 = ref(true)
	const 记住密码 = ref(true)
	const 同意协议 = ref(true)
	const 正在处理 = ref(false)
	const 倒计时 = ref(0)
	const 提示文字 = ref('')
	const 提示图标 = ref('/static/deng_lu/icons/check_green.svg')

	// ---------- 表单 ----------
	const 手机号 = ref('')
	const 验证码 = ref('')
	// 沿用旧版便于本地联调的默认账号，上线前清空即可
	const 账号 = ref('changqing')
	const 密码 = ref('1234567890')
	const 注册账号 = ref('')
	const 注册验证码 = ref('')
	const 昵称 = ref('')
	const 邀请码 = ref('')

	const 社交列表 = ref<社交项[]>([
		{ 键: 'wechat', 名称: '微信', 图标: '/static/deng_lu/icons/chat_green.svg' },
		{ 键: 'feishu', 名称: '飞书', 图标: '/static/deng_lu/icons/send_primary.svg' },
		{ 键: 'github', 名称: 'GitHub', 图标: '/static/deng_lu/icons/terminal_light.svg' },
		{ 键: 'apple', 名称: 'Apple', 图标: '/static/deng_lu/icons/lock_person_light.svg' },
	])

	// ---------- 轻提示（设计稿底部的胶囊 Toast） ----------
	let 提示计时器 = 0
	function 显示提示(文字 : string, 图标 : string = '/static/deng_lu/icons/check_green.svg') {
		提示文字.value = 文字
		提示图标.value = 图标
		if (提示计时器 != 0) clearTimeout(提示计时器)
		提示计时器 = setTimeout(() => {
			提示文字.value = ''
			提示计时器 = 0
		}, 2400)
	}

	// ---------- 验证码倒计时 ----------
	let 倒计时器 = 0
	function 发送验证码() {
		if (倒计时.value > 0) return
		const 号码 = 模式.value == 'register' ? 注册账号.value.trim() : 手机号.value.trim()
		if (号码.length == 0) {
			显示提示('请先填写手机号 / 账号', '/static/deng_lu/icons/cancel_outline.svg')
			return
		}
		倒计时.value = 60
		显示提示('验证码已发送至预留手机')
		倒计时器 = setInterval(() => {
			倒计时.value = 倒计时.value - 1
			if (倒计时.value <= 0) {
				clearInterval(倒计时器)
				倒计时器 = 0
			}
		}, 1000)
	}

	onUnmounted(() => {
		if (倒计时器 != 0) clearInterval(倒计时器)
		if (提示计时器 != 0) clearTimeout(提示计时器)
	})

	// ---------- 交互 ----------
	function 切换模式(目标 : string) {
		if (模式.value == 目标) return
		模式.value = 目标
		if (目标 == 'register') 显示提示('🎁 注册完成即送 100 PTS 互助金！', '/static/deng_lu/icons/gift_green.svg')
	}

	function 切换登录方式(方式 : string) {
		if (登录方式.value == 方式) return
		登录方式.value = 方式
	}

	function 切换密码可见() {
		显示密码.value = !显示密码.value
	}

	function 切换区号() {
		显示提示('当前支持：+86（中国）、+1（北美）、+852（中国香港）')
	}

	function 收不到验证码() {
		显示提示('如未收到短信，请尝试账号密码登录')
	}

	function 忘记密码() {
		显示提示('已向绑定邮箱 / 手机发送密码重置链接')
	}

	function 生物识别登录() {
		显示提示('正在调起设备指纹 / 人脸识别…', '/static/deng_lu/icons/fingerprint_primary.svg')
		setTimeout(() => { 显示提示('生物识别通过，安全连接中…', '/static/deng_lu/icons/shield_outline.svg') }, 1200)
	}

	// v-for 里不能写 @click="fn(项)"：web 端会把带循环变量的处理器缓存成所有行共用的闭包
	function 社交登录(事件 : { currentTarget : { dataset : Record<string, unknown> } }) {
		const 键 = 事件.currentTarget.dataset['key']
		if (typeof 键 != 'string') return
		const 项 = 社交列表.value.find(条 => 条.键 == 键)
		if (项 == null) return
		显示提示('正在跳转 ' + 项.名称 + ' 快捷授权…')
	}

	function 返回上一页() {
		const 栈 = getCurrentPages()
		if (栈.length > 1) {
			uni.navigateBack()
		} else {
			uni.reLaunch({ url: '/pages/shou_ye/shou_ye' })
		}
	}

	// ---------- 认证 ----------
	// 后端（rust_houduan /auth/login、/auth/register）只支持登录名 + 密码，
	// 没有短信验证码接口。短信登录与注册没有密码输入框，这里用「标识 + 固定前缀」
	// 派生一个稳定密码，保证同一手机号 / 账号每次都能登录；接入真实短信 OTP 后
	// 应把这段替换成服务端校验，并把验证码字段透传给后端。
	function 派生密码(标识 : string) : string {
		return 'LQHUB@' + 标识
	}

	// 手机号里的空格（188 8800 2048）要去掉；UTS 的字符串正则在 App 端支持有限，手工拼
	function 去空格(文本 : string) : string {
		let 结果 = ''
		for (let i = 0; i < 文本.length; i++) {
			const 字 = 文本.slice(i, i + 1)
			if (字 != ' ' && 字 != '\t') 结果 += 字
		}
		return 结果
	}

	async function 提交认证(登录名 : string, 密码值 : string, 昵称值 : string, 是否注册 : boolean) {
		if (正在处理.value) return
		正在处理.value = true
		try {
			const 结果 = await 发送请求<登录结果>(是否注册 ? '/auth/register' : '/auth/login', {
				method: 'POST',
				data: {
					login_name: 登录名,
					password: 密码值,
					nickname: 昵称值,
				} as UTSJSONObject,
			})
			存储令牌(结果.访问令牌)
			存储MQTT地址(结果.消息地址)
			存储用户信息(结果.用户)
			await 连接实时消息(结果.用户)
			// 登录后立刻同步会话列表，避免切到消息页还停留在未登录状态
			显示提示(是否注册 ? '注册成功，已为你登录' : '登录成功，欢迎回来')
			setTimeout(() => { 返回上一页() }, 600)
		} catch (原因) {
			const 消息 = 原因 instanceof Error ? 原因.message : (是否注册 ? '注册失败' : '登录失败')
			显示提示(消息, '/static/deng_lu/icons/cancel_outline.svg')
			console.error(原因)
		} finally {
			正在处理.value = false
		}
	}

	async function 立即登录() {
		if (正在处理.value) return
		if (!同意协议.value) {
			显示提示('请勾选并同意服务协议及隐私条款', '/static/deng_lu/icons/cancel_outline.svg')
			return
		}
		if (登录方式.value == 'sms') {
			const 号码 = 去空格(手机号.value)
			if (号码.length < 3 || 号码.length > 64) {
				显示提示('请输入正确的手机号码', '/static/deng_lu/icons/cancel_outline.svg')
				return
			}
			if (验证码.value.length < 4) {
				显示提示('请输入 6 位短信验证码', '/static/deng_lu/icons/cancel_outline.svg')
				return
			}
			await 提交认证(号码, 派生密码(号码), '', false)
			return
		}
		const 名 = 账号.value.trim()
		if (名.length < 3) {
			显示提示('账号至少 3 个字符', '/static/deng_lu/icons/cancel_outline.svg')
			return
		}
		if (密码.value.length < 10) {
			显示提示('密码至少 10 位', '/static/deng_lu/icons/cancel_outline.svg')
			return
		}
		await 提交认证(名, 密码.value, '', false)
	}

	async function 立即注册() {
		if (正在处理.value) return
		if (!同意协议.value) {
			显示提示('请勾选并同意服务协议及隐私条款', '/static/deng_lu/icons/cancel_outline.svg')
			return
		}
		const 名 = 注册账号.value.trim()
		if (名.length < 3) {
			显示提示('注册账号至少 3 个字符', '/static/deng_lu/icons/cancel_outline.svg')
			return
		}
		if (注册验证码.value.length < 4) {
			显示提示('请输入 6 位短信验证码', '/static/deng_lu/icons/cancel_outline.svg')
			return
		}
		const 名昵称 = 昵称.value.trim()
		if (名昵称.length == 0) {
			显示提示('请设置探险家昵称', '/static/deng_lu/icons/cancel_outline.svg')
			return
		}
		await 提交认证(名, 派生密码(名), 名昵称, true)
	}
</script>

<template>
	<!-- 页面级滚动：根容器不锁 height，内容由页面自身撑开，顶栏为 fixed -->
	<view class="dl_ye">
		<!-- Ambient Glow：设计稿是 blur-[90px]，uvue 无模糊滤镜、App 端也不支持 radial-gradient，
		     故用预烘焙的径向渐隐 PNG（边缘 alpha 严格为 0）；不能用 linear-gradient + 圆形裁剪，
		     那样圆边界处会留下 40%~60% 的起始透明度，切出一条可见圆弧。 -->
		<view class="dl_guang_ceng">
			<image class="dl_guang dl_guang_1" src="/static/guang/zi_15.png" mode="scaleToFill"></image>
			<image class="dl_guang dl_guang_2" src="/static/guang/lv_12.png" mode="scaleToFill"></image>
		</view>

		<!-- 设计稿顶栏是空的，只有半透明底 + 一条细阴影 -->
		<view class="dl_ding_lan" :style="{ height: `${状态栏高}px` }"></view>

		<view class="dl_nei_rong" :style="{ 'padding-top': `${64 + 状态栏高}px` }">
			<!-- Hero 品牌区 -->
			<view class="dl_hero">
				<view class="dl_biao_qu">
					<view class="dl_biao_guang"></view>
					<view class="dl_biao_kuang">
						<image class="dl_biao_tu" src="/static/hui_hua/logo.jpg" mode="aspectFill"></image>
					</view>
					<view class="dl_ban_ben">
						<view class="dl_ban_ben_dian"></view>
						<text class="dl_ban_ben_zi">V2.4</text>
					</view>
				</view>
				<view class="dl_biao_ti_hang">
					<text class="dl_biao_ti">LinkQuest</text>
					<text class="dl_biao_ti_biao">QUEST HUB</text>
				</view>
				<text class="dl_fu_biao_ti">连接技能与信任 · 开启互助悬赏之旅</text>
			</view>

			<!-- 主交互卡 -->
			<view class="dl_ka_qu">
				<view class="dl_ka">
					<!-- 1. 登录 / 注册 分段切换 -->
					<view class="dl_mo_shi">
						<view
							class="dl_mo_shi_an"
							:class="模式 == 'login' ? 'dl_mo_shi_an_ji' : ''"
							@click="切换模式('login')"
						>
							<image
								class="dl_tu_16"
								:src="模式 == 'login' ? '/static/deng_lu/icons/key_dark.svg' : '/static/deng_lu/icons/key_muted.svg'"
								mode="aspectFit"
							></image>
							<text class="dl_mo_shi_zi" :class="模式 == 'login' ? 'dl_mo_shi_zi_ji' : ''">快速登录</text>
						</view>
						<view
							class="dl_mo_shi_an"
							:class="模式 == 'register' ? 'dl_mo_shi_an_zc' : ''"
							@click="切换模式('register')"
						>
							<image
								class="dl_tu_16"
								:src="模式 == 'register' ? '/static/deng_lu/icons/stars_dark.svg' : '/static/deng_lu/icons/stars_muted.svg'"
								mode="aspectFit"
							></image>
							<text class="dl_mo_shi_zi" :class="模式 == 'register' ? 'dl_mo_shi_zi_zc' : ''">新用户注册</text>
							<view v-if="模式 != 'register'" class="dl_hong_dian"></view>
						</view>
					</view>

					<!-- 2. 新人礼包提示条 -->
					<view class="dl_li_bao">
						<!-- App 端只支持两色线性渐变，左右两侧光晕用两段渐变视图叠加还原 -->
						<view
							class="dl_li_bao_guang dl_li_bao_guang_zuo"
							:class="模式 == 'register' ? 'dl_li_bao_guang_zuo_ji' : ''"
						></view>
						<view class="dl_li_bao_guang dl_li_bao_guang_you"></view>
						<view class="dl_li_bao_kuang">
							<image class="dl_tu_20" src="/static/deng_lu/icons/gift_green.svg" mode="aspectFit"></image>
						</view>
						<view class="dl_li_bao_zhong">
							<view class="dl_li_bao_hang">
								<text class="dl_li_bao_qian">新伙伴特权</text>
								<text class="dl_li_bao_ming">注册即送启航礼包</text>
							</view>
							<!-- App 端 <text> 只能包含一个文本节点：拆成同行三段 text -->
							<view class="dl_li_bao_fu_hang">
								<text class="dl_li_bao_fu">立领</text>
								<text class="dl_li_bao_jia_qian">+100 PTS</text>
								<text class="dl_li_bao_fu dl_li_bao_fu_wei">悬赏金 · 首单免抽佣</text>
							</view>
						</view>
						<view class="dl_li_bao_piao">
							<text class="dl_li_bao_jia">+100</text>
							<image class="dl_tu_12" src="/static/deng_lu/icons/coin_green.svg" mode="aspectFit"></image>
						</view>
					</view>

					<!-- 3. 登录视图 -->
					<view v-if="模式 == 'login'" class="dl_deng_lu">
						<!-- 登录方式二级切换 -->
						<view class="dl_fang_shi">
							<view
								class="dl_fang_shi_an"
								:class="登录方式 == 'sms' ? 'dl_fang_shi_an_ji' : ''"
								@click="切换登录方式('sms')"
							>
								<image
									class="dl_tu_16"
									:src="登录方式 == 'sms' ? '/static/deng_lu/icons/sms_primary.svg' : '/static/deng_lu/icons/sms_muted.svg'"
									mode="aspectFit"
								></image>
								<text class="dl_fang_shi_zi" :class="登录方式 == 'sms' ? 'dl_fang_shi_zi_ji' : ''">短信验证码</text>
							</view>
							<view
								class="dl_fang_shi_an dl_fang_shi_an_you"
								:class="登录方式 == 'pwd' ? 'dl_fang_shi_an_ji' : ''"
								@click="切换登录方式('pwd')"
							>
								<image
									class="dl_tu_16"
									:src="登录方式 == 'pwd' ? '/static/deng_lu/icons/lock_primary.svg' : '/static/deng_lu/icons/lock_muted.svg'"
									mode="aspectFit"
								></image>
								<text class="dl_fang_shi_zi" :class="登录方式 == 'pwd' ? 'dl_fang_shi_zi_ji' : ''">账号密码登录</text>
							</view>
						</view>

						<!-- 登录表单：3a 短信验证码 / 3b 账号密码 -->
						<view v-if="登录方式 == 'sms'" class="dl_zi_duan_dan">
							<!-- 3a. 短信验证码登录 -->
							<view class="dl_zi_duan dl_zi_duan_shou">
								<view class="dl_zi_duan_tou">
									<text class="dl_zi_duan_ming">手机号码</text>
									<text class="dl_zi_duan_lan" @click="切换区号">切换区号</text>
								</view>
								<view class="dl_shu_ru_hang">
									<view class="dl_qu_hao" @click="切换区号">
										<text class="dl_qu_hao_zi">+86</text>
										<image class="dl_tu_16 dl_qu_hao_tu" src="/static/deng_lu/icons/arrow_down_muted.svg" mode="aspectFit"></image>
									</view>
									<view class="dl_fen_ge"></view>
									<image class="dl_tu_18 dl_hang_tu" src="/static/deng_lu/icons/phone_outline.svg" mode="aspectFit"></image>
									<input
										class="dl_shu_ru"
										v-model="手机号"
										placeholder="请输入手机号码"
										placeholder-class="dl_zhan_wei"
										maxlength="20"
									/>
									<view class="dl_qing_chu" @click="手机号 = ''">
										<image class="dl_tu_16" src="/static/deng_lu/icons/cancel_outline.svg" mode="aspectFit"></image>
									</view>
								</view>
							</view>

							<view class="dl_zi_duan">
								<view class="dl_zi_duan_tou">
									<text class="dl_zi_duan_ming">短信验证码</text>
									<text class="dl_zi_duan_hui">6位数字短信码</text>
								</view>
								<view class="dl_shu_ru_hang">
									<image class="dl_tu_18 dl_hang_tu" src="/static/deng_lu/icons/shield_outline.svg" mode="aspectFit"></image>
									<input
										class="dl_shu_ru dl_shu_ru_ma"
										v-model="验证码"
										type="number"
										placeholder="请输入短信验证码"
										placeholder-class="dl_zhan_wei"
										maxlength="6"
									/>
									<view class="dl_ma_an" :class="倒计时 > 0 ? 'dl_ma_an_jin' : ''" @click="发送验证码">
										<text class="dl_ma_an_zi">{{ 倒计时 > 0 ? `${倒计时}s 重试` : '获取验证码' }}</text>
									</view>
								</view>
							</view>

							<view class="dl_gong_ju">
								<view class="dl_ji_zhu" @click="保持在线 = !保持在线">
									<view class="dl_gou" :class="保持在线 ? 'dl_gou_xuan' : ''">
										<image v-if="保持在线" class="dl_gou_tu" src="/static/deng_lu/icons/check_tick.svg" mode="aspectFit"></image>
									</view>
									<text class="dl_gong_ju_zi">30天内保持在线</text>
								</view>
								<text class="dl_gong_ju_an" @click="收不到验证码">收不到验证码？</text>
							</view>
						</view>

						<view v-else class="dl_zi_duan_dan">
							<!-- 3b. 账号密码登录 -->
							<view class="dl_zi_duan dl_zi_duan_shou">
								<view class="dl_zi_duan_tou">
									<text class="dl_zi_duan_ming">账号 / 手机号 / 邮箱</text>
									<text class="dl_zi_duan_hui">支持多身份识别</text>
								</view>
