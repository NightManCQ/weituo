	.dl_ban_ben {
		position: absolute;
		bottom: -4px; right: -4px;
		display: flex;
		flex-direction: row;
		align-items: center;
		padding: 2px 8px;
		border-radius: 9999px;
		background-color: #2d3449;
	}
