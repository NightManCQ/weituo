  padding: 4px 14px;
  font-size: 13px;
  color: #6b7280;
}
.fen_duan_ji_huo {
  border-radius: 14px;
  background-color: #2f80ff;
  color: #ffffff;
  font-weight: 600;
}

/* 搜索框 */
.sou_suo_kuang {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 38px;
  margin-top: 10px;
  padding: 0 14px;
  border-radius: 19px;
  background-color: #f3f5f8;
}
.sou_suo_tu_biao {
  font-size: 13px;
  color: #9aa3af;
}
.sou_suo_shu_ru {
  flex: 1;
  margin-left: 6px;
  font-size: 13px;
  color: #1a2332;
}

/* 分类条 */
.fen_lei_tiao {
  margin-top: 8px;
  height: 36px;
  white-space: nowrap;
}
.fen_lei_hang {
  display: flex;
  flex-direction: row;
}
.fen_lei_xiang {
  padding: 6px 4px;
  margin-right: 18px;
  font-size: 14px;
  color: #6b7280;
  border-bottom-width: 2px;
  border-bottom-style: solid;
  border-bottom-color: transparent;
}
.fen_lei_ji_huo {
  color: #2f80ff;
  font-weight: 700;
  border-bottom-color: #2f80ff;
}

/* 地图区 */
.di_tu_qu {
  position: relative;
  flex: 1;
  margin-top: 8px;
}
.di_tu {
  width: 100%;
  height: 100%;
}

/* 底部委托卡片 */
.wei_tuo_ka {
  position: absolute;
  bottom: 14px;
  left: 12px;
  right: 12px;
  display: flex;
  flex-direction: column;
  padding: 14px 16px;
  border-radius: 14px;
  background-color: #ffffff;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
}
.ka_biao_ti {
  font-size: 16px;
  font-weight: 700;
  color: #1a2332;
}
.ka_di_zhi {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 6px;
}
.ka_di_zhi_tu_biao {
  font-size: 11px;
}
.ka_di_zhi_wen_ben {
  margin-left: 4px;
  font-size: 12px;
  color: #6b7280;
}
.ka_di_bu {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
}
.ka_bao_chou {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.ka_bao_chou_qian {
  font-size: 13px;
