<script setup lang="ts">
import { onLoad } from '@dcloudio/uni-app'
import { ref } from 'vue'
import type { 任务, 用户 } from '../../common/leixing'
import { 创建编号, 发送请求, 格式化时间, 读取当前用户 } from '../../common/wangluo'

const 委托 = ref<任务 | null>(null)
const 当前用户 = ref<用户 | null>(null)
const 正在加载 = ref(true)
const 错误 = ref('')
let 委托编号 = ''

async function 加载() {
  if (!委托编号) return
  正在加载.value = true
  错误.value = ''
  try {
    委托.value = await 发送请求<任务>(`/weituo/${encodeURIComponent(委托编号)}`)
  } catch (原因) {
    错误.value = 原因 instanceof Error ? 原因.message : '委托详情加载失败'
  } finally {
    正在加载.value = false
  }
}

async function 执行(操作: string) {
  if (委托.value == null) return
  try {
    await 发送请求(`/tasks/${encodeURIComponent(委托.value.任务编号)}/${操作}`, {
      method: 'POST',
      headers: { 'Idempotency-Key': 创建编号() },
    })
    uni.showToast({ title: '操作成功', icon: 'success' })
    await 加载()
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '操作失败', icon: 'none' })
  }
}

onLoad((参数) => {
  委托编号 = 参数['id'] as string || ''
  当前用户.value = 读取当前用户()
  void 加载()
})
</script>

<template>
  <view class="ye_mian">
    <button class="wen_ben_an_niu ju_zuo" @click="uni.navigateBack()">← 返回</button>
    <view v-if="正在加载" class="kong_zhuang_tai">正在加载委托详情…</view>
    <view v-else-if="错误" class="ti_shi_xin_xi cuo_wu">{{ 错误 }} <button class="wen_ben_an_niu" @click="加载">重试</button></view>
    <view v-else-if="委托 != null" class="ka_pian">
      <text class="biao_ji">{{ 委托.任务状态 }}</text>
      <text class="biao_ti">{{ 委托.标题 }}</text>
      <text class="biao_qian">委托说明</text>
      <text class="zheng_wen">{{ 委托.描述 || '委托方暂未提供补充说明。' }}</text>
      <text class="biao_qian">委托报酬</text>
      <text class="zheng_wen">{{ 委托.报酬积分 == null ? '无积分报酬' : `${委托.报酬积分} 积分` }}</text>
      <text class="biao_qian">发布于</text><text class="zheng_wen">{{ 格式化时间(委托.创建时间) }}</text>
      <text class="biao_qian">截止时间</text><text class="zheng_wen">{{ 委托.截止时间 == null ? '未设置' : 格式化时间(委托.截止时间) }}</text>
      <text class="biao_qian">委托地址</text>
      <text class="zheng_wen">{{ 委托.位置 == null ? '未填写' : [委托.位置.省, 委托.位置.市, 委托.位置.县, 委托.位置.地址].filter(Boolean).join(' · ') }}</text>
      <button v-if="当前用户 != null && 委托.任务状态 == '待接单' && 委托.发布者编号 != 当前用户.用户编号 && 委托.报酬积分 != null" class="zhu_yao_an_niu" @click="执行('claim')">接取委托</button>
      <button v-if="当前用户 != null && (委托.发布者编号 == 当前用户.用户编号 || 委托.接单者编号 == 当前用户.用户编号)" class="ci_yao_an_niu" @click="uni.navigateTo({ url: `/pages/liaotian/liaotian?taskId=${encodeURIComponent(委托.任务编号)}` })">打开委托会话</button>
    </view>
  </view>
</template>
