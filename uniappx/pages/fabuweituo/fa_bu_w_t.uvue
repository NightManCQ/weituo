<script setup lang="ts">
import { onShow } from '@dcloudio/uni-app'
import { computed, onMounted, ref } from 'vue'
import type { 积分账户, 任务位置, 用户 } from '../../common/leixing'
import { 发布委托 as 提交委托, 发送请求, 读取当前用户, 读取委托位置 } from '../../common/wangluo'
import { 移除委托位置 } from '../../common/本地存储'

/**
 * 设计图/发布委托.html 的迁移版（深色 Bounty Square 发单页）。
 *
 * 界面严格按设计稿落地，自上而下 6 个模块 + 底部固定发布坞 + 发布成功弹窗：
 *   ① 草稿同步条 / ② 可用赏金池横幅 / ③ 委托模式（抢单 · 竞标）
 *   ④ 委托分类胶囊 / ⑤ 悬赏内容（标题·模板·描述·附件）/ ⑥ 时间与排期
 *   ⑦ 履约地点（线上 / 线下）/ ⑧ 悬赏金额与门槛
 * 顶栏由本页自渲染 components/ding_lan（「委托详情」外观 = Connect & Create /
 * LINKQUEST NET，带返回按钮与右侧圆形头像，与设计稿 header 一致），底栏不渲染：
 * 本页是 pages.json 注册的独立页面（navigationStyle custom），由世界页右下悬浮按钮 /
 * 委托广场「去发布」等入口 uni.navigateTo 打开，不再作为首页 v-if 组件挂载；
 * 顶栏 fixed 由组件负责，本页只留顶部 / 底部占位与坞底距做避让。
 *
 * 页面级滚动：根容器不锁死高度，内容自然撑开，滚动发生在页面上。
 *
 * 后端 POST /tasks 只接受 title / description / deadline / bidding_deadline /
 * reward_points / location，所以：
 *   · 委托模式 → 决定投标截止时间的取值（抢单 = 发布即截止，仍要一个合法的未来时间）
 *   · 委托分类 → 驱动「快速导入需求模板」预填，不写库（后端无分类字段）
 *   · 参考附件 → 仅本地预览（后端无附件接口），模块头部提示已如实改为「本地预览」
 *   · 信用分门槛 / 实名认证 → 仅本页开关状态（后端无对应字段）
 */


type 分类项类型 = { 键 : string; 图开 : string; 图关 : string }
type 附件项 = { 路径 : string; 名称 : string }
type 附件槽类型 = { 键 : string; 类型 : string; 路径 : string }

// 窗口信息在 setup 期间同步取值，保证首帧顶部/底部占位就位
const 系统信息 : any = uni.getSystemInfoSync()
const 状态栏高 = ref(系统信息.statusBarHeight ?? 0)
const 窗口底高 = ref(系统信息.windowBottom ?? 0)

const 图 = '/static/fabuweituo/icons/'

// 分类顺序与图标按设计稿固定；开/关两套图标是同一 symbol 的两种配色（预着色 SVG）
const 分类项 : 分类项类型[] = [
	{ 键: '视觉设计', 图开: 图 + 'palette_on.svg', 图关: 图 + 'palette_off.svg' },
	{ 键: '技能开发', 图开: 图 + 'code_on.svg', 图关: 图 + 'code_off.svg' },
	{ 键: '跑腿代办', 图开: 图 + 'wheel_on.svg', 图关: 图 + 'wheel_off.svg' },
	{ 键: '学业答疑', 图开: 图 + 'school_on.svg', 图关: 图 + 'school_off.svg' },
	{ 键: '文案翻译', 图开: 图 + 'translate_on.svg', 图关: 图 + 'translate_off.svg' },
	{ 键: '线下搭子', 图开: 图 + 'diversity_on.svg', 图关: 图 + 'diversity_off.svg' },
]

// 设计稿的三个「快速导入需求模板」
const 模板视觉 = '【视觉交付标准】\n1. 规格尺寸：PNG 透明底 1024x1024 / 支持矢量源文件。\n2. 配色基调：深冷霓虹高反差，赛博风。\n3. 阶段节点：提交草稿选拔 -> 确认方向 -> 终稿完工。'
const 模板源码 = '【开发协作规范】\n1. 技术栈：Vue3 / TypeScript / Tailwind CSS。\n2. 验收指标：完整复现 Bug 修复、附带单测与 GitHub PR。\n3. 交付期限：48 小时内给出解决原型方案。'
const 模板跑腿 = '【跑腿代送清单】\n1. 取件点：软件园 3 号楼前台。\n2. 送达点：中区图书馆 B 座 203 研修室。\n3. 物品类型：书籍资料与密封信封，请轻拿轻放。'

// 1 PTS 按设计稿的估值口径 ≈ ¥0.1
const 估值系数 = 0.1
const 积分上限 = 1000000000
const 附件上限 = 9
// 抢单模式下投标窗口只留这么久（先到先得），仍满足后端「必须晚于当前时间」
const 抢单窗口毫秒 = 5 * 60 * 1000

const 当前用户 = ref<用户 | null>(null)
const 积分 = ref<积分账户 | null>(null)
const 积分错误 = ref('')

const 模式 = ref('竞标')
const 分类 = ref('视觉设计')

const 标题 = ref('')
const 描述 = ref('')
const 金额文案 = ref('0')

const 投标日期 = ref('')
const 投标时分 = ref('18:00')
const 交付日期 = ref('')
const 交付时分 = ref('22:00')

const 地点模式 = ref('线上')
const 位置 = ref<任务位置 | null>(null)

const 信用门槛 = ref(true)
const 实名要求 = ref(true)

const 附件列表 = ref<附件项[]>([])
const 草稿时间 = ref('')

const 正在提交 = ref(false)
const 显示成功 = ref(false)
const 成功金额 = ref(0)

/* ---------------- 小工具 ---------------- */

function 两位数(值 : number) : string {
	return 值 < 10 ? '0' + 值 : '' + 值
}

/** 2026-11-06 */
function 日期文本(时 : Date) : string {
	return 时.getFullYear() + '-' + 两位数(时.getMonth() + 1) + '-' + 两位数(时.getDate())
}

/** 11-06（时间轴用短日期，和设计稿一致） */
function 短日期(期 : string) : string {
	return 期.length >= 10 ? 期.slice(5, 10) : 期
}

function 时分文本(时 : Date) : string {
	return 两位数(时.getHours()) + ':' + 两位数(时.getMinutes())
}

/** 以「今天」为基准偏移天数后得到某天某时某分，跨月交给 Date 归一化 */
function 偏移时刻(起 : Date, 天 : number, 时 : number, 分 : number) : Date {
	return new Date(起.getFullYear(), 起.getMonth(), 起.getDate() + 天, 时, 分, 0, 0)
}

/** 850 -> 850，2450 -> 2,450 */
function 千分位(值 : number) : string {
	const 原样 = '' + Math.round(值)
	let 结果 = ''
	let 计数 = 0
	for (let i = 原样.length - 1; i >= 0; i--) {
		结果 = 原样.slice(i, i + 1) + 结果
		计数++
		if (计数 % 3 == 0 && i > 0) 结果 = ',' + 结果
	}
	return 结果
}

function 提示(文 : string) {
	uni.showToast({ title: 文, icon: 'none' })
}

/* ---------------- 派生状态 ---------------- */

const 可用积分 = computed(() : number => {
	const 账户 = 积分.value
	if (账户 == null) return 0
	return 账户.可用积分
})

const 积分文本 = computed(() : string => {
	if (积分.value == null) return '—'
	return 千分位(可用积分.value)
})

const 金额数 = computed(() : number => {
	const 原 = 金额文案.value
	if (原 == '') return 0
	const 值 = parseInt(原)
	if (Number.isNaN(值)) return 0
	return 值
})

const 金额文本 = computed(() : string => 千分位(金额数.value))

const 估值文本 = computed(() : string => '≈ ¥' + (金额数.value * 估值系数).toFixed(2))

const 标题字数 = computed(() : number => 标题.value.length)

const 抢单中 = computed(() : boolean => 模式.value == '抢单')

// 时间轴三个节点：即刻发布 → 截标选人 → 成果验收（都取真实选择的日期）
const 即刻文案 = computed(() : string => 短日期(日期文本(new Date())) + ' 即刻发布')
const 截标文案 = computed(() : string => 短日期(投标日期.value) + ' 截标选人')
const 验收文案 = computed(() : string => 短日期(交付日期.value) + ' 成果验收')
// 「开始生效时间」写死在首帧：发布后立即生效，不随页面停留时间漂移
const 即刻值文案 = computed(() : string => '今天（' + 短日期(日期文本(new Date())) + '）' + 时分文本(new Date()) + ' 即刻')

const 草稿文案 = computed(() : string => 草稿时间.value == '' ? '尚未保存草稿' : '草稿已同步 ' + 草稿时间.value)

const 地点文本 = computed(() : string => {
	const 当前 = 位置.value
	if (当前 == null) return '输入具体面交 / 协作地址（如中区图书馆 B1 创意舱）'
	if (当前.地址 != null && 当前.地址 != '') return 当前.地址
	return [当前.省, 当前.市, 当前.县].filter((段 : string | null) : boolean => 段 != null && 段 != '').join(' · ')
})

// 附件格固定三列：先排已有图，再排一个「添加」位，最后补空位凑满整行
const 附件槽 = computed(() => {
	const 结果 : 附件槽类型[] = []
	const 已有 = 附件列表.value
	for (let i = 0; i < 已有.length; i++) {
		const 项 = 已有[i]
		结果.push({ 键: '图_' + i, 类型: '图', 路径: 项.路径 })
	}
	if (已有.length < 附件上限) 结果.push({ 键: '添加', 类型: '加', 路径: '' })
	while (结果.length % 3 != 0) 结果.push({ 键: '空_' + 结果.length, 类型: '空', 路径: '' })
	return 结果
})

// 底部坞里的「预估冻结托管」跟着金额走，和设计稿的联动一致
const 坞金额文本 = computed(() : string => 金额文本.value)

const 能提交 = computed(() : boolean => {
	if (正在提交.value) return false
	if (当前用户.value == null) return true
	if (标题.value.trim() == '') return false
	const 金额 = 金额数.value
	if (金额 < 0 || 金额 > 积分上限) return false
	return true
})

/* ---------------- 时间 ---------------- */

function 设置投标日期(事件 : { detail : { value : string } }) {
	投标日期.value = 事件.detail.value
}

function 设置投标时分(事件 : { detail : { value : string } }) {
	投标时分.value = 事件.detail.value
}

function 设置交付日期(事件 : { detail : { value : string } }) {
	交付日期.value = 事件.detail.value
}

function 设置交付时分(事件 : { detail : { value : string } }) {
	交付时分.value = 事件.detail.value
}

function 初始化时间() {
	const 现在 = new Date()
	const 投标 = 偏移时刻(现在, 1, 18, 0)
	const 交付 = 偏移时刻(现在, 4, 22, 0)
	投标日期.value = 日期文本(投标)
	投标时分.value = '18:00'
	交付日期.value = 日期文本(交付)
	交付时分.value = '22:00'
}

/* ---------------- 交互 ---------------- */

function 选模式(键 : string) {
	模式.value = 键
}

// v-for 里的 @click="选分类(项.键)" 在 web 端会命中第一项（闭包被复用），
// 改成 dataset 取值，和委托广场页保持同一种写法。
function 选分类(事件 : { currentTarget : { dataset : Record<string, unknown> } }) {
	const 键 = 事件.currentTarget.dataset['key']
	if (typeof 键 != 'string') return
	分类.value = 键
	// 跑腿 / 线下搭子天然要见面，顺手把履约地点切到线下（与描述是否已填无关）
	if (键 == '跑腿代办' || 键 == '线下搭子') 地点模式.value = '线下'
	// 分类只做写作引导：描述还空着时，套用这一类的模板（后端没有分类字段，不写库）
	if (描述.value.trim() != '') return
	if (键 == '视觉设计') 描述.value = 模板视觉
	else if (键 == '技能开发') 描述.value = 模板源码
	else if (键 == '跑腿代办') 描述.value = 模板跑腿
}

function 套模板(类型 : string) {
	if (类型 == '视觉') 描述.value = 模板视觉
	else if (类型 == '源码') 描述.value = 模板源码
	else 描述.value = 模板跑腿
	提示('已导入需求模板')
}

function 加金额(增量 : number) {
	const 现值 = 金额数.value
	const 结果 = 现值 + 增量
	金额文案.value = '' + 结果
}

function 选地点模式(键 : string) {
	地点模式.value = 键
}

function 选位置() {
	uni.navigateTo({ url: '/pages/xuanzedizhi/xuanzedizhi' })
}

function 加附件() {
	const 剩余 = 附件上限 - 附件列表.value.length
	if (剩余 <= 0) {
		提示('最多 ' + 附件上限 + ' 张参考图')
		return
	}
	uni.chooseImage({
		count: 剩余,
		success: (结果 : any) => {
			const 路径表 = 结果.tempFilePaths as string[]
			if (路径表 == null) return
			const 新表 = 附件列表.value.slice()
			for (let i = 0; i < 路径表.length; i++) {
				const 序 = 新表.length + 1
				新表.push({ 路径: 路径表[i], 名称: '参考图 ' + 序 + '.png' })
			}
			附件列表.value = 新表
		},
		fail: () => { 提示('选择图片已取消') },
	})
}

// 同样避免 v-for 闭包：删附件按 data-idx 定位
function 删附件(事件 : { currentTarget : { dataset : Record<string, unknown> } }) {
	const 原 = 事件.currentTarget.dataset['idx']
	const 序 = typeof 原 == 'string' ? parseInt(原) : -1
	if (Number.isNaN(序) || 序 < 0) return
	const 新表 = 附件列表.value.slice()
	新表.splice(序, 1)
	附件列表.value = 新表
}

function 附件名(序 : number) : string {
	const 表 = 附件列表.value
	if (序 < 0 || 序 >= 表.length) return ''
	return 表[序].名称
}

function 看规则() {
	uni.showModal({
		title: '发单规则',
		content: '1. 赏金在发布时冻结，验收通过后才打给接单方。\n2. 竞标模式截止后进入 24 小时选人期。\n3. 逾期未验收将自动进入维权仲裁。\n4. 平台零抽成，赏金 100% 直达履约方。',
		showCancel: false,
		confirmText: '知道了',
	})
}

/* ---------------- 草稿 ---------------- */

function 存草稿() {
	uni.setStorageSync('fb_cg_biao_ti', 标题.value)
	uni.setStorageSync('fb_cg_miao_shu', 描述.value)
	uni.setStorageSync('fb_cg_jin_e', 金额文案.value)
	uni.setStorageSync('fb_cg_fen_lei', 分类.value)
	uni.setStorageSync('fb_cg_mo_shi', 模式.value)
	const 时刻 = 时分文本(new Date())
	uni.setStorageSync('fb_cg_shi_jian', 时刻)
	草稿时间.value = 时刻
	提示('草稿已保存到本机')
}

function 读草稿() {
	const 时刻 = uni.getStorageSync('fb_cg_shi_jian') as string
	if (时刻 == null || 时刻 == '') return
	const 旧标题 = uni.getStorageSync('fb_cg_biao_ti') as string
	const 旧描述 = uni.getStorageSync('fb_cg_miao_shu') as string
	const 旧金额 = uni.getStorageSync('fb_cg_jin_e') as string
	const 旧分类 = uni.getStorageSync('fb_cg_fen_lei') as string
	const 旧模式 = uni.getStorageSync('fb_cg_mo_shi') as string
	if (旧标题 != null) 标题.value = 旧标题
	if (旧描述 != null) 描述.value = 旧描述
	if (旧金额 != null && 旧金额 != '') 金额文案.value = 旧金额
	if (旧分类 != null && 旧分类 != '') 分类.value = 旧分类
	if (旧模式 != null && 旧模式 != '') 模式.value = 旧模式
	草稿时间.value = 时刻
}

function 清空表单() {
	标题.value = ''
	描述.value = ''
	金额文案.value = '0'
	附件列表.value = []
	位置.value = null
	信用门槛.value = true
	实名要求.value = true
	初始化时间()
	uni.removeStorageSync('fb_cg_shi_jian')
	草稿时间.value = ''
}

/* ---------------- 数据 ---------------- */

async function 加载积分() {
	积分错误.value = ''
	try {
		积分.value = await 发送请求<积分账户>('/my/points')
	} catch (原因) {
		积分错误.value = 原因 instanceof Error ? 原因.message : '积分账户加载失败'
	}
}

/** 发布成功后 5 分钟内的真实投标窗口（抢单模式用） */
function 抢单截止文本() : string {
	const 截止 = new Date(Date.now() + 抢单窗口毫秒)
	return 日期文本(截止) + 'T' + 时分文本(截止) + ':00'
}

function 组合时间(日期 : string, 时分 : string) : string {
	if (日期 == '') return ''
	return 日期 + 'T' + (时分 == '' ? '18:00' : 时分) + ':00'
}

async function 提交() {
	if (正在提交.value) return
	if (当前用户.value == null) {
		提示('请先登录后再发布委托')
		return
	}
	const 清理标题 = 标题.value.trim()
	if (清理标题 == '') {
		提示('请填写委托标题')
		return
	}
	const 分段 = 金额数.value
	if (!Number.isInteger(分段) || 分段 < 0 || 分段 > 积分上限) {
		提示('积分必须是 0 到 10 亿之间的整数')
		return
	}
	if (积分.value != null && 分段 > 可用积分.value) {
		提示('赏金不能超过可用积分 ' + 积分文本.value)
		return
	}
	// 抢单模式：投标窗口只留 5 分钟，先到先得
	const 投标时间 = 抢单中.value ? 抢单截止文本() : 组合时间(投标日期.value, 投标时分.value)
	if (投标时间 == '') {
		提示('请选择投标截止时间')
		return
	}
	if (new Date(投标时间).getTime() <= Date.now()) {
		提示('投标截止时间必须晚于当前时间')
		return
	}
	const 交付时间 = 组合时间(交付日期.value, 交付时分.value)
	if (交付时间 == '') {
		提示('请选择最终交付时间')
		return
	}
	if (new Date(交付时间).getTime() <= new Date(投标时间).getTime()) {
		提示('最终交付时间必须晚于投标截止时间')
		return
	}
	正在提交.value = true
	try {
		await 提交委托(清理标题, 描述.value.trim(), 交付时间, 投标时间, 分段, 地点模式.value == '线下' ? 位置.value : null)
		成功金额.value = 分段
		显示成功.value = true
	} catch (原因) {
		提示(原因 instanceof Error ? 原因.message : '发布失败')
	} finally {
		正在提交.value = false
	}
}

/** 发布成功后用 redirectTo 替换当前发布页，返回时不会再回到已提交的表单 */
function 去委托广场() {
	显示成功.value = false
	清空表单()
	uni.redirectTo({ url: '/pages/weituo/wei_tuo_guang_chang' })
}

function 回主看板() {
	显示成功.value = false
	清空表单()
	uni.reLaunch({ url: '/pages/shou_ye/shou_ye?tab=消息' })
}

// onShow 覆盖「选完地址返回」，onMounted 覆盖页面首次载入
let 上次初始化 = 0
function 初始化页面() {
	const 现在 = Date.now()
	if (现在 - 上次初始化 < 400) return
	上次初始化 = 现在
	// 顶栏与占位共用状态栏高，从后台返回 / 状态栏变化时同步刷新（与首页一致）
	const 信息 : any = uni.getSystemInfoSync()
	状态栏高.value = 信息.statusBarHeight ?? 0
	窗口底高.value = 信息.windowBottom ?? 0
	当前用户.value = 读取当前用户()
	const 结果 = 读取委托位置()
	if (结果 != null) {
		位置.value = 结果
		移除委托位置()
		地点模式.value = '线下'
	}
	if (当前用户.value != null) void 加载积分()
	else {
		积分.value = null
		积分错误.value = ''
	}
}

/** 顶栏右侧圆形头像：设计稿是静态头像，这里补一个轻提示避免死按钮 */
function 点头像() {
	uni.showToast({ title: '个人主页与信誉档案', icon: 'none' })
}

// 窗口信息与时间默认值在 setup 里一次到位，避免首帧跳动
初始化时间()
onShow(初始化页面)
onMounted(() => {
	读草稿()
	初始化页面()
})

// 顶部让出 fixed 顶栏：64px 内容行 + 状态栏（顶栏组件用同一个 状态栏高，两者严格对齐）。
// 底部发布坞按设计稿「fixed bottom-0」贴页面底部：本页是独立页面，
// 不再有首页底栏 / 中间凸起发布胶囊，所以不再额外抬高 86px。
// 内容底部占位 = 坞高 72 + 系统安全区 + 12 余量，保证滚到底不被坞遮住。
const 顶部占位 = computed(() : number => 64 + 状态栏高.value)
const 底部占位 = computed(() : number => 72 + 窗口底高.value + 12)
const 坞底距 = computed(() : number => 窗口底高.value)
</script>

