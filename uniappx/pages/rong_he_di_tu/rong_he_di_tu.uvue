<script setup lang="ts">
import { onLoad } from '@dcloudio/uni-app'
import { ref } from 'vue'

/**
 * 融合地图（游戏化委托地图）：由原型「委托广场-融合地图.html」迁移而来。
 * 地图为 CSS 示意绘制（非真实地理数据），标记与任务为演示占位，
 * 接入时替换为接口数据，正式版可换高德/腾讯地图 SDK + 游戏化图层。
 */
type 演示委托 = {
  编号: string
  标题: string
  地址: string
  距离: string
  报酬: number
  热度: number
  等级: 'SSR' | 'SSS' | 'SS' | 'S' | 'A' | 'B' | 'C' | 'D' // 委托等级（八级体系：SSR 天命级最高 → D 日常级最低）
  类型: '任务' | '宝箱' | '锁定'
  位置x: number // 地图容器内水平百分比
  位置y: number // 地图容器内垂直百分比
}

const 状态栏高 = ref(20)
const 搜索词 = ref('')

const 委托池: 演示委托[] = [
  // 八种委托等级测试委托：SSR 天命级最高 → D 日常级最低，热度取各等级初始值，报酬取各等级区间示意值
  { 编号: 'ceshi-ssr', 标题: '开发中文编程语言原生框架', 地址: '深圳市南山区科技园', 距离: '0.6km', 报酬: 1000000, 热度: 100, 等级: 'SSR', 类型: '任务', 位置x: 52, 位置y: 30 },
  { 编号: 'ceshi-sss', 标题: '限时悬赏：搭建分布式任务调度系统', 地址: '福田区', 距离: '3.2km', 报酬: 600000, 热度: 100, 等级: 'SSS', 类型: '任务', 位置x: 18, 位置y: 38 },
  { 编号: 'ceshi-ss', 标题: '企业级 ERP 系统整体交付', 地址: '宝安区', 距离: '7.4km', 报酬: 300000, 热度: 90, 等级: 'SS', 类型: '任务', 位置x: 82, 位置y: 42 },
  { 编号: 'ceshi-s', 标题: '大型直播电商平台架构设计', 地址: '龙华区', 距离: '9.5km', 报酬: 80000, 热度: 85, 等级: 'S', 类型: '锁定', 位置x: 30, 位置y: 71 },
  { 编号: 'ceshi-a', 标题: '开发 Rust 后端 API 服务', 地址: '深圳市南山区科技园', 距离: '1.2km', 报酬: 5000, 热度: 70, 等级: 'A', 类型: '任务', 位置x: 50, 位置y: 52 },
  { 编号: 'ceshi-b', 标题: '委托广场 UI 设计', 地址: '南山区', 距离: '2.5km', 报酬: 1280, 热度: 60, 等级: 'B', 类型: '任务', 位置x: 24, 位置y: 20 },
  { 编号: 'ceshi-c', 标题: '功能测试与验收', 地址: '福田区', 距离: '4.1km', 报酬: 300, 热度: 50, 等级: 'C', 类型: '任务', 位置x: 72, 位置y: 18 },
  { 编号: 'ceshi-d', 标题: '文案校对', 地址: '罗湖区', 距离: '3.4km', 报酬: 150, 热度: 40, 等级: 'D', 类型: '任务', 位置x: 86, 位置y: 68 },
]

/** 八级委托等级 → 对应等级徽章 SVG（static/svg 下与等级同名的独立文件，image 只能引用 /static 内资源） */
const 等级图标表: Record<string, string> = {
  SSR: '/static/svg/SSR.svg',
  SSS: '/static/svg/SSS.svg',
  SS: '/static/svg/SS.svg',
  S: '/static/svg/S.svg',
  A: '/static/svg/A.svg',
  B: '/static/svg/B.svg',
  C: '/static/svg/C.svg',
  D: '/static/svg/D.svg',
}

/** 取等级徽章 SVG 路径；未知等级兜底为 D 日常级 */
function 等级图标(等级: string): string {
  return 等级图标表[等级] ?? '/static/svg/D.svg'
}

/** 八级徽章尺寸（px）：D 最小，逐级放大到 SSR 最大。单一数据源，标记容器/价格气泡都按它换算 */
const 等级尺寸表: Record<string, number> = {
  D: 60,
  C: 66,
  B: 72,
  A: 78,
  S: 84,
  SS: 90,
  SSS: 96,
  SSR: 104,
}

/** 取等级徽章尺寸 */
function 徽章尺寸(等级: string): number {
  return 等级尺寸表[等级] ?? 等级尺寸表['D']
}

/** 标记居中偏移（负半宽半高），让任意尺寸的徽章都以坐标点为圆心 */
function 徽章偏移(等级: string): number {
  return -(徽章尺寸(等级) / 2)
}

/** 极个别平台 image 加载 svg 失败时降级：记录失败等级，回退显示等级字母 */
const 图标失败等级 = ref<string[]>([])
function 图标加载失败(等级: string) {
  if (图标失败等级.value.includes(等级)) return
  图标失败等级.value = 图标失败等级.value.concat(等级)
}
function 图标是否失败(等级: string): boolean {
  return 图标失败等级.value.includes(等级)
}

const 选中编号 = ref('ceshi-a')

function 选中委托(): 演示委托 | null {
  return 委托池.find((委托) => 委托.编号 == 选中编号.value) ?? null
}

function 选择委托(编号: string) {
  const 委托 = 委托池.find((d) => d.编号 == 编号)
  if (委托 == null) return
  if (委托.类型 == '锁定') {
    uni.showToast({ title: '等级不足，Lv.5 解锁（演示）', icon: 'none' })
    return
  }
  选中编号.value = 编号
}

function 标记样式(委托: 演示委托): string {
  if (委托.编号 == 选中编号.value) return 'biao_ji biao_ji_ji_huo'
  if (委托.类型 == '锁定') return 'biao_ji biao_ji_suo'
  return 'biao_ji'
}

/** 标记内容统一用等级徽章 SVG 展示（见模板 biao_ji_tu）；锁定点在其上叠加 🔒 角标 */

/** 等级中文名：任务卡徽章展示用 */
function 等级中文名(等级: string): string {
  const 表: Record<string, string> = {
    SSR: '天命级',
    SSS: '传奇级',
    SS: '传说级',
    S: '史诗级',
    A: '稀有级',
    B: '精良级',
    C: '普通级',
    D: '日常级',
  }
  return 表[等级] ?? ''
}

/** 顶部「列表」切换：从哪来回哪去，直接打开则跳委托广场列表页 */
function 返回列表() {
  const 栈 = getCurrentPages()
  if (栈.length > 1) uni.navigateBack()
  else uni.redirectTo({ url: '/pages/zhuye/zhuye' })
}

function 领取任务() {
  const 委托 = 选中委托()
  if (委托 == null) return
  uni.showToast({ title: `已领取「${委托.标题}」（演示）`, icon: 'none' })
}

function 搜索输入() {
  // 演示占位：接入接口数据后在此过滤委托池
}

onLoad(() => {
  const 信息 = uni.getSystemInfoSync()
  状态栏高.value = 信息.statusBarHeight ?? 20
})
</script>

<template>
  <view class="rong_he_di_tu_ye" :style="{ paddingTop: 状态栏高 + 'px' }">
    <!-- 顶部：标题 + 列表/地图切换 -->
    <view class="ding_bu">
      <view class="biao_ti_hang">
        <text class="ye_biao_ti">委托广场</text>
        <view class="fen_duan">
          <text class="fen_duan_xiang" @click="返回列表">列表</text>
          <text class="fen_duan_xiang fen_duan_ji_huo">地图</text>
        </view>
      </view>
      <!-- 搜索栏 + 游戏化 HUD -->
      <view class="sou_suo_hang">
        <view class="sou_suo_kuang">
          <text class="sou_suo_tu_biao">🔍</text>
          <input v-model="搜索词" class="sou_suo_shu_ru" placeholder="搜索附近需求" placeholder-class="sou_suo_zhan_wei" @input="搜索输入" />
        </view>
        <view class="hud">
          <view class="hud_chip hud_jin_bi"><text class="hud_zi hud_zi_jin hud_tu_biao">¥</text><text class="hud_zi hud_zi_jin">1280</text></view>
          <view class="hud_chip hud_deng_ji"><text class="hud_zi hud_zi_deng_ji">Lv.3</text></view>
          <view class="hud_chip hud_ti_li"><text class="hud_zi hud_zi_ti_li hud_tu_biao">⚡</text><text class="hud_zi hud_zi_ti_li">80</text></view>
        </view>
      </view>
    </view>

    <!-- 地图区 -->
    <view class="di_tu_qu">
      <view class="di_tu_bg">
        <!-- 街区区块 -->
        <view class="qu_kuai q1"></view>
        <view class="qu_kuai q2"></view>
        <view class="qu_kuai q3"></view>
        <view class="qu_kuai q4"></view>
        <!-- 网格线 -->
        <view class="wang_ge_heng"></view>
        <view class="wang_ge_shu"></view>
        <!-- 霓虹道路 -->
        <view class="dao_lu d1"></view>
        <view class="dao_lu d2"></view>
        <view class="dao_lu d3"></view>
        <!-- 数据光点 -->
        <view class="guang_dian g1"></view>
        <view class="guang_dian g2"></view>
        <view class="guang_dian g3"></view>
        <view class="guang_dian g4"></view>
        <view class="guang_dian g5"></view>
        <view class="guang_dian g6"></view>
        <view class="guang_dian g7"></view>
        <view class="guang_dian g8"></view>
        <!-- 任务标记 -->
        <view
          v-for="委托 in 委托池"
          :key="委托.编号"
          :class="标记样式(委托)"
          :style="{ left: 委托.位置x + '%', top: 委托.位置y + '%', width: 徽章尺寸(委托.等级) + 'px', height: 徽章尺寸(委托.等级) + 'px', marginLeft: 徽章偏移(委托.等级) + 'px', marginTop: 徽章偏移(委托.等级) + 'px' }"
          @click="选择委托(委托.编号)"
        >
          <!-- 等级徽章 SVG（尺寸随等级递增：D 最小 → SSR 最大；加载失败时降级为该等级字母） -->
          <image
            v-if="!图标是否失败(委托.等级)"
            class="biao_ji_tu"
            :style="{ width: 徽章尺寸(委托.等级) + 'px', height: 徽章尺寸(委托.等级) + 'px' }"
            :src="等级图标(委托.等级)"
            mode="aspectFit"
            @error="图标加载失败(委托.等级)"
          />
          <text v-else class="biao_ji_zi" :class="'biao_ji_zi_' + 委托.等级.toLowerCase()">{{ 委托.等级 }}</text>
          <!-- 锁定点角标 -->
          <text v-if="委托.类型 == '锁定'" class="biao_ji_suo_biao">🔒</text>
          <view v-if="委托.编号 == 选中编号" class="jia_ge_pao"><text class="jia_ge_pao_zi">¥{{ 委托.报酬 }}</text></view>
        </view>
      </view>

      <!-- 底部任务卡 -->
      <view v-if="选中委托() != null" class="wei_tuo_ka">
        <view class="ka_shang">
          <!-- 任务卡等级徽章 SVG（与地图标记同一套八级图标） -->
          <image
            v-if="!图标是否失败(选中委托()!.等级)"
            class="ka_deng_ji_tu"
            :src="等级图标(选中委托()!.等级)"
            mode="aspectFit"
            @error="图标加载失败(选中委托()!.等级)"
          />
          <view class="ka_zuo">
            <view class="ka_deng_ji" :class="'ka_deng_ji_' + 选中委托()!.等级.toLowerCase()">
              <text class="ka_deng_ji_zi">{{ 选中委托()!.等级 }} {{ 等级中文名(选中委托()!.等级) }}</text>
            </view>
            <text class="ka_biao_ti">{{ 选中委托()!.标题 }}</text>
            <view class="ka_di_zhi">
              <text class="ka_di_zhi_tu_biao">📍</text>
              <text class="ka_di_zhi_wen_ben">{{ 选中委托()!.地址 }} · 距离 {{ 选中委托()!.距离 }}</text>
            </view>
          </view>
          <view class="ka_bao_chou">
            <text class="ka_bao_chou_qian">报酬</text>
            <text class="ka_bao_chou_zhi">¥{{ 选中委托()!.报酬 }}</text>
          </view>
        </view>
        <view class="ka_xia">
          <view class="re_du">
            <view class="re_du_tiao"><view class="re_du_fill" :style="{ width: 选中委托()!.热度 + '%' }"></view></view>
            <text class="re_du_wen_zi">任务热度 {{ 选中委托()!.热度 }}%</text>
          </view>
          <view class="ling_qu_an_niu" @click="领取任务"><text class="ling_qu_an_niu_zi">领取任务</text></view>
        </view>
      </view>
    </view>
  </view>
</template>

<style scoped>
