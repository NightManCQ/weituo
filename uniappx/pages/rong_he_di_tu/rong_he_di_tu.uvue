}
.qu_kuai {
  position: absolute;
  border-radius: 6px;
  background-color: rgba(167, 139, 250, 0.07);
}
.q1 { left: 10%; top: 8%; width: 18%; height: 12%; }
.q2 { left: 64%; top: 12%; width: 23%; height: 14%; }
