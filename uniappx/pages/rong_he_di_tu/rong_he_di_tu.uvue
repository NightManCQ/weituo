  border-color: rgba(255, 210, 94, 0.45);
  background-color: rgba(12, 16, 46, 0.85);
}
.hud_deng_ji {
  border-color: rgba(167, 139, 250, 0.6);
  background-color: rgba(12, 16, 46, 0.85);
}
