  transform: scale(1.12);
  z-index: 2;
}

/* 八级委托等级降级文字配色与字号（D 朴素 → SSR 白金，字号同徽章一样逐级增大） */
.biao_ji_zi_d { color: #9ca3af; font-size: 22px; }
.biao_ji_zi_c { color: #4ade80; font-size: 24px; }
.biao_ji_zi_b { color: #60a5fa; font-size: 24px; }
.biao_ji_zi_a { color: #a78bfa; font-size: 26px; }
.biao_ji_zi_s { color: #facc15; font-size: 26px; }
