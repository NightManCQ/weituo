.g5 { left: 23%; top: 84%; }
.g6 { left: 67%; top: 24%; }
.g7 { left: 38%; top: 12%; }
.g8 { left: 90%; top: 12%; }

/* 任务标记：容器尺寸与居中偏移由内联样式按等级尺寸注入（见 徽章尺寸/徽章偏移），
   此处仅保留 A 级尺寸作兜底；不画圆形底色，SVG 自带底板与光晕 */
.biao_ji {
  position: absolute;
  width: 78px;
  height: 78px;
  margin-left: -39px;
  margin-top: -39px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.biao_ji_tu {
  width: 78px;
  height: 78px;
}
/* 降级文字：个别平台 image 加载 svg 失败时回退显示等级字母 */
.biao_ji_zi {
