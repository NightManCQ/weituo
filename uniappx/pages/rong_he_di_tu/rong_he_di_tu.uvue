  color: #ffd25e;
}
.hud_zi_deng_ji {
  color: #c4b5fd;
}
.hud_zi_ti_li {
  color: #9fe3ee;
}
.hud_tu_biao {
  margin-right: 2px;
  font-size: 10px;
}
