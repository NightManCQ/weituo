		标签文字: '赏金已入账', 标签图标: 图 + 'payments_green.svg', 标签样式: 'green', 附加文字: '', 分类: '智能合约',
		赏金文字: '+2,400', 赏金单位: 'PTS 钱包到账', 赏金底色: 'shen', 赏金暗: false,
		标题: 'Solidity 权益分发合约编写与 Foundry 自动化测试套件',
		描述: '测试覆盖率达到 98.7%，发单方给予全五星评价与额外鼓励金。',
		标题淡: false, 片段: 'none', 里程碑: false,
		头像: '', 头像2: '', 头像3: '', 名称: '', 信用: '', 副文: '', 余时: '', 右文: '',
