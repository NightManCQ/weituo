<script setup lang="ts">
import { onShow } from '@dcloudio/uni-app'
import { ref } from 'vue'
import type { 任务, 用户 } from '../../common/leixing'
import { 创建编号, 发送请求, 格式化时间, 读取当前用户 } from '../../common/wangluo'

const 当前用户 = ref<用户 | null>(null)
const 任务列表 = ref<任务[]>([])
const 委托总数 = ref(0)
const 归属 = ref<'published' | 'claimed'>('published')
const 分类 = ref('all')
const 正在加载 = ref(false)
const 错误信息 = ref('')
const 每页数量 = 10

async function 刷新() {
  if (当前用户.value == null) {
    任务列表.value = []
    return
  }
  正在加载.value = true
  错误信息.value = ''
  try {
    const 路径 = 归属.value == 'published' ? '/my/published-tasks' : '/my/claimed-tasks'
    const 参数 = `?status=${分类.value}&limit=${每页数量}&offset=0`
    const 结果 = await 发送请求<{ 任务列表: 任务[]; 总数: number }>(路径 + 参数)
    任务列表.value = 结果.任务列表
    委托总数.value = 结果.总数
  } catch (原因) {
    错误信息.value = 原因 instanceof Error ? 原因.message : '加载我的委托失败'
  } finally {
    正在加载.value = false
  }
}

async function 加载更多() {
  if (正在加载.value || 任务列表.value.length >= 委托总数.value) return
  正在加载.value = true
  try {
    const 路径 = 归属.value == 'published' ? '/my/published-tasks' : '/my/claimed-tasks'
    const 参数 = `?status=${分类.value}&limit=${每页数量}&offset=${任务列表.value.length}`
    const 结果 = await 发送请求<{ 任务列表: 任务[]; 总数: number }>(路径 + 参数)
    任务列表.value = [...任务列表.value, ...结果.任务列表]
    委托总数.value = 结果.总数
  } catch (原因) {
    错误信息.value = 原因 instanceof Error ? 原因.message : '加载更多委托失败'
  } finally {
    正在加载.value = false
  }
}

async function 操作(委托: 任务, 行为: string) {
  if (['cancel', 'release', 'accept-completion'].includes(行为)) {
    const 提示 = 行为 == 'accept-completion'
      ? `确认验收“${委托.标题}”并向接单方发放 ${委托.报酬积分 ?? 0} 积分？`
      : 行为 == 'release' ? `确定释放“${委托.标题}”吗？` : `确定取消“${委托.标题}”吗？`
    const 确认 = await new Promise<boolean>((resolve) => uni.showModal({
      title: '请确认',
      content: 提示,
      success: (结果) => resolve(结果.confirm),
      fail: () => resolve(false),
    }))
    if (!确认) return
  }
  try {
    await 发送请求(`/tasks/${encodeURIComponent(委托.任务编号)}/${行为}`, {
      method: 'POST',
      headers: { 'Idempotency-Key': 创建编号() },
    })
    uni.showToast({ title: '操作成功', icon: 'success' })
    await 刷新()
  } catch (原因) {
    uni.showToast({ title: 原因 instanceof Error ? 原因.message : '操作失败', icon: 'none' })
  }
}

onShow(() => {
  当前用户.value = 读取当前用户()
  void 刷新()
})
</script>

<template>
  <view class="ye_mian">
    <view class="ye_mian_biao_ti">
      <text class="fu_biao_ti">委托管理</text>
      <text class="biao_ti">我的委托</text>
      <text class="fu_zhu_wen_ben">{{ 归属 == 'published' ? '查看你发布的委托及处理进度。' : '查看你接单的委托及处理进度。' }}</text>
    </view>
    <view v-if="当前用户 == null" class="kong_zhuang_tai">
      <text>登录后查看我的委托</text>
      <button class="zhu_yao_an_niu" @click="uni.switchTab({ url: '/pages/wode/wode' })">前往登录</button>
    </view>
    <view v-else>
    <view class="cao_zuo_zu">
      <button class="ci_yao_an_niu" @click="归属 = 归属 == 'published' ? 'claimed' : 'published'; 刷新()">{{ 归属 == 'published' ? '切换到接单委托' : '切换到发布委托' }}</button>
      <button class="ci_yao_an_niu" @click="刷新">刷新</button>
    </view>
    <view class="shaixuan_lan">
      <button class="fen_lei_biao_qian" @click="分类 = 'all'; 刷新()">全部</button>
      <button class="fen_lei_biao_qian" @click="分类 = 'ongoing'; 刷新()">进行中</button>
      <button class="fen_lei_biao_qian" @click="分类 = 'completed'; 刷新()">已完成</button>
    </view>
    <view v-if="错误信息" class="ti_shi_xin_xi cuo_wu">{{ 错误信息 }}</view>
    <view v-if="正在加载 && 任务列表.length == 0" class="kong_zhuang_tai">正在加载委托…</view>
    <view v-else-if="错误信息 && 任务列表.length == 0" class="kong_zhuang_tai">
      <text>委托加载失败</text>
      <button class="ci_yao_an_niu" @click="刷新">重新加载</button>
    </view>
    <view v-else-if="任务列表.length == 0" class="kong_zhuang_tai">此分类下暂无委托</view>
    <view v-for="委托 in 任务列表" :key="委托.任务编号" class="ka_pian">
      <view class="liang_duan_dui_qi"><text class="biao_ji">{{ 委托.任务状态 }}</text><text class="fu_zhu_wen_ben">{{ 格式化时间(委托.创建时间) }}</text></view>
      <text class="ka_pian_biao_ti" @click="uni.navigateTo({ url: `/pages/weituo/weituo?id=${encodeURIComponent(委托.任务编号)}` })">{{ 委托.标题 }}</text>
      <text class="zheng_wen">{{ 委托.描述 }}</text>
      <view class="cao_zuo_zu">
        <button v-if="归属 == 'claimed' && 委托.任务状态 == '已接单'" class="xiao_hao zhu_yao_an_niu" @click="操作(委托, 'start')">开始任务</button>
        <button v-if="归属 == 'claimed' && 委托.任务状态 == '已接单'" class="xiao_hao ci_yao_an_niu" @click="操作(委托, 'release')">释放委托</button>
        <button v-if="归属 == 'claimed' && 委托.任务状态 == '进行中'" class="xiao_hao zhu_yao_an_niu" @click="操作(委托, 'complete')">提交完成</button>
        <button v-if="归属 == 'published' && 委托.任务状态 == '待验收'" class="xiao_hao zhu_yao_an_niu" @click="操作(委托, 'accept-completion')">确认验收</button>
        <button v-if="归属 == 'published' && ['待接单', '已接单'].includes(委托.任务状态)" class="xiao_hao ci_yao_an_niu" @click="操作(委托, 'cancel')">取消委托</button>
        <button v-if="委托.接单者编号 != null" class="xiao_hao ci_yao_an_niu" @click="uni.navigateTo({ url: `/pages/liaotian/liaotian?taskId=${encodeURIComponent(委托.任务编号)}` })">查看消息</button>
      </view>
    </view>
    <button v-if="任务列表.length > 0 && 任务列表.length < 委托总数" class="ci_yao_an_niu" :disabled="正在加载" @click="加载更多">
      {{ 正在加载 ? '加载中…' : `加载更多（${任务列表.length}/${委托总数}）` }}
    </button>
    </view>
  </view>
</template>
