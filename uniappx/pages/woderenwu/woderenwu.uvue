		头像: '', 头像2: '', 头像3: '', 名称: '', 信用: '', 副文: '', 余时: '', 右文: '',
		按钮: [
			{ 文字: '修改提案补充说明', 样式: '', 图标: '' },
			{ 文字: '撤回竞标', 样式: 'hong', 图标: '' },
		],
		搜索文本: '二次元 卡牌 战斗界面 HUD 技能动效切片 游戏UI 竞标评估 900',
