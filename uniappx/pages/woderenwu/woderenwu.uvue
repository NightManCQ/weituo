		],
		搜索文本: 'Solidity 权益分发合约 Foundry 自动化测试 智能合约 赏金已入账 2400',
	},
]

const 当前角色 = ref('published')
const 当前状态 = ref('all')
const 排序按金额 = ref(false)
const 搜索词 = ref('')

const 是发布 = computed(() : boolean => 当前角色.value == 'published')
const 主标签 = computed(() : string => 是发布.value ? '平台托管中赏金' : '待结算到账积分')
const 主数值 = computed(() : string => 是发布.value ? '1,850' : '2,400')
const 子一标签 = computed(() : string => 是发布.value ? '正在履约中' : '接单执行中')
const 子一数值 = computed(() : string => 是发布.value ? '2' : '1')
const 子一单位 = computed(() : string => '单')
const 子二标签 = computed(() : string => 是发布.value ? '历史履约完成' : '累计交付赚取')
const 子二数值 = computed(() : string => 是发布.value ? '14' : '18,920')
const 子二单位 = computed(() : string => 是发布.value ? '单' : 'PTS')
const 动作文字 = computed(() : string => 是发布.value ? '发布新委托' : '去广场接单')
const 动作图标 = computed(() : string => 是发布.value ? 图 + 'add_deep2.svg' : 图 + 'explore_deep2.svg')
const 排序文字 = computed(() : string => 排序按金额.value ? '悬赏金额' : '最新更新')

/** 设计稿 updatePillCounters：按当前角色统计 4 个状态数量 */
function 取计数(状态 : string) : number {
	let 合计 = 0
	for (let i = 0; i < 全部卡片.length; i++) {
		const 卡 = 全部卡片[i]
		if (卡.角色 != 当前角色.value) continue
		if (状态 != 'all' && 卡.状态 != 状态) continue
		合计++
	}
	return 合计
}

/** 设计稿 filterCards：角色 + 状态 + 搜索文本；排序按设计稿 toggleSort 规则 */
const 可见卡片 = computed<委托卡片[]>(() : 委托卡片[] => {
	const 词 = 搜索词.value.toLowerCase()
	const 结果 : 委托卡片[] = []
	for (let i = 0; i < 全部卡片.length; i++) {
		const 卡 = 全部卡片[i]
		if (卡.角色 != 当前角色.value) continue
		if (当前状态.value != 'all' && 卡.状态 != 当前状态.value) continue
		if (词 != '' && 卡.搜索文本.toLowerCase().indexOf(词) < 0) continue
		结果.push(卡)
	}
	结果.sort((左 : 委托卡片, 右 : 委托卡片) : number => {
		if (排序按金额.value) return 右.赏金 - 左.赏金
		return 左.时间 - 右.时间
	})
	return 结果
})

function 切换角色(事件 : { currentTarget : { dataset : Record<string, unknown> } }) {
	当前角色.value = String(事件.currentTarget.dataset['role'] ?? 'published')
}
function 设置状态(事件 : { currentTarget : { dataset : Record<string, unknown> } }) {
	当前状态.value = String(事件.currentTarget.dataset['status'] ?? 'all')
}
function 切换排序() {
	排序按金额.value = !排序按金额.value
}
function 重置筛选() {
	搜索词.value = ''
	当前状态.value = 'all'
}
function 点卡片按钮(事件 : { currentTarget : { dataset : Record<string, unknown> } }) {
	const 文字 = String(事件.currentTarget.dataset['text'] ?? '')
	uni.showToast({ title: 文字, icon: 'none' })
}
function 点主按钮() {
	uni.showToast({ title: 动作文字.value, icon: 'none' })
}
function 点通知() {
	uni.showToast({ title: '暂无新通知', icon: 'none' })
}
function 点头像() {
	uni.navigateTo({ url: '/pages/wode/yong_hu' })
}

function 标签底色(样式 : string) : string {
	if (样式 == 'purple') return 'wd_biao_purple'
	if (样式 == 'amber') return 'wd_biao_amber'
	if (样式 == 'green') return 'wd_biao_green'
	return 'wd_biao_gray'
}
function 按钮底色(样式 : string) : string {
	if (样式 == 'zhu') return 'wd_an_zhu'
	if (样式 == 'liang') return 'wd_an_liang'
	if (样式 == 'lv') return 'wd_an_lv'
	if (样式 == 'zise') return 'wd_an_zise'
	return ''
}
function 按钮字色(样式 : string) : string {
	if (样式 == 'hong') return 'wd_an_zi_hong'
	if (样式 == 'zhu') return 'wd_an_zi_zhu'
	if (样式 == 'liang') return 'wd_an_zi_liang'
	if (样式 == 'lv') return 'wd_an_zi_lv'
	if (样式 == 'zise') return 'wd_an_zi_zise'
	return ''
}
function 标签字色(样式 : string) : string {
	if (样式 == 'purple') return 'wd_biao_zi_purple'
	if (样式 == 'amber') return 'wd_biao_zi_amber'
	if (样式 == 'green') return 'wd_biao_zi_green'
	return 'wd_biao_zi_gray'
}
function 赏金底色(值 : string) : string {
	if (值 == 'an') return 'wd_shang_an'
	if (值 == 'shen') return 'wd_shang_shen'
	return ''
}
function 按钮键(卡键 : string, 序 : number) : string {
	return 卡键 + '_' + String(序)
}
</script>

<template>
	<view class="wd_ye">
		<!-- 固定顶栏：共用 components/ding_lan，外观「我的委托」= My Delegations 单行标题 -->
		<ding_lan 外观="我的委托" 标题="My Delegations" :状态栏高="状态栏高">
			<view class="wd_ding_ling" @click="点通知">
				<image class="wd_ding_ling_tu" :src="图 + 'notifications_muted.svg'" mode="aspectFit"></image>
			</view>
			<view class="wd_ding_tou" @click="点头像">
				<image class="wd_ding_tou_tu" :src="图 + 'person_deep.svg'" mode="aspectFit"></image>
			</view>
		</ding_lan>

		<!-- 页面级滚动：根容器不锁高，顶栏 fixed，内容首块用 64 + 状态栏高 占位 -->
		<view class="wd_nei" :style="{ 'padding-top': `${顶部占位}px` }">

			<!-- ① 角色胶囊 + 统计卡 + 搜索/排序 + 状态标签 -->
			<view class="wd_tou">
				<view class="wd_jue_se">
					<view class="wd_jue_an" :class="当前角色 == 'published' ? 'wd_jue_an_xuan' : ''" :data-role="'published'" @click="切换角色">
						<image class="wd_jue_tu" :src="图 + 'campaign_primary.svg'" mode="aspectFit"></image>
						<text class="wd_jue_zi" :class="当前角色 == 'published' ? 'wd_jue_zi_xuan' : ''">我发布的委托</text>
						<text class="wd_jue_biao" :class="当前角色 == 'published' ? 'wd_jue_biao_pub' : ''">5</text>
					</view>
					<view class="wd_jue_an" :class="当前角色 == 'accepted' ? 'wd_jue_an_xuan' : ''" :data-role="'accepted'" @click="切换角色">
						<image class="wd_jue_tu" :src="当前角色 == 'accepted' ? 握手工亮 : 握手工灰" mode="aspectFit"></image>
						<text class="wd_jue_zi" :class="当前角色 == 'accepted' ? 'wd_jue_zi_xuan' : ''">我接到的委托</text>
						<text class="wd_jue_biao" :class="当前角色 == 'accepted' ? 'wd_jue_biao_acc' : ''">8</text>
					</view>
				</view>

				<!-- 统计卡 -->
				<view class="wd_tong_ji">
					<image class="wd_tj_guang_zi" src="/static/guang/zi_08.png" mode="scaleToFill"></image>
					<image class="wd_tj_guang_lv" src="/static/guang/lv_06.png" mode="scaleToFill"></image>
					<view class="wd_tj_shang">
						<view class="wd_tj_zuo">
							<view class="wd_tj_tu_kuang">
								<image class="wd_tj_tu" :src="图 + 'token_green.svg'" mode="aspectFit"></image>
							</view>
							<text class="wd_tj_biao">{{ 主标签 }}</text>
						</view>
						<view class="wd_tj_an" @click="点主按钮">
							<image class="wd_tj_an_tu" :src="动作图标" mode="aspectFit"></image>
							<text class="wd_tj_an_zi">{{ 动作文字 }}</text>
						</view>
					</view>
					<view class="wd_tj_zhi_hang">
						<text class="wd_tj_zhi">{{ 主数值 }}</text>
						<text class="wd_tj_dan">PTS</text>
					</view>
					<view class="wd_tj_ge">
						<view class="wd_tj_lie">
							<text class="wd_tj_lie_biao">{{ 子一标签 }}</text>
							<view class="wd_tj_lie_hang">
								<text class="wd_tj_lie_zhi wd_tj_lie_zhi_zi">{{ 子一数值 }}</text>
								<text class="wd_tj_lie_dan">{{ 子一单位 }}</text>
							</view>
						</view>
						<view class="wd_tj_lie">
							<text class="wd_tj_lie_biao">{{ 子二标签 }}</text>
							<view class="wd_tj_lie_hang">
								<text class="wd_tj_lie_zhi wd_tj_lie_zhi_bai">{{ 子二数值 }}</text>
								<text class="wd_tj_lie_dan">{{ 子二单位 }}</text>
							</view>
						</view>
					</view>
				</view>

				<!-- 搜索 + 排序 -->
				<view class="wd_sou_hang">
					<view class="wd_sou_kuang">
						<image class="wd_sou_tu" :src="图 + 'search_muted.svg'" mode="aspectFit"></image>
						<input v-model="搜索词" class="wd_sou_shu" placeholder="搜索委托标题、协作方名称..." placeholder-class="wd_sou_zhan" />
					</view>
					<view class="wd_pai_an" @click="切换排序">
						<image class="wd_pai_tu" :src="图 + 'swap_vert_muted.svg'" mode="aspectFit"></image>
						<text class="wd_pai_zi">{{ 排序文字 }}</text>
					</view>
				</view>

				<!-- 状态胶囊：仅此处用横向 scroll-view -->
				<scroll-view class="wd_zhuang_tai" direction="horizontal" :show-scrollbar="false">
					<view class="wd_zt_hang">
						<view
							v-for="项 in 状态项"
							:key="项.键"
							class="wd_zt_pill"
							:class="当前状态 == 项.键 ? 'wd_zt_pill_xuan' : ''"
							:data-status="项.键"
							@click="设置状态"
						>
							<text class="wd_zt_zi" :class="当前状态 == 项.键 ? 'wd_zt_zi_xuan' : ''">{{ 项.文字 }}</text>
							<text class="wd_zt_zi" :class="当前状态 == 项.键 ? 'wd_zt_zi_xuan' : ''">{{ 取计数(项.键) }}</text>
						</view>
					</view>
				</scroll-view>
			</view>

			<!-- ② 委托卡片列表 -->
			<view class="wd_ka_lie">
				<view v-for="卡 in 可见卡片" :key="卡.键" class="wd_ka">
					<!-- 卡片头：状态标签 + 分类 + 赏金 -->
					<view class="wd_ka_tou">
						<view class="wd_biao_zu">
							<view class="wd_biao" :class="标签底色(卡.标签样式)">
								<image v-if="卡.标签图标 != ''" class="wd_biao_tu" :src="卡.标签图标" mode="aspectFit"></image>
								<view v-else class="wd_biao_dian" :class="卡.标签样式 == 'green' ? 'wd_biao_dian_lv' : ''"></view>
								<text class="wd_biao_zi" :class="标签字色(卡.标签样式)">{{ 卡.标签文字 }}</text>
							</view>
							<view v-if="卡.附加文字 != ''" class="wd_biao wd_biao_red">
								<text class="wd_biao_zi wd_biao_zi_red">{{ 卡.附加文字 }}</text>
							</view>
							<view v-if="卡.分类 != ''" class="wd_biao wd_biao_gray">
								<text class="wd_biao_zi wd_biao_zi_gray">{{ 卡.分类 }}</text>
							</view>
						</view>
						<view class="wd_shang" :class="赏金底色(卡.赏金底色)">
							<text class="wd_shang_shu" :class="卡.赏金暗 ? 'wd_shang_an_zi' : ''">{{ 卡.赏金文字 }}</text>
							<text class="wd_shang_dan" :class="卡.赏金暗 ? 'wd_shang_an_zi' : ''">{{ 卡.赏金单位 }}</text>
						</view>
					</view>

					<!-- 标题 + 描述 -->
					<view class="wd_ka_wen">
						<text class="wd_ka_biao" :class="卡.标题淡 ? 'wd_ka_biao_dan' : ''">{{ 卡.标题 }}</text>
						<text class="wd_ka_miao">{{ 卡.描述 }}</text>
					</view>

					<!-- 片段 A：协作方 -->
					<view v-if="卡.片段 == 'partner'" class="wd_huo_ban">
						<view class="wd_hb_zuo">
							<image class="wd_hb_tou" :src="卡.头像" mode="aspectFill"></image>
							<view class="wd_hb_wen">
								<view class="wd_hb_hang">
									<text class="wd_hb_ming">{{ 卡.名称 }}</text>
									<text class="wd_hb_xin">{{ 卡.信用 }}</text>
								</view>
								<text class="wd_hb_fu">{{ 卡.副文 }}</text>
							</view>
						</view>
						<view class="wd_hb_you">
							<image class="wd_hb_shi_tu" :src="图 + 'timer_amber.svg'" mode="aspectFit"></image>
							<text class="wd_hb_shi">{{ 卡.余时 }}</text>
						</view>
					</view>

					<!-- 里程碑进度 -->
					<view v-if="卡.里程碑" class="wd_li_cheng">
						<view class="wd_lc_nei">
							<view class="wd_lc_di"><view class="wd_lc_tiao"></view></view>
							<view class="wd_lc_hang">
								<text class="wd_lc_zi">托管锁定</text>
								<text class="wd_lc_zi wd_lc_zi_ji">线稿与试色 (进行中)</text>
								<text class="wd_lc_zi">成品验收</text>
							</view>
						</view>
					</view>

					<!-- 片段 B：竞标者堆叠 -->
					<view v-if="卡.片段 == 'candidate'" class="wd_jing_biao">
						<view class="wd_jb_zuo">
							<view class="wd_jb_tou_zu">
								<image class="wd_jb_tou" :src="卡.头像" mode="aspectFill"></image>
								<image class="wd_jb_tou wd_jb_tou_die" :src="卡.头像2" mode="aspectFill"></image>
								<view class="wd_jb_shu"><text class="wd_jb_shu_zi">3</text></view>
							</view>
							<text class="wd_jb_zi">{{ 卡.名称 }}</text>
						</view>
						<text class="wd_jb_cha">{{ 卡.右文 }}</text>
					</view>

					<!-- 片段 C：平台自动校验 -->
					<view v-if="卡.片段 == 'verify'" class="wd_yan_zheng">
						<view class="wd_yz_zuo">
							<image class="wd_yz_tu" :src="图 + 'verified_user_green.svg'" mode="aspectFit"></image>
							<text class="wd_yz_zi">{{ 卡.余时 }}</text>
						</view>
						<text class="wd_yz_you">{{ 卡.右文 }}</text>
					</view>

					<!-- 片段 D：交付横幅 -->
					<view v-if="卡.片段 == 'deliver'" class="wd_jiao_fu">
						<view class="wd_jf_zuo">
							<view class="wd_jf_tu_kuang">
								<image class="wd_jf_tu" :src="图 + 'image_green.svg'" mode="aspectFit"></image>
							</view>
							<view class="wd_jf_wen">
								<text class="wd_jf_zhu">{{ 卡.余时 }}</text>
								<text class="wd_jf_fu">{{ 卡.右文 }}</text>
							</view>
						</view>
						<text class="wd_jf_an">查看附件</text>
					</view>

					<!-- 片段 E：评分结果 -->
					<view v-if="卡.片段 == 'rating'" class="wd_ping_fen">
						<view class="wd_pf_zuo">
							<image class="wd_pf_xing" :src="图 + 'star_amber.svg'" mode="aspectFit"></image>
							<image class="wd_pf_xing" :src="图 + 'star_amber.svg'" mode="aspectFit"></image>
							<image class="wd_pf_xing" :src="图 + 'star_amber.svg'" mode="aspectFit"></image>
							<image class="wd_pf_xing" :src="图 + 'star_amber.svg'" mode="aspectFit"></image>
							<image class="wd_pf_xing" :src="图 + 'star_amber.svg'" mode="aspectFit"></image>
							<text class="wd_pf_zi">{{ 卡.余时 }}</text>
						</view>
						<text class="wd_pf_you">{{ 卡.右文 }}</text>
					</view>

					<!-- 片段 F：发单人 -->
					<view v-if="卡.片段 == 'issuer'" class="wd_fa_dan">
						<view class="wd_fd_zuo">
							<view class="wd_fd_tou"><text class="wd_fd_tou_zi">发</text></view>
							<view class="wd_fd_wen">
								<text class="wd_fd_zhu">{{ 卡.名称 }}</text>
								<text class="wd_fd_fu">{{ 卡.副文 }}</text>
							</view>
						</view>
						<text class="wd_fd_shi">{{ 卡.余时 }}</text>
					</view>

					<!-- 卡片操作按钮 -->
					<view class="wd_an_hang">
						<view
							v-for="(按, 序) in 卡.按钮"
							:key="按钮键(卡.键, 序)"
							class="wd_an"
							:class="按钮底色(按.样式) + (按.图标 != '' ? ' wd_an_you_tu' : '')"
							:data-text="按.文字"
							@click="点卡片按钮"
						>
							<image v-if="按.图标 != ''" class="wd_an_tu" :src="按.图标" mode="aspectFit"></image>
							<text class="wd_an_zi" :class="按钮字色(按.样式)">{{ 按.文字 }}</text>
						</view>
					</view>
				</view>

				<!-- 空态 -->
				<view v-if="可见卡片.length == 0" class="wd_kong">
					<view class="wd_kong_yuan">
						<image class="wd_kong_tu" :src="图 + 'inbox_primary.svg'" mode="aspectFit"></image>
					</view>
					<text class="wd_kong_biao">没有找到相关的委托</text>
					<text class="wd_kong_shuo">当前筛选状态下暂无数据，尝试调整过滤标签或发布一份属于你的新任务吧！</text>
					<view class="wd_kong_an" @click="重置筛选">
						<text class="wd_kong_an_zi">重置筛选条件</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<style>
@font-face { font-family: 'PJS400'; src: url('/static/hui_hua/fonts/PlusJakartaSans-400.ttf'); }
@font-face { font-family: 'PJS600'; src: url('/static/hui_hua/fonts/PlusJakartaSans-600.ttf'); }
@font-face { font-family: 'PJS700'; src: url('/static/hui_hua/fonts/PlusJakartaSans-700.ttf'); }
@font-face { font-family: 'PJS800'; src: url('/static/hui_hua/fonts/PlusJakartaSans-800.ttf'); }
@font-face { font-family: 'SG600'; src: url('/static/hui_hua/fonts/SpaceGrotesk-600.ttf'); }
@font-face { font-family: 'SG700'; src: url('/static/hui_hua/fonts/SpaceGrotesk-700.ttf'); }

.wd_ye {
	display: flex;
	flex-direction: column;
	width: 100%;
	background-color: #0b1326;
}
.wd_nei {
	display: flex;
	flex-direction: column;
	width: 100%;
	padding-bottom: 40px;
}

/* ---------- 顶栏右侧插槽（顶栏本体在 components/ding_lan） ---------- */
.wd_ding_ling {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 44px;
	height: 44px;
	border-radius: 22px;
}
.wd_ding_ling_tu { width: 22px; height: 22px; }
.wd_ding_tou {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 32px;
	height: 32px;
	margin-left: 8px;
	border-radius: 16px;
	background-color: #c0c1ff;
}
.wd_ding_tou_tu { width: 18px; height: 18px; }

/* ---------- ① 顶部区块 ---------- */
.wd_tou {
	display: flex;
	flex-direction: column;
padding: 16px 16px 8px;
}

/* 角色胶囊 */
.wd_jue_se {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 4px;
	border-radius: 9999px;
	background-color: #131b2e;
}
.wd_jue_an {
	display: flex;
	flex: 1;
	flex-direction: row;
	align-items: center;
	justify-content: center;
height: 34px;
	padding-left: 6px;
	padding-right: 6px;
	border-radius: 9999px;
}
.wd_jue_an_xuan { background-color: #31394d; }
.wd_jue_tu { width: 18px; height: 18px; }
.wd_jue_zi {
	font-family: 'SG600';
	color: #c7c4d7;
	font-size: 12px;
	line-height: 16px;
	font-weight: 600;
	letter-spacing: 0.3px;
	white-space: nowrap;
		margin-left: 4px;
	}
.wd_jue_zi_xuan { color: #dae2fd; }
.wd_jue_biao {
	font-family: 'SG700';
	padding-left: 6px;
	padding-right: 6px;
	border-radius: 9999px;
	background-color: #2d3449;
	color: #c7c4d7;
	font-size: 10px;
	line-height: 14px;
	font-weight: 700;
		margin-left: 4px;
	}
.wd_jue_biao_pub { background-color: rgba(128, 131, 255, 0.25); color: #c0c1ff; }
.wd_jue_biao_acc { background-color: rgba(78, 222, 163, 0.25); color: #4edea3; }

/* 统计卡 */
.wd_tong_ji {
	position: relative;
	display: flex;
	flex-direction: column;
	overflow: hidden;
	height: 176px;
	padding: 16px;
	border-radius: 12px;
	background-color: #171f33;
		margin-top: 16px;
	}
.wd_tj_guang_zi {
	position: absolute;
	top: -32px;
	right: -32px;
	width: 128px;
	height: 128px;
}
.wd_tj_guang_lv {
	position: absolute;
	bottom: -32px;
	left: -32px;
	width: 112px;
	height: 112px;
}
.wd_tj_shang {
	position: relative;
	z-index: 2;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: space-between;
	height: 28px;
	margin-bottom: 8px;
}
.wd_tj_zuo { display: flex; flex-direction: row; align-items: center;}
.wd_tj_tu_kuang {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 28px;
	height: 28px;
	border-radius: 8px;
	background-color: #222a3d;
}
.wd_tj_tu { width: 16px; height: 16px; }
.wd_tj_biao {
	font-family: 'SG600';
	color: #c7c4d7;
	font-size: 12px;
	line-height: 16px;
	font-weight: 600;
	letter-spacing: 0.36px;
		margin-left: 8px;
	}
.wd_tj_an {
	display: flex;
	flex-direction: row;
	align-items: center;
height: 28px;
	padding-left: 12px;
	padding-right: 12px;
	border-radius: 9999px;
	background-color: #8083ff;
}
.wd_tj_an_tu { width: 16px; height: 16px; }
.wd_tj_an_zi {
	font-family: 'SG700';
	color: #0d0096;
	font-size: 10px;
	line-height: 14px;
	font-weight: 700;
	white-space: nowrap;
		margin-left: 4px;
	}
.wd_tj_zhi_hang {
	position: relative;
	z-index: 2;
	display: flex;
	flex-direction: row;
	align-items: flex-end;
height: 36px;
}
.wd_tj_zhi {
	font-family: 'PJS800';
	color: #dae2fd;
	font-size: 30px;
	line-height: 36px;
	font-weight: 800;
	letter-spacing: -0.75px;
}
.wd_tj_dan {
	font-family: 'SG700';
	color: #4edea3;
	font-size: 12px;
	line-height: 16px;
	font-weight: 700;
	letter-spacing: 0.36px;
	margin-bottom: 4px;
		margin-left: 8px;
	}
.wd_tj_ge {
	position: relative;
	z-index: 2;
	display: flex;
	flex-direction: row;
margin-top: 16px;
	padding: 9px 10px 9px 2px;
	border-radius: 8px;
	background-color: rgba(19, 27, 46, 0.7);
}
.wd_tj_lie { display: flex; flex: 1; flex-direction: column;
		margin-left: 8px;
	}
.wd_tj_lie_biao {
	font-family: 'SG700';
	color: #c7c4d7;
	font-size: 10px;
	line-height: 14px;
	font-weight: 700;
	letter-spacing: 0.5px;
}
.wd_tj_lie_hang { display: flex; flex-direction: row; align-items: flex-end;}
.wd_tj_lie_zhi {
	font-family: 'PJS700';
	font-size: 18px;
	line-height: 24px;
	font-weight: 700;
	letter-spacing: -0.18px;
}
.wd_tj_lie_zhi_zi { color: #c0c1ff; }
.wd_tj_lie_zhi_bai { color: #dae2fd; }
.wd_tj_lie_dan {
	font-family: 'PJS400';
	color: #c7c4d7;
	font-size: 12px;
	line-height: 16px;
		margin-left: 4px;
	}

/* 搜索 + 排序 */
.wd_sou_hang { display: flex; flex-direction: row; align-items: center;
		margin-top: 16px;
	}
.wd_sou_kuang {
	display: flex;
	flex: 1;
	flex-direction: row;
	align-items: center;
height: 34px;
	padding-left: 12px;
	padding-right: 12px;
	border-radius: 12px;
	background-color: #222a3d;
}
.wd_sou_tu { width: 18px; height: 18px; }
.wd_sou_shu {
	flex: 1;
	padding: 0;
	border-width: 0;
	background-color: transparent;
font-family: 'PJS400';
	color: #dae2fd;
	font-size: 12px;
	line-height: 16px;
		margin-left: 8px;
	}
.wd_sou_zhan { color: rgba(199, 196, 215, 0.6); }
.wd_pai_an {
	display: flex;
	flex-direction: row;
	align-items: center;
height: 34px;
	padding-left: 12px;
	padding-right: 12px;
	border-radius: 12px;
	background-color: #222a3d;
		margin-left: 8px;
	}
.wd_pai_tu { width: 16px; height: 16px; }
.wd_pai_zi {
	font-family: 'SG700';
	color: #c7c4d7;
	font-size: 10px;
	line-height: 14px;
	font-weight: 700;
	white-space: nowrap;
		margin-left: 4px;
	}

/* 状态胶囊 */
.wd_zhuang_tai {
	display: flex;
	flex-direction: row;
	padding-top: 4px;
	padding-bottom: 4px;
	white-space: nowrap;
		margin-top: 16px;
	}
.wd_zt_hang {
	display: flex;
	flex-direction: row;
	align-items: center;
/* .wd_tou 已有 16px 左右内边距，横滑行不再叠加，避免整行右移 16px */
	padding-left: 0;
	padding-right: 16px;
}
.wd_zt_pill {
	display: flex;
	flex-direction: row;
	align-items: center;
height: 26px;
	padding-left: 12px;
	padding-right: 6px;
	border-radius: 9999px;
	background-color: #222a3d;
		margin-right: 8px;
	}
.wd_zt_pill_xuan { background-color: #c0c1ff; }
.wd_zt_zi {
	font-family: 'SG700';
	color: #c7c4d7;
	font-size: 10px;
	line-height: 14px;
	font-weight: 700;
	letter-spacing: 0.5px;
	white-space: nowrap;
		margin-right: 6px;
	}
.wd_zt_zi_xuan { color: #1000a9; }

/* ---------- ② 卡片列表 ---------- */
.wd_ka_lie {
	display: flex;
	flex-direction: column;
margin-top: 4px;
	padding-left: 16px;
	padding-right: 16px;
}
.wd_ka {
	display: flex;
	flex-direction: column;
padding: 16px;
	border-radius: 12px;
	background-color: #171f33;
		margin-bottom: 16px;
	}
.wd_ka_tou { display: flex; flex-direction: row; align-items: flex-start; justify-content: space-between;}
.wd_biao_zu { display: flex; flex: 1; flex-direction: row; align-items: center;}
.wd_biao {
	display: flex;
	flex-direction: row;
	align-items: center;
height: 18px;
	padding-left: 8px;
	padding-right: 8px;
	border-radius: 9999px;
		margin-right: 6px;
