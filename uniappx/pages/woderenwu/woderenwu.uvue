	},
	{
		键: 'c7', 角色: 'accepted', 状态: 'pending', 赏金: 900, 时间: 2,
		标签文字: '方案竞标评估中', 标签图标: 图 + 'hourglass_top_amber.svg', 标签样式: 'amber', 附加文字: '', 分类: '游戏UI',
