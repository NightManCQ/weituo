<script setup lang="ts">
import { onShow } from '@dcloudio/uni-app'
import { computed, ref } from 'vue'
import type { 联系人列表数据, 用户 } from '../../common/leixing'
import { 读取当前用户 } from '../../common/wangluo'
import { 联系人列表, 刷新联系人列表 } from './联系人列表'

type 好友 = Extract<联系人列表数据['数据'][number], { 项目类型: '好友' }>
type 群组 = Extract<联系人列表数据['数据'][number], { 项目类型: '群聊' }>
type 联系人项目 = 联系人列表数据['数据'][number]
const 当前用户 = ref<用户 | null>(null)
const 搜索 = ref('')
const 正在加载 = ref(false)
const 错误 = ref('')
const 联系人项目列表 = computed(() => {
  const 关键字 = 搜索.value.toLowerCase()
  return (联系人列表.value?.数据 || []).filter((项目) => {
    const 名称 = 项目.项目类型 == '好友'
      ? `${项目.昵称} ${项目.登录名}`
      : `${项目.群组名称} ${项目.最近消息 || ''}`
    return 名称.toLowerCase().includes(关键字)
  })
})

async function 刷新() {
  if (当前用户.value == null) return
  正在加载.value = true
  错误.value = ''
  try {
    await 刷新联系人列表()
  } catch (原因) {
    错误.value = 原因 instanceof Error ? 原因.message : '加载联系人失败'
  } finally {
    正在加载.value = false
  }
}

function 打开好友(好友项: 好友) {
  uni.navigateTo({ url: `/pages/lianxiren/hao_you?userId=${encodeURIComponent(好友项.用户编号)}` })
}

function 打开群聊(编号: string) {
  uni.navigateTo({ url: `/pages/liaotian/liaotian?hui_hua=${encodeURIComponent(编号)}&ming_cheng=群聊&lei_xing=群聊&bian_hao=${encodeURIComponent(编号)}` })
}

function 打开联系人(项目: 联系人项目) {
  if (项目.项目类型 == '好友') {
    打开好友(项目)
    return
  }
  打开群聊(项目.群组编号)
}

onShow(() => {
  当前用户.value = 读取当前用户()
})
</script>

<template>
  <view class="ye_mian">
    <view class="ye_mian_biao_ti liang_duan_dui_qi">
      <view><text class="biao_ti">联系人</text></view>
      <button class="ci_yao_an_niu" @click="刷新">刷新</button>
    </view>
    <view v-if="当前用户 == null" class="kong_zhuang_tai">
      <text>登录后查看联系人</text>
      <button class="zhu_yao_an_niu" @click="uni.switchTab({ url: '/pages/wode/wode' })">前往登录</button>
    </view>
    <template v-else>
      <input v-model="搜索" class="shu_ru_kuang" placeholder="搜索联系人" />
      <view class="cao_zuo_zu">
        <button class="zhu_yao_an_niu" @click="uni.navigateTo({ url: '/pages/chuanjianqun/chuanjianqun' })">创建群聊</button>
        <button class="ci_yao_an_niu" @click="uni.navigateTo({ url: '/pages/tianjiahaoyou/tianjiahaoyou' })">添加好友</button>
      </view>
      <view v-if="错误" class="ti_shi_xin_xi cuo_wu">{{ 错误 }}</view>
      <view
        v-for="项目 in 联系人项目列表"
        :key="项目.项目类型 == '好友' ? 项目.用户编号 : 项目.群组编号"
        class="lie_biao_hang ke_dian_ji"
        @click="打开联系人(项目)"
      >
        <view class="zhan_kai">
          <text class="ka_pian_biao_ti">{{ 项目.项目类型 == '好友' ? 项目.昵称 : 项目.群组名称 }}</text>
          <text class="fu_zhu_wen_ben">
            {{ 项目.项目类型 == '好友' ? `@${项目.登录名}` : 项目.最近消息 || 项目.群组公告 || '还没有消息' }}
          </text>
        </view>
        <text v-if="项目.项目类型 == '好友'" class="jian_tou">›</text>
        <text v-else class="jian_tou">›</text>
      </view>
      <view v-if="正在加载" class="kong_zhuang_tai">正在同步联系人…</view>
    </template>
  </view>
</template>
