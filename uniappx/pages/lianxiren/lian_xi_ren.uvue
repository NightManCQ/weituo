<script setup lang="ts">
	import { onLoad } from '@dcloudio/uni-app'
	import { ref } from 'vue'
	import { 发送请求 } from '../../common/wangluo'
	import type { 用户详细信息 } from '../../common/leixing'

	const 用户信息 = ref<用户详细信息 | null>(null)
	const 正在加载 = ref(false)
	const 错误信息 = ref('')
	let 用户编号 = ''

	function 格式化时间(时间 : string) : string {
		const 日期 = new Date(时间)
		if (Number.isNaN(日期.getTime())) return '未知'
		return `${日期.getFullYear()}-${String(日期.getMonth() + 1).padStart(2, '0')}-${String(日期.getDate()).padStart(2, '0')}`
	}

	async function 加载用户详情() : Promise<void> {
		if (!用户编号) return
		正在加载.value = true
		错误信息.value = ''
		try {
			用户信息.value = await 发送请求<用户详细信息>(`/users/${encodeURIComponent(用户编号)}`)
		} catch (原因) {
			错误信息.value = 原因 instanceof Error ? 原因.message : '无法加载用户信息'
		} finally {
			正在加载.value = false
		}
	}

	function 进入聊天() {
		if (!用户信息.value) return
		uni.navigateTo({
			url: `/pages/liaotian/liaotian?hui_hua=${encodeURIComponent(用户信息.value.用户编号)}&ming_cheng=${encodeURIComponent(用户信息.value.昵称)}&lei_xing=好友&bian_hao=${encodeURIComponent(用户信息.value.用户编号)}`,
		})
	}

	onLoad((参数) => {
		用户编号 = typeof 参数['userId'] == 'string' ? 参数['userId'] : ''
		void 加载用户详情()
	})
</script>

<template>
	<view class="ye_mian">
		<view v-if="正在加载" class="zhuang_tai_wen_ben">正在加载联系人信息…</view>
		<view v-else-if="错误信息" class="zhuang_tai_wen_ben cuo_wu">{{ 错误信息 }}</view>
		<view v-else-if="用户信息" class="lian_xi_ren_xiang_qing">
			<view class="yong_hu_tou_xiang">{{ 用户信息.昵称.slice(0, 1) }}</view>
			<text class="yong_hu_ni_cheng">{{ 用户信息.昵称 }}</text>
			<text class="yong_hu_deng_lu_ming">@{{ 用户信息.登录名 }}</text>

			<view class="xiang_xi_xin_xi_ka_pian">
				<view class="xiang_xi_xin_xi_hang">
					<text>账号状态</text>
					<text>{{ 用户信息.账号状态 }}</text>
				</view>
				<view class="xiang_xi_xin_xi_hang">
					<text>注册时间</text>
					<text>{{ 格式化时间(用户信息.创建时间) }}</text>
				</view>
				<view class="xiang_xi_xin_xi_hang zui_hou_xin_xi_hang">
					<text>好友关系</text>
					<text>{{ 用户信息.是否好友 ? '好友' : '非好友' }}</text>
				</view>
			</view>

			<button v-if="用户信息.是否好友" class="zhu_yao_an_niu" @click="进入聊天">发送消息</button>
		</view>
	</view>
</template>

<style lang="scss">
	.ye_mian {
		background: #f5f7f6;
		padding: 24px 16px;
	}

	.zhuang_tai_wen_ben {
		padding: 32px 0;
		text-align: center;
		color: #6b7573;
	}

	.cuo_wu {
		color: #b42318;
	}

	.lian_xi_ren_xiang_qing {
		align-items: center;
	}

	.yong_hu_tou_xiang {
		width: 88px;
		height: 88px;
		border-radius: 44px;
		background: #d7eee4;
		color: #075e54;
		font-size: 36px;
		font-weight: 700;
		line-height: 88px;
		text-align: center;
	}

	.yong_hu_ni_cheng {
		margin-top: 14px;
		font-size: 22px;
		font-weight: 700;
		color: #17201e;
	}

	.yong_hu_deng_lu_ming {
		margin-top: 4px;
		color: #7a8582;
	}

	.xiang_xi_xin_xi_ka_pian {
		width: 100%;
		margin-top: 24px;
		border-radius: 12px;
		background: #ffffff;
		padding: 0 16px;
	}

	.xiang_xi_xin_xi_hang {
		min-height: 52px;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		border-bottom-width: 1px;
		border-bottom-color: #edf0ef;
	}

	.zui_hou_xin_xi_hang {
		border-bottom-width: 0;
	}

	.zhu_yao_an_niu {
		width: 100%;
		margin-top: 20px;
		background: #087e67;
		color: #ffffff;
		border-radius: 8px;
	}
</style>
