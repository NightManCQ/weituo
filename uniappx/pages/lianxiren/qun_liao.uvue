		line-height: 88px;
		text-align: center;
	}

	.qun_liao_ming_cheng {
		margin-top: 14px;
		font-size: 22px;
		font-weight: 700;
		color: #17201e;
	}

	.qun_liao_zhuang_tai {
		margin-top: 4px;
		color: #7a8582;
	}

	.qun_liao_gong_gao_ka_pian,
	.qun_you_ka_pian {
		width: 100%;
		margin-top: 20px;
		padding: 16px;
		border-radius: 12px;
		background: #ffffff;
	}

	.ka_pian_biao_ti {
		font-size: 16px;
		font-weight: 700;
		color: #25332e;
	}

	.qun_gong_gao {
		margin-top: 10px;
		color: #52635c;
		line-height: 22px;
	}

	.qun_you_hang {
		flex-direction: row;
		align-items: center;
		padding: 12px 0;
		border-bottom-width: 1px;
		border-bottom-color: #edf0ef;
	}

	.qun_you_tou_xiang {
		width: 42px;
		height: 42px;
		border-radius: 21px;
		background: #e7f2ee;
		color: #075e54;
		line-height: 42px;
		text-align: center;
		font-weight: 700;
	}

	.qun_you_xin_xi {
		flex: 1;
		margin-left: 12px;
	}

