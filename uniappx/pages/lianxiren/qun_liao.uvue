<script setup lang="ts">
	import { onLoad } from '@dcloudio/uni-app'
	import { ref } from 'vue'
	import type { 群聊详细信息 } from '../../common/leixing'
	import { 发送请求 } from '../../common/wangluo'

	const 群聊信息 = ref<群聊详细信息 | null>(null)
	const 正在加载 = ref(false)
	const 错误信息 = ref('')
	let 群聊编号 = ''

	async function 加载群聊详情() : Promise<void> {
		if (!群聊编号) return
		正在加载.value = true
		错误信息.value = ''
		try {
			群聊信息.value = await 发送请求<群聊详细信息>(`/groups/${encodeURIComponent(群聊编号)}`)
		} catch (原因) {
			错误信息.value = 原因 instanceof Error ? 原因.message : '无法加载群聊信息'
		} finally {
			正在加载.value = false
		}
	}

	function 打开群友详情(用户编号 : string) {
		uni.navigateTo({
			url: `/pages/lianxiren/hao_you?userId=${encodeURIComponent(用户编号)}`,
		})
	}

	onLoad((参数) => {
		群聊编号 = typeof 参数['groupId'] == 'string' ? 参数['groupId'] : ''
		void 加载群聊详情()
	})
</script>

<template>
	<view class="ye_mian">
		<view v-if="正在加载" class="zhuang_tai_wen_ben">正在加载群聊信息…</view>
		<view v-else-if="错误信息" class="zhuang_tai_wen_ben cuo_wu">{{ 错误信息 }}</view>
		<view v-else-if="群聊信息" class="qun_liao_xiang_qing">
			<view class="qun_liao_tou_xiang">{{ 群聊信息.群组名称.slice(0, 1) }}</view>
			<text class="qun_liao_ming_cheng">{{ 群聊信息.群组名称 }}</text>
			<text class="qun_liao_zhuang_tai">{{ 群聊信息.群组状态 }}</text>

			<view class="qun_liao_gong_gao_ka_pian">
				<text class="ka_pian_biao_ti">群公告</text>
				<text class="qun_gong_gao">{{ 群聊信息.群组公告 || '暂无群公告' }}</text>
			</view>

			<view class="qun_you_ka_pian">
				<text class="ka_pian_biao_ti">群友 · {{ 群聊信息.成员列表.length }}</text>
				<view
					v-for="群友 in 群聊信息.成员列表"
					:key="群友.用户编号"
					@click="打开群友详情(群友.用户编号)"
				>
					<view class="qun_you_hang">
						<view class="qun_you_tou_xiang">{{ 群友.昵称.slice(0, 1) }}</view>
						<view class="qun_you_xin_xi">
							<text class="qun_you_ni_cheng">{{ 群友.昵称 }}</text>
							<text class="qun_you_jue_se">{{ 群友.成员角色 }}</text>
						</view>
						<text class="jin_ru_xiang_qing">›</text>
					</view>
				</view>
			</view>
		</view>
	</view>
</template>

<style lang="scss">
