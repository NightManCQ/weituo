/* ---------- 居中 HUD 字母气泡 ----------
 * 曾经是 top/left/right/bottom:0 的全屏 fixed 层 + opacity:0 隐藏，
 * 但 opacity 为 0 的元素仍然参与点击命中，z-index:60 又高于底栏(50)，
 * 结果整页（含底栏）点击全被这层透明蒙皮吃掉。
 * 现在：未显示时 v-if 不渲染；显示时只占中间 80×80，且 pointer-events: none。
 */
.lxr_hud {
	position: fixed; top: 50%; left: 50%;
	margin-left: -40px; margin-top: -40px;
	width: 80px; height: 80px;
	z-index: 60;
	display: flex; align-items: center; justify-content: center;
	pointer-events: none;
}
.lxr_hud_ka {
	display: flex; align-items: center; justify-content: center;
	width: 80px; height: 80px; border-radius: 16px;
	background-color: #222a3d;
	border-width: 1px; border-style: solid; border-color: rgba(192, 193, 255, 0.30);
}
.lxr_hud_zi { color: #4edea3; font-size: 38px; }

