<script setup lang="ts">
	import { onHide, onShow } from '@dcloudio/uni-app'
	import { computed, ref } from 'vue'
	import { storeToRefs } from 'pinia'
	import type { 消息会话, 用户, 群邀请 } from '../../common/leixing'
	import { 获取令牌, 发送请求, 格式化时间, 读取当前用户 } from '../../common/wangluo'
	import { 订阅实时事件 } from '../../common/实时'
	import { 使用消息会话状态 } from '../../状态/消息会话状态'

	type 好友申请 = {
		申请编号 : string
		申请人编号 : string
		登录名 : string
		昵称 : string
		申请附言 : string
		创建时间 : string
	}
	type 消息分类 = '全部' | '好友验证' | '群邀请' | 消息会话['会话类型']
	type 消息列表项 =
		| { 类型 : '会话'; 键 : string; 时间 : string; 会话 : 消息会话 }
		| { 类型 : '好友申请'; 键 : string; 时间 : string; 申请 : 好友申请 }
		| { 类型 : '群邀请'; 键 : string; 时间 : string; 邀请 : 群邀请 }

	const 会话状态 = 使用消息会话状态()
	const { 会话列表, 正在加载, 加载错误 } = storeToRefs(会话状态)
	const 当前用户 = ref<用户 | null>(null)
	const 好友申请列表 = ref<好友申请[]>([])
	const 群邀请列表 = ref<群邀请[]>([])
	const 好友申请正在加载 = ref(false)
	const 群邀请正在加载 = ref(false)
	const 正在处理申请编号 = ref('')
	const 正在处理邀请编号 = ref('')
	const 好友申请错误 = ref('')
	const 群邀请错误 = ref('')
	const 操作反馈 = ref('')
	const 搜索词 = ref('')
	const 当前分类 = ref<消息分类>('全部')
	let 申请加载序号 = 0
	let 邀请加载序号 = 0
	let 取消订阅申请 : (() => void) | null = null

	const 分类列表: 消息分类[] = ['全部', '好友验证', '群邀请', '好友', '群聊', '委托']

	const 消息列表 = computed<消息列表项[]>(() => [
		...会话列表.value.map((会话) => ({
			类型: '会话' as const,
			键: `${会话.会话类型}:${会话.会话编号}`,
			时间: 会话.最近消息时间,
			会话,
		})),
		...好友申请列表.value.map((申请) => ({
			类型: '好友申请' as const,
			键: `好友申请:${申请.申请编号}`,
			时间: 申请.创建时间,
			申请,
		})),
		...群邀请列表.value.map((邀请) => ({
			类型: '群邀请' as const,
			键: `群邀请:${邀请.邀请编号}`,
			时间: 邀请.创建时间,
			邀请,
		})),
	].sort((左侧, 右侧) => {
		const 左侧时间 = new Date(左侧.时间).getTime()
		const 右侧时间 = new Date(右侧.时间).getTime()
		if (Number.isNaN(左侧时间)) return Number.isNaN(右侧时间) ? 0 : 1
		if (Number.isNaN(右侧时间)) return -1
		return 右侧时间 - 左侧时间
	}))

	const 筛选后消息 = computed(() => {
		const 查询词 = 搜索词.value.trim().toLowerCase()
		return 消息列表.value.filter((消息) => {
			if (消息.类型 == '好友申请') {
				const 分类匹配 = 当前分类.value == '全部' || 当前分类.value == '好友验证'
				const 搜索匹配 = !查询词 || [
					消息.申请.昵称,
					消息.申请.登录名,
					消息.申请.申请附言,
				].some((内容) => 内容.toLowerCase().includes(查询词))
				return 分类匹配 && 搜索匹配
			}

			if (消息.类型 == '群邀请') {
				const 分类匹配 = 当前分类.value == '全部' || 当前分类.value == '群邀请'
				const 搜索匹配 = !查询词 || [
					消息.邀请.群组名称,
					消息.邀请.邀请人昵称,
				].some((内容) => 内容.toLowerCase().includes(查询词))
				return 分类匹配 && 搜索匹配
			}

			const 会话 = 消息.会话
			const 分类匹配 = 当前分类.value == '全部' || 会话.会话类型 == 当前分类.value
			const 搜索匹配 = !查询词 || [
				会话.会话名称,
				会话.联系人昵称 || '',
				会话.会话说明,
				会话.最近消息 || '',
			].some((内容) => 内容.toLowerCase().includes(查询词))
			return 分类匹配 && 搜索匹配
		})
	})

	function 分类数量(分类: 消息分类): number {
		if (分类 == '全部') return 消息列表.value.length
		return 消息列表.value.filter((消息) => {
			if (分类 == '好友验证') return 消息.类型 == '好友申请'
			if (分类 == '群邀请') return 消息.类型 == '群邀请'
			return 消息.类型 == '会话' && 消息.会话.会话类型 == 分类
		}).length
	}

	async function 加载好友申请() {
		const 用户编号 = 当前用户.value?.用户编号
		const 加载序号 = ++申请加载序号
		if (!用户编号) {
			好友申请列表.value = []
			好友申请错误.value = ''
			好友申请正在加载.value = false
			return
		}

		好友申请正在加载.value = true
		try {
			const 申请 = await 发送请求<好友申请[]>('/my/friend-requests')
			if (加载序号 == 申请加载序号) {
				好友申请列表.value = 申请
				好友申请错误.value = ''
			}
		} catch (原因) {
			if (加载序号 == 申请加载序号) {
				好友申请错误.value = 原因 instanceof Error ? 原因.message : '加载好友申请失败'
			}
		} finally {
			if (加载序号 == 申请加载序号) 好友申请正在加载.value = false
		}
	}

	async function 加载群邀请() {
		const 用户编号 = 当前用户.value?.用户编号
		const 加载序号 = ++邀请加载序号
		if (!用户编号) {
			群邀请列表.value = []
			群邀请错误.value = ''
			群邀请正在加载.value = false
			return
		}

		群邀请正在加载.value = true
		try {
			const 邀请 = await 发送请求<群邀请[]>('/my/group-invitations')
			if (加载序号 == 邀请加载序号) {
				群邀请列表.value = 邀请
				群邀请错误.value = ''
			}
		} catch (原因) {
			if (加载序号 == 邀请加载序号) {
				群邀请错误.value = 原因 instanceof Error ? 原因.message : '加载群邀请失败'
			}
		} finally {
			if (加载序号 == 邀请加载序号) 群邀请正在加载.value = false
		}
	}

	function 刷新消息() {
		if (当前用户.value == null) return
		void 会话状态.刷新会话列表()
		void 加载好友申请()
		void 加载群邀请()
	}

	function 打开会话(事件 : { currentTarget : { dataset : Record<string, unknown> } }) {
		const 会话键 = 事件.currentTarget.dataset['key']
		if (typeof 会话键 != 'string') {
			console.error('消息行缺少会话键，无法打开聊天', 事件.currentTarget.dataset)
			return
		}
		const 消息 = 筛选后消息.value.find((项目) => 项目.键 == 会话键)
		if (消息 == null || 消息.类型 != '会话') {
			console.error('无法根据消息行会话键找到会话', 会话键)
			return
		}
		const 会话 = 消息.会话
		const 路径 = 会话.会话类型 == '好友'
			? `/pages/liaotian/liaotian?friendId=${encodeURIComponent(会话.关联编号)}&nickname=${encodeURIComponent(会话.会话名称)}`
			: 会话.会话类型 == '群聊'
				? `/pages/liaotian/liaotian?groupId=${encodeURIComponent(会话.会话编号)}`
				: `/pages/liaotian/liaotian?taskId=${encodeURIComponent(会话.关联编号)}`
		uni.navigateTo({ url: 路径 })
	}

	async function 处理好友申请(申请 : 好友申请, 操作 : 'accept' | 'reject') {
		if (正在处理申请编号.value) return
		正在处理申请编号.value = 申请.申请编号
		好友申请错误.value = ''
		操作反馈.value = ''
		try {
			await 发送请求(
				`/my/friend-requests/${encodeURIComponent(申请.申请编号)}/${操作}`,
				{ method: 'POST' },
			)
			操作反馈.value = 操作 == 'accept'
				? `已添加 ${申请.昵称} 为好友`
				: '已拒绝好友申请'
			await 加载好友申请()
			if (操作 == 'accept') void 会话状态.刷新会话列表()
		} catch (原因) {
			好友申请错误.value = 原因 instanceof Error ? 原因.message : '处理好友申请失败'
		} finally {
			正在处理申请编号.value = ''
		}
	}

	async function 处理群邀请(邀请 : 群邀请, 操作 : 'accept' | 'reject') {
		if (正在处理邀请编号.value) return
		正在处理邀请编号.value = 邀请.邀请编号
		群邀请错误.value = ''
		操作反馈.value = ''
		try {
			await 发送请求(
				`/group-invitations/${encodeURIComponent(邀请.邀请编号)}/${操作}`,
				{ method: 'POST' },
			)
			操作反馈.value = 操作 == 'accept'
				? `已加入群聊：${邀请.群组名称}`
				: '已拒绝群聊邀请'
			await 加载群邀请()
			if (操作 == 'accept') {
				void 会话状态.刷新会话列表()
				uni.navigateTo({
					url: `/pages/liaotian/liaotian?groupId=${encodeURIComponent(邀请.群组编号)}`,
				})
			}
		} catch (原因) {
			群邀请错误.value = 原因 instanceof Error ? 原因.message : '处理群聊邀请失败'
		} finally {
			正在处理邀请编号.value = ''
		}
	}

	onShow(() => {
		当前用户.value = 读取当前用户()
		会话状态.设置身份(获取令牌(), 当前用户.value?.用户编号 || null)
		会话状态.开始监听实时事件()
		if (当前用户.value != null) {
			void 会话状态.刷新会话列表()
			void 加载好友申请()
			void 加载群邀请()
			if (取消订阅申请 == null) {
				取消订阅申请 = 订阅实时事件((事件) => {
					if (事件.事件类型.startsWith('friend.request_')) void 加载好友申请()
					if (事件.事件类型 == 'group.invitation_created') void 加载群邀请()
				})
			}
		} else {
			void 加载好友申请()
			void 加载群邀请()
		}
	})

	onHide(() => {
		申请加载序号 += 1
		邀请加载序号 += 1
		好友申请正在加载.value = false
		群邀请正在加载.value = false
		取消订阅申请?.()
		取消订阅申请 = null
	})
</script>

<template>
	<view class="ye_mian">
		<view class="ye_mian_biao_ti liang_duan_dui_qi">
			<view>
				<text class="fu_biao_ti">私聊、群聊与委托消息</text>
				<text class="biao_ti">消息</text>
			</view>
			<button v-if="当前用户 != null" class="ci_yao_an_niu" :disabled="正在加载 || 好友申请正在加载 || 群邀请正在加载" @click="刷新消息">
				{{ 正在加载 || 好友申请正在加载 || 群邀请正在加载 ? '同步中…' : '刷新' }}
			</button>
		</view>

		<view v-if="当前用户 == null" class="kong_zhuang_tai">
			<text class="ka_pian_biao_ti">登录后查看消息</text>
			<button class="zhu_yao_an_niu" @click="uni.switchTab({ url: '/pages/wode/wode' })">前往登录</button>
		</view>

		<template v-else>
			<input v-model="搜索词" class="shu_ru_kuang" placeholder="搜索会话或消息" />

			<view class="shaixuan_lan">
				<button v-for="分类 in 分类列表" :key="分类" class="fen_lei_biao_qian" :class="当前分类 == 分类 ? 'fen_lei_biao_qian_xuan_zhong' : ''"
					@click="当前分类 = 分类">
					{{ 分类 }} · {{ 分类数量(分类) }}
				</button>
			</view>

			<view v-if="好友申请错误" class="ti_shi_xin_xi cuo_wu">{{ 好友申请错误 }}</view>
			<view v-if="群邀请错误" class="ti_shi_xin_xi cuo_wu">{{ 群邀请错误 }}</view>
			<view v-if="操作反馈" class="ti_shi_xin_xi cheng_gong">{{ 操作反馈 }}</view>
			<view v-if="加载错误" class="ti_shi_xin_xi cuo_wu">{{ 加载错误 }}</view>

			<view v-if="筛选后消息.length > 0">
				<template v-for="消息 in 筛选后消息" :key="消息.键">
					<view v-if="消息.类型 == '好友申请'" class="ka_pian hao_you_shen_qing_ka_pian">
						<view class="zhan_kai">
							<text class="ka_pian_biao_ti">{{ 消息.申请.昵称 }} 的好友验证</text>
							<text class="fu_zhu_wen_ben">@{{ 消息.申请.登录名 }} · {{ 格式化时间(消息.申请.创建时间) }}</text>
							<text class="zheng_wen">{{ 消息.申请.申请附言 || '请求添加你为好友' }}</text>
						</view>
						<view class="cao_zuo_zu">
							<button class="xiao_hao zhu_yao_an_niu" :disabled="正在处理申请编号 != ''"
								@click="处理好友申请(消息.申请, 'accept')">同意</button>
							<button class="xiao_hao ci_yao_an_niu" :disabled="正在处理申请编号 != ''"
								@click="处理好友申请(消息.申请, 'reject')">拒绝</button>
						</view>
					</view>
					<view v-else-if="消息.类型 == '群邀请'" class="ka_pian hao_you_shen_qing_ka_pian">
						<view class="zhan_kai">
							<text class="ka_pian_biao_ti">{{ 消息.邀请.邀请人昵称 }} 邀请你加入 {{ 消息.邀请.群组名称 }}</text>
							<text class="fu_zhu_wen_ben">{{ 格式化时间(消息.邀请.创建时间) }}</text>
						</view>
						<view class="cao_zuo_zu">
							<button class="xiao_hao zhu_yao_an_niu" :disabled="正在处理邀请编号 != ''"
								@click="处理群邀请(消息.邀请, 'accept')">加入</button>
							<button class="xiao_hao ci_yao_an_niu" :disabled="正在处理邀请编号 != ''"
								@click="处理群邀请(消息.邀请, 'reject')">拒绝</button>
						</view>
					</view>
					<view v-else class="lie_biao_hang ke_dian_ji hui_hua_hang" :data-key="消息.键" @click="打开会话">
						<view class="hui_hua_tou_xiang">
							{{ 消息.会话.会话类型 == '群聊' ? '群' : 消息.会话.会话名称.slice(0, 1) }}
						</view>
						<view class="zhan_kai hui_hua_wen_ben">
							<view class="liang_duan_dui_qi">
								<text class="ka_pian_biao_ti">{{ 消息.会话.会话名称 }}</text>
								<text class="fu_zhu_wen_ben">{{ 格式化时间(消息.会话.最近消息时间) }}</text>
							</view>
							<text class="fu_zhu_wen_ben hui_hua_zhai_yao">
								{{ 消息.会话.最近消息 || (消息.会话.会话类型 == '好友' ? '开始聊天吧' : '暂无消息') }}
							</text>
							<text class="hui_hua_lei_xing">
								{{ 消息.会话.会话类型 }}
								<text v-if="消息.会话.会话类型 == '群聊'"> · {{ 消息.会话.成员数 ?? 0 }} 人</text>
								<text v-else-if="消息.会话.会话类型 == '委托' && 消息.会话.会话状态">
									· {{ 消息.会话.会话状态 }}
								</text>
							</text>
						</view>
						<text class="jian_tou">›</text>
					</view>
				</template>
			</view>

			<view v-else class="kong_zhuang_tai">
				<text class="ka_pian_biao_ti">
					{{ 正在加载 || 好友申请正在加载 || 群邀请正在加载 ? '正在同步消息…' : 搜索词 ? '没有找到匹配的消息' : '还没有消息' }}
				</text>
				<text class="fu_zhu_wen_ben">
					{{ 搜索词 ? '试试其他名称或消息关键词。' : '好友验证、群聊邀请、好友私聊、群聊和委托沟通会显示在这里。' }}
				</text>
			</view>
		</template>
	</view>
</template>

<style lang="scss">
	.fen_lei_biao_qian_xuan_zhong {
		background-color: #087e67;
		color: #ffffff;
	}

	.hao_you_shen_qing_ka_pian {
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
	}

	.hui_hua_hang {
		padding: 10px 4px;
	}

	.hui_hua_tou_xiang {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		min-width: 42px;
		height: 42px;
		margin-right: 12px;
		border-radius: 21px;
		background-color: #e7f4ef;
		color: #087e67;
		font-size: 16px;
		font-weight: 700;
	}

	.hui_hua_wen_ben {
		display: flex;
		flex-direction: column;
	}

	.hui_hua_lei_xing {
		margin-top: 3px;
		color: #087e67;
		font-size: 11px;
	}

	.cheng_gong {
		background-color: #e7f4ef;
		color: #126b56;
	}
</style>