<script setup lang="ts">
	import { onShow } from '@dcloudio/uni-app'
	import { computed, ref } from 'vue'
	import { 读取当前用户 } from '../../common/wangluo'
	import type { 用户 } from '../../common/leixing'
	import { 格式化会话时间 } from './时间'
	import TongYiJueJue from './tongyijuejue.uvue'
	import {
		会话列表,
		会话列表正在加载 as 正在加载,
		会话列表加载错误 as 加载错误,
	} from './会话列表'

	const 当前用户 = ref<用户 | null>(null)

	function 获取会话标题(会话 : (typeof 会话列表.value)[number]) {
		if (会话.会话类型 == "好友验证") return `好友请求 ${会话.会话名称}`
		if (会话.会话类型 == "群邀请") return `群聊邀请 ${会话.会话名称}`
		if (会话.会话类型 == "委托") {
			const 委托状态 = 会话.会话状态 ? ` · ${会话.会话状态}` : ""
			return `委托${委托状态} ${会话.会话名称}`
		}
		return 会话.会话名称
	}

	const 普通会话列表 = computed(() => 会话列表.value.slice()
		.sort((左侧, 右侧) => {
			const 左侧时间 = new Date(左侧.最近消息时间).getTime()
			const 右侧时间 = new Date(右侧.最近消息时间).getTime()
			if (Number.isNaN(左侧时间)) return Number.isNaN(右侧时间) ? 0 : 1
			if (Number.isNaN(右侧时间)) return -1
			return 右侧时间 - 左侧时间
		}))

	function 打开会话(事件 : { currentTarget : { dataset : Record<string, unknown> } }) {
		const 会话键 = 事件.currentTarget.dataset['key']
		if (typeof 会话键 != 'string') return
		const 会话 = 普通会话列表.value.find((项目) =>
			`${项目.会话类型}:${项目.会话编号}` == 会话键,
		)
		if (!会话) return
		const 会话编号 = 会话.会话编号
		const 会话类型 = 会话.会话类型
		const 关联编号 = 会话.关联编号
		const 会话名称 = 会话.会话名称


		console.log('打开会话', 会话类型, 会话编号, 关联编号, 会话名称)
		if (会话类型 == '好友验证' || 会话类型 == '群邀请') return

		if (会话类型 == '好友') {
			uni.navigateTo({
				url: `/pages/liaotian/liaotian?hui_hua=${encodeURIComponent(会话编号)}&ming_cheng=${encodeURIComponent(会话名称)}&lei_xing=好友&bian_hao=${encodeURIComponent(关联编号)}`,
			})
			return
		}

		if (会话类型 == '群聊') {
			uni.navigateTo({
				url: `/pages/liaotian/liaotian?hui_hua=${encodeURIComponent(会话编号)}&ming_cheng=${encodeURIComponent(会话名称)}&lei_xing=群聊&bian_hao=${encodeURIComponent(会话编号)}`,
			})
			return
		}

		if (会话类型 == '委托') {
			const 任务编号 = 会话.任务编号
			if (!任务编号) {
				uni.showToast({ title: '委托编号缺失，无法打开群聊', icon: 'none' })
				return
			}
			uni.navigateTo({
				url: `/pages/liaotian/liaotian?hui_hua=${encodeURIComponent(会话编号)}&ming_cheng=${encodeURIComponent(会话名称)}&lei_xing=委托&bian_hao=${encodeURIComponent(任务编号)}`,
			})
		}
	}

	onShow(() => {
		当前用户.value = 读取当前用户()
	})
</script>

<template>
	<view class="ye_mian">
		<view v-if="当前用户 == null" class="kong_zhuang_tai">
			<text class="ka_pian_biao_ti">登录后查看消息</text>
			<button class="zhu_yao_an_niu" @click="uni.switchTab({ url: '/pages/wode/wode' })">前往登录</button>
		</view>

		<template v-else>
			<view v-if="加载错误" class="ti_shi_xin_xi cuo_wu">{{ 加载错误 }}</view>

			<view v-if="普通会话列表.length > 0">
				<view
					v-for="会话 in 普通会话列表"
					:key="`${会话.会话类型}:${会话.会话编号}`"
					class="lie_biao_hang ke_dian_ji hui_hua_hang"
					:data-key="`${会话.会话类型}:${会话.会话编号}`"
					@click="打开会话"
				>
					<!-- 外层只负责定位，不裁切；圆形裁切只在里面的头像上 -->
					<view class="hui_hua_tou_xiang_kuang">
						<view class="hui_hua_tou_xiang">
							<text class="hui_hua_tou_xiang_zi">{{ 会话.会话类型 == '好友验证' ? '验' : 会话.会话类型 == '群邀请' ? '群' : 会话.会话类型 == '群聊' ? '群' : 会话.会话名称.slice(0, 1) }}</text>
						</view>
						<!-- 未读红点压在头像右上角，允许超出头像范围 -->
						<text
							v-if="(会话.新消息条数 ?? 0) > 0"
							class="wei_du_xin_xi_shu"
						>{{ 会话.新消息条数 > 99 ? '99+' : 会话.新消息条数 }}</text>
					</view>
					<view class="zhan_kai hui_hua_wen_ben">
						<view class="liang_duan_dui_qi">
							<text class="ka_pian_biao_ti">{{ 获取会话标题(会话) }}</text>
							<text class="fu_zhu_wen_ben">{{ 格式化会话时间(会话.最近消息时间) }}</text>
						</view>
						<text class="fu_zhu_wen_ben hui_hua_zhai_yao">
							{{ 会话.最近消息 || (会话.会话类型 == '好友验证' ? '请求添加你为好友' : 会话.会话类型 == '群邀请' ? '邀请你加入群聊' : 会话.会话类型 == '好友' ? '开始聊天吧' : '暂无消息') }}
						</text>
					</view>
					<TongYiJueJue
						v-if="会话.会话类型 == '好友验证' || 会话.会话类型 == '群邀请'"
						:会话="会话"
					/>
				</view>
			</view>

			<view v-else class="kong_zhuang_tai">
				<text class="ka_pian_biao_ti">{{ 正在加载 ? '正在同步会话…' : '还没有会话' }}</text>
			</view>
		</template>
	</view>
</template>

<style lang="scss">
	.hui_hua_hang {
		position: relative;
		height: 72px;
		padding: 10px 4px;
		flex-wrap: nowrap;
		overflow: hidden;
	}

	/* 头像外框：48px 留白盒，42px 头像居中，右上角 6px 余量正好放红点。
	   外框不裁切（overflow: visible），红点又完全落在盒内，任何平台都不会被切 */
	.hui_hua_tou_xiang_kuang {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		min-width: 48px;
		height: 48px;
		margin-right: 6px;
		overflow: visible;
	}

	.hui_hua_tou_xiang {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		height: 42px;
		border-radius: 21px;
		background-color: #e7f4ef;
		color: #087e67;
		font-size: 16px;
		font-weight: 700;
		overflow: hidden;
	}

	.hui_hua_wen_ben {
		display: flex;
		flex-direction: column;
		height: 52px;
		min-width: 0;
		justify-content: center;
	}


	.liang_duan_dui_qi {
		flex-wrap: nowrap;
		width: 100%;
	}

	.ka_pian_biao_ti {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hui_hua_zhai_yao {
		margin-top: 6px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* 未读红点：定位父级是 48px 头像外框，压在 42px 头像右上角并留出外扩余量 */
	.wei_du_xin_xi_shu {
		position: absolute;
		top: 0;
		right: 0;
		min-width: 18px;
		height: 18px;
		padding: 0 5px;
		border-radius: 9px;
		background-color: #f02d2d;
		color: #ffffff;
		font-size: 11px;
		font-weight: 400;
		line-height: 18px;
		text-align: center;
		z-index: 2;
	}
</style>
