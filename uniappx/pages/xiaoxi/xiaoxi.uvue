<script setup lang="ts">
	import { onShow } from '@dcloudio/uni-app'
	import { computed, ref } from 'vue'
	import { 格式化时间, 读取当前用户 } from '../../common/wangluo'
	import type { 用户 } from '../../common/leixing'
	import {
		会话列表,
		会话列表正在加载 as 正在加载,
		会话列表加载错误 as 加载错误,
	} from './会话列表'

	const 当前用户 = ref<用户 | null>(null)

	const 普通会话列表 = computed(() => 会话列表.value.slice()
		.sort((左侧, 右侧) => {
			const 左侧时间 = new Date(左侧.最近消息时间).getTime()
			const 右侧时间 = new Date(右侧.最近消息时间).getTime()
			if (Number.isNaN(左侧时间)) return Number.isNaN(右侧时间) ? 0 : 1
			if (Number.isNaN(右侧时间)) return -1
			return 右侧时间 - 左侧时间
		}))

	function 打开会话(事件 : { currentTarget : { dataset : Record<string, unknown> } }) {
		const 会话键 = 事件.currentTarget.dataset['key']
		if (typeof 会话键 != 'string') return
		const 会话 = 普通会话列表.value.find((项目) =>
			`${项目.会话类型}:${项目.会话编号}` == 会话键,
		)
		if (!会话) return
		const 会话编号 = 会话.会话编号
		const 会话类型 = 会话.会话类型
		const 关联编号 = 会话.关联编号
		const 会话名称 = 会话.会话名称
		if (会话类型 == '好友验证' || 会话类型 == '群邀请') return

		if (会话类型 == '好友') {
			uni.navigateTo({
				url: `/pages/liaotian/liaotian?friendId=${encodeURIComponent(关联编号)}&nickname=${encodeURIComponent(会话名称)}`,
			})
			return
		}

		if (会话类型 == '群聊') {
			uni.navigateTo({
				url: `/pages/liaotian/liaotian?groupId=${encodeURIComponent(会话编号)}`,
			})
			return
		}

		uni.navigateTo({
			url: `/pages/liaotian/liaotian?taskId=${encodeURIComponent(关联编号)}`,
		})
	}

	onShow(() => {
		当前用户.value = 读取当前用户()
	})
</script>

<template>
	<view class="ye_mian">
		<view v-if="当前用户 == null" class="kong_zhuang_tai">
			<text class="ka_pian_biao_ti">登录后查看消息</text>
			<button class="zhu_yao_an_niu" @click="uni.switchTab({ url: '/pages/wode/wode' })">前往登录</button>
		</view>

		<template v-else>
			<view v-if="加载错误" class="ti_shi_xin_xi cuo_wu">{{ 加载错误 }}</view>

			<view v-if="普通会话列表.length > 0">
				<view
					v-for="会话 in 普通会话列表"
					:key="`${会话.会话类型}:${会话.会话编号}`"
					class="lie_biao_hang ke_dian_ji hui_hua_hang"
					:data-key="`${会话.会话类型}:${会话.会话编号}`"
					@click="打开会话"
				>
					<view class="hui_hua_tou_xiang">
						{{ 会话.会话类型 == '好友验证' ? '验' : 会话.会话类型 == '群邀请' ? '群' : 会话.会话类型 == '群聊' ? '群' : 会话.会话名称.slice(0, 1) }}
					</view>
					<view class="zhan_kai hui_hua_wen_ben">
						<view class="liang_duan_dui_qi">
							<text class="ka_pian_biao_ti">{{ 会话.会话名称 }}</text>
							<text class="fu_zhu_wen_ben">{{ 格式化时间(会话.最近消息时间) }}</text>
						</view>
						<text class="fu_zhu_wen_ben hui_hua_zhai_yao">
							{{ 会话.最近消息 || (会话.会话类型 == '好友验证' ? '请求添加你为好友' : 会话.会话类型 == '群邀请' ? '邀请你加入群聊' : 会话.会话类型 == '好友' ? '开始聊天吧' : '暂无消息') }}
						</text>
						<text class="hui_hua_lei_xing">
							{{ 会话.会话类型 }}
							<text v-if="会话.会话类型 == '群聊'"> · {{ 会话.成员数 ?? 0 }} 人</text>
							<text v-else-if="会话.会话类型 == '委托' && 会话.会话状态"> · {{ 会话.会话状态 }}</text>
							<text v-if="(会话.新消息条数 ?? 0) > 0"> · 新消息 {{ 会话.新消息条数 }}</text>
						</text>
					</view>
					<text class="jian_tou">›</text>
				</view>
			</view>

			<view v-else class="kong_zhuang_tai">
				<text class="ka_pian_biao_ti">{{ 正在加载 ? '正在同步会话…' : '还没有会话' }}</text>
			</view>
		</template>
	</view>
</template>

<style lang="scss">
	.hui_hua_hang {
		padding: 10px 4px;
	}

	.hui_hua_tou_xiang {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 42px;
		min-width: 42px;
		height: 42px;
		margin-right: 12px;
		border-radius: 21px;
		background-color: #e7f4ef;
		color: #087e67;
		font-size: 16px;
		font-weight: 700;
	}

	.hui_hua_wen_ben {
		display: flex;
		flex-direction: column;
	}

	.hui_hua_lei_xing {
		margin-top: 3px;
		color: #087e67;
		font-size: 11px;
	}
</style>
