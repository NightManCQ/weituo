	.field { width: 100%; min-height: 42px; margin: 6px 0; padding: 10px 12px; border: 1px solid #e3e9e6; border-radius: 8px; background-color: #ffffff; color: #1b2427; font-size: 14px; }
	.textarea { min-height: 110px; }
	.primary, .secondary { min-height: 38px; margin: 4px 4px 4px 0; padding: 0 14px; border-radius: 8px; font-size: 13px; font-weight: 600; }
