	.secondary { border: 1px solid #c9e0d7; background-color: #ffffff; color: #087e67; }
	.small { min-height: 32px; font-size: 12px; }
	.text-button { margin: 4px 0; border: 0; background-color: transparent; color: #087e67; font-size: 13px; }
	.left { align-self: flex-start; }
	.actions, .row-between, .compose, .list-row, .filters { display: flex; flex-direction: row; align-items: center; flex-wrap: wrap; }
	.row-between { justify-content: space-between; }
	.grow { flex: 1; min-width: 0; }
	.badge, .chip { padding: 5px 9px; border-radius: 14px; background-color: #e7f4ef; color: #087e67; font-size: 12px; }
	.chip { border: 1px solid #c9e0d7; }
	.card-footer { margin-top: 12px; }
