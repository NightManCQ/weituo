	.error { background-color: #fff0ec; color: #a84229; }
	.empty { display: flex; flex-direction: column; align-items: center; padding: 30px 12px; color: #7c8986; text-align: center; }
	.location-box { display: flex; flex-direction: column; margin: 8px 0; padding: 12px; border: 1px solid #e8edeb; border-radius: 9px; }
