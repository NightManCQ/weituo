<script setup>
	import { 连接实时消息 } from './common/实时'
	import { 使用全局变量 } from "./状态/全局.ts"

	// #ifdef APP-ANDROID || APP-HARMONY
	import * as 原生插件 from '@/uni_modules/cq-mqtt'
	let firstBackTime = 0
	// #endif
	onLaunch(() => {
		console.log('App Launch')
		void 连接实时消息()

		// console.log("-----????", MyApiErrorCode);

		uni.getSystemInfo({
			success(结果) {
				使用全局变量.系统信息 = {
					设备类型: 结果.deviceType,
					系统主题: 结果.osTheme,
					系统名: 结果.osName,
					系统版本: 结果.osVersion,
					屏幕宽度: 结果.screenWidth,
					屏幕高度: 结果.screenHeight,
					设备品牌: 结果.brand,
					设备型号: 结果.deviceModel,
					窗口顶高: 结果.statusBarHeight,
					窗口底高: 结果.windowBottom,
					系统语言: 结果.osLanguage,

				}
				console.log("系统信息", 使用全局变量.系统信息, 结果);
			}
		})
	})

	onAppShow(() => {
		console.log('App Show')
	})

	onAppHide(() => {
		console.log('App Hide')
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

