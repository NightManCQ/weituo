<script setup lang="ts">
// 地址列表的一行：只负责展示和上报点击，选中逻辑留在页面里
const 属性 = defineProps({
	编号: { type: String, default: '' },
	名称: { type: String, default: '' },
	说明: { type: String, default: '' },
	距离文本: { type: String, default: '' },
	选中: { type: Boolean, default: false },
})

const 发出 = defineEmits(['选中'])

function 点选() {
	发出('选中', 属性.编号)
}
</script>

<template>
	<view :class="属性.选中 ? 'di_zhi_hang di_zhi_hang_xuan' : 'di_zhi_hang'" @click="点选">
		<view class="hang_zuo">
			<text class="hang_ming">{{ 属性.名称 }}</text>
			<text v-if="属性.说明" class="hang_shuo_ming">{{ 属性.说明 }}</text>
		</view>
		<text class="hang_juli">{{ 属性.距离文本 }}</text>
	</view>
</template>

