/**
 * MQTT UTS 插件接口定义
 */

// QoS 服务质量等级
export type QoS = 0 | 1 | 2

// 日志级别
export enum LogLevel {
  DEBUG = 0,
  INFO = 1,
  WARN = 2,
  ERROR = 3,
  NONE = 4
}

// MQTT 事件类型
export type MQTTEvent = 'connect' | 'reconnect' | 'disconnect' | 'offline' | 'close' | 'error' | 'message' | 'queued' | 'queue_flushed' | 'connection_check'

// 连接质量统计
export type ConnectionQualityStats = {
  totalPublished: number       // 累计成功发送消息数
  totalReceived: number        // 累计成功接收消息数
  totalQueued: number          // 累计进入离线队列消息数
  totalQueueFlushed: number    // 累计从离线队列补发成功数
  totalReconnects: number      // 累计重连次数
  lastConnectedAt: number | null   // 最后一次连接成功时间戳
  lastDisconnectedAt: number | null // 最后一次断开时间戳
  avgReconnectMs: number       // 平均重连耗时 ms（每次从断开到重连成功）
}

// Will 消息配置
export type WillMessage = {
  topic: string
  payload: string
  qos: QoS
  retain: boolean
}

// 连接选项
export type ConnectionOptions = {
  url: string
  clientId: string
  username?: string | null
  password?: string | null
  clean?: boolean
  connectTimeout?: number
  keepalive?: number
  reconnect?: boolean
  reconnectPeriod?: number
  maxReconnectAttempts?: number
  ssl?: boolean
  certPath?: string | null
  allowUntrusted?: boolean
  will?: WillMessage | null
}

// 发布选项
export type PublishOptions = {
  qos?: QoS
  retain?: boolean
}

// 错误信息
export type ErrorInfo = {
  code: number
  message: string
  type: 'connection' | 'authentication' | 'network' | 'protocol' | 'unknown'
  timestamp: number
  details?: any | null
}

// 事件数据
export type EventData = {
  sessionPresent?: boolean
  error?: string | ErrorInfo
  topic?: string
  payload?: string | ArrayBuffer
  payloadBytes?: ArrayBuffer   // 原始二进制 payload
  qos?: QoS
  retain?: boolean
  attempt?: number
  reconnectAttempts?: number
  queuedCount?: number         // queued 事件：当前队列消息数
  flushedCount?: number        // queue_flushed 事件：本次补发成功数
  isAlive?: boolean            // connection_check 事件：检测结果
}

// 事件回调函数类型
export type EventCallback = (data: EventData) => void

// 连接状态
export type ConnectionState = {
  status: 'disconnected' | 'connecting' | 'connected' | 'reconnecting' | 'disconnecting'
  connectedAt?: number | null
  lastError?: ErrorInfo | null
  reconnectAttempts: number
  sessionPresent: boolean
}
