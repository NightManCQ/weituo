/**
 * 消息处理器
 * 负责消息队列和批量处理
 * 说明：消息字段统一使用中文命名（主题 / 载荷 / 服务质量 / 保留 / 时间戳），
 *       与 app-android / app-ios 外层的 消息项.主题 等访问保持一致
 */

import { 服务质量等级 } from '../interface.uts'

/**
 * 待发送消息
 */
export type PendingMessage = {
  编号: string
  主题: string
  载荷: string | ArrayBuffer
  服务质量: 服务质量等级
  保留: boolean
  时间戳: number
  重试次数: number
}

/**
 * 接收到的消息
 */
export type ReceivedMessage = {
  主题: string
  载荷: string | ArrayBuffer
  服务质量: 服务质量等级
  保留: boolean
  时间戳: number
}

/**
 * 消息处理器类
 */
export class MessageHandler {
  private messageQueue: PendingMessage[] = []
  private receivedQueue: ReceivedMessage[] = []
  private maxQueueSize: number = 1000
  private messageIdCounter: number = 0
  // 统计计数器
  private totalQueued: number = 0
  private totalFlushed: number = 0

  /**
   * 生成消息编号
   */
  private generateMessageId(): string {
    this.messageIdCounter++
    return 'msg_' + this.messageIdCounter + '_' + Date.now()
  }

  /**
   * 将消息加入发送队列
   */
  queueMessage(
    主题: string,
    载荷: string | ArrayBuffer,
    服务质量: 服务质量等级,
    保留: boolean
  ): PendingMessage {
    const message: PendingMessage = {
      编号: this.generateMessageId(),
      主题: 主题,
      载荷: 载荷,
      服务质量: 服务质量,
      保留: 保留,
      时间戳: Date.now(),
      重试次数: 0
    }

    // 检查队列大小限制
    if (this.messageQueue.length >= this.maxQueueSize) {
      // 移除最旧的消息
      this.messageQueue.shift()
    }

    this.messageQueue.push(message)
    this.totalQueued++
    return message
  }

  /**
   * 获取累计入队消息数
   */
  getTotalQueued(): number {
    return this.totalQueued
  }

  /**
   * 获取累计补发成功消息数
   */
  getTotalFlushed(): number {
    return this.totalFlushed
  }

  /**
   * 增加补发成功计数
   */
  incrementFlushed(count: number): void {
    this.totalFlushed += count
  }

  /**
   * 从队列中移除消息
   */
  removeMessage(messageId: string): void {
    const index = this.messageQueue.findIndex((msg) => msg.编号 === messageId)
    if (index > -1) {
      this.messageQueue.splice(index, 1)
    }
  }

  /**
   * 获取待发送消息队列
   */
  getPendingMessages(): PendingMessage[] {
    return this.messageQueue
  }

  /**
   * 清空发送队列
   */
  clearPendingMessages(): void {
    this.messageQueue = []
  }

  /**
   * 处理接收到的消息
   */
  handleIncomingMessage(
    主题: string,
    载荷: string | ArrayBuffer,
    服务质量: 服务质量等级,
    保留: boolean
  ): ReceivedMessage {
    const message: ReceivedMessage = {
      主题: 主题,
      载荷: 载荷,
      服务质量: 服务质量,
      保留: 保留,
      时间戳: Date.now()
    }

    // 检查队列大小限制
    if (this.receivedQueue.length >= this.maxQueueSize) {
      // 移除最旧的消息
      this.receivedQueue.shift()
    }

    this.receivedQueue.push(message)
    return message
  }

  /**
   * 获取接收消息队列
   */
  getReceivedMessages(): ReceivedMessage[] {
    return this.receivedQueue
  }

  /**
   * 清空接收队列
   */
  clearReceivedMessages(): void {
    this.receivedQueue = []
  }

  /**
   * 设置最大队列大小
   */
  setMaxQueueSize(size: number): void {
    this.maxQueueSize = size
  }

  /**
   * 获取队列统计信息
   */
  getQueueStats(): UTSJSONObject {
    return {
      pendingCount: this.messageQueue.length,
      receivedCount: this.receivedQueue.length,
      maxQueueSize: this.maxQueueSize,
      totalQueued: this.totalQueued,
      totalFlushed: this.totalFlushed
    }
  }
}
