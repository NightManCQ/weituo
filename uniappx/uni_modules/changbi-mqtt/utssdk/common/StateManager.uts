/**
 * 连接状态管理器
 * 管理 MQTT 连接的状态转换和查询
 * 说明：状态字段统一使用中文命名，与 interface.uts 的 连接状态 及 app-android / app-ios 外层访问保持一致。
 */

/**
 * 连接状态枚举
 */
export enum ConnectionStatus {
  DISCONNECTED = 'disconnected',
  CONNECTING = 'connecting',
  CONNECTED = 'connected',
  RECONNECTING = 'reconnecting',
  DISCONNECTING = 'disconnecting'
}

/**
 * 连接状态类型
 */
export type 连接状态 = {
  状态: ConnectionStatus
  连接时间: number | null
  最后错误: string | null
  重连次数: number
  会话存在: boolean
}

/**
 * 状态管理器类
 */
export class StateManager {
  private state: 连接状态 = {
    状态: ConnectionStatus.DISCONNECTED,
    连接时间: null,
    最后错误: null,
    重连次数: 0,
    会话存在: false
  } as 连接状态

  private stateChangeCallback: ((state: 连接状态) => void) | null = null

  /**
   * 设置状态变化回调
   */
  setStateChangeCallback(callback: (state: 连接状态) => void): void {
    this.stateChangeCallback = callback
  }

  /**
   * 获取当前连接状态
   */
  get连接状态(): 连接状态 {
    return { ...this.state } as 连接状态
  }

  /**
   * 检查是否已连接
   */
  isConnected(): boolean {
    return this.state.状态 === ConnectionStatus.CONNECTED
  }

  /**
   * 检查是否正在连接
   */
  isConnecting(): boolean {
    return this.state.状态 === ConnectionStatus.CONNECTING ||
           this.state.状态 === ConnectionStatus.RECONNECTING
  }

  /**
   * 检查是否正在断开
   */
  isDisconnecting(): boolean {
    return this.state.状态 === ConnectionStatus.DISCONNECTING
  }

  /**
   * 设置为连接中状态
   */
  setConnecting(): void {
    const updates = {
      '状态': ConnectionStatus.CONNECTING,
      '最后错误': null
    }
    this.updateState(updates)
  }

  /**
   * 设置为已连接状态
   */
  setConnected(sessionPresent: boolean = false): void {
    const updates = {
      '状态': ConnectionStatus.CONNECTED,
      '连接时间': Date.now(),
      '最后错误': null,
      '重连次数': 0,
      '会话存在': sessionPresent
    }
    this.updateState(updates)
  }

  /**
   * 设置为重连中状态
   */
  setReconnecting(attempts: number): void {
    const updates = {
      '状态': ConnectionStatus.RECONNECTING,
      '重连次数': attempts
    }
    this.updateState(updates)
  }

  /**
   * 设置为断开中状态
   */
  setDisconnecting(): void {
    const updates = {
      '状态': ConnectionStatus.DISCONNECTING
    }
    this.updateState(updates)
  }

  /**
   * 设置为已断开状态
   */
  setDisconnected(error: string | null = null): void {
    const updates = {
      '状态': ConnectionStatus.DISCONNECTED,
      '连接时间': null,
      '最后错误': error,
      '会话存在': false
    }
    this.updateState(updates)
  }

  /**
   * 记录错误
   */
  setError(error: string): void {
    const updates = {
      '最后错误': error
    }
    this.updateState(updates)
  }

  /**
   * 增加重连次数
   */
  incrementReconnectAttempts(): number {
    const attempts = this.state.重连次数 + 1
    const updates = {
      '重连次数': attempts
    }
    this.updateState(updates)
    return attempts
  }

  /**
   * 重置重连次数
   */
  resetReconnectAttempts(): void {
    const updates = {
      '重连次数': 0
    }
    this.updateState(updates)
  }

  /**
   * 重置状态
   */
  reset(): void {
    this.state = {
      状态: ConnectionStatus.DISCONNECTED,
      连接时间: null,
      最后错误: null,
      重连次数: 0,
      会话存在: false
    } as 连接状态
    this.notifyStateChange()
  }

  /**
   * 更新状态
   * 用 hasOwnProperty 区分"字段未传"和"字段值为 null"，
   * 这样 setDisconnected() 传入 连接时间: null 才能真正把字段清空。
   */
  private updateState(updates: UTSJSONObject): void {
    // 状态：null 无意义，仍然跳过
    if (updates.hasOwnProperty('状态') && updates['状态'] !== null) {
      this.state.状态 = updates['状态'] as ConnectionStatus
    }

    // 连接时间：只要传了这个 key 就更新（允许写入 null 以清空）
    if (updates.hasOwnProperty('连接时间')) {
      this.state.连接时间 = updates['连接时间'] as number | null
    }

    // 最后错误：允许写入 null 以清空错误信息
    if (updates.hasOwnProperty('最后错误')) {
      this.state.最后错误 = updates['最后错误'] as string | null
    }

    // 重连次数：null 无意义，跳过
    if (updates.hasOwnProperty('重连次数') && updates['重连次数'] !== null) {
      this.state.重连次数 = updates['重连次数'] as number
    }

    // 会话存在：null 无意义，跳过
    if (updates.hasOwnProperty('会话存在') && updates['会话存在'] !== null) {
      this.state.会话存在 = updates['会话存在'] as boolean
    }

    this.notifyStateChange()
  }

  /**
   * 通知状态变化
   */
  private notifyStateChange(): void {
    if (this.stateChangeCallback !== null) {
      this.stateChangeCallback(this.get连接状态())
    }
  }
}
