/**
 * cq-mqtt 插件 · 前端 SQLite 引擎 · 类型定义
 *
 * 本文件只声明类型，供 app-android 实现与业务层共享，不含任何平台相关代码。
 * Android 实现见 utssdk/app-android/index.uts 与 utssdk/app-android/sqlite.uts
 *
 * 设计取舍：
 * 1. 通用引擎：只提供「连接管理 + 执行 SQL + 查询 + 事务 + 键值表」，
 *    业务表怎么建、怎么迁移交给调用方，插件不预设任何表结构；
 * 2. 同步优先：SQLite 是本机文件操作，单条语句通常在毫秒级，
 *    同步接口直接返回结果，调用方不必层层回调；
 * 3. 异步兜底：批量写、VACUUM、大量查询等重活用异步版本，
 *    任务投递到 io 线程执行，回调统一切回 main 线程；
 * 4. 线程安全：同一个SQLiteDatabase实例内部已做串行化，
 *    同步与异步可以混用，插件另用 Map 保证「一句打开语句执行一次」。
 */

/**
 * 单元格取值
 * 写入可接受：string / number / boolean / null（boolean 落库为 0 或 1）
 * 读出为：null / number（INTEGER、REAL）/ string（TEXT，BLOB 转成 Base64 文本）
 */
export type SQLite值 = any

/**
 * 一行数据：列名 -> 值
 * 取值示例：行.get('消息正文')
 */
export type SQLite数据行 = Map<string, SQLite值>

/**
 * 一条 SQL 语句
 * 使用 ? 占位符绑定参数，避免手工拼串导致注入与转义问题
 */
export type SQL语句 = {
	SQL : string
	参数? : Array<SQLite值> | null
}

/**
 * 打开数据库参数
 * 数据库名：文件名，例如 'app.db'、'聊天.db'
 * 版本：传入大于 0 的值时，打开后会自动同步到 PRAGMA user_version
 * 路径：为空时使用应用私有目录 /data/data/包名/databases/数据库名
 * 预写日志：默认开启 WAL，读写不互相阻塞
 * 外键约束：默认开启，删除更新时自动级联
 */
export type 打开数据库参数 = {
	数据库名 : string
	版本? : number | null
	路径? : string | null
	只读? : boolean
	预写日志? : boolean
	外键约束? : boolean
}

/** 打开结果 */
export type 打开数据库结果 = {
	数据库名 : string
	文件路径 : string
	版本 : number
	是否新建 : boolean
}

/** 单条写操作结果 */
export type 执行结果 = {
	受影响行数 : number
	最后插入编号 : number
}

/** 批量写操作结果 */
export type 批量执行结果 = {
	受影响行数 : number
	最后插入编号 : number
	语句数 : number
}

/** 查询结果 */
export type 查询结果 = {
	列名 : Array<string>
	行集合 : Array<SQLite数据行>
	行数 : number
}

/** 关闭结果 */
export type 关闭结果 = {
	数据库名 : string
	已关闭 : boolean
}

/** 通用操作结果 */
export type 操作结果 = {
	数据库名 : string
	是否成功 : boolean
}

/** 版本号结果 */
export type 版本结果 = {
	数据库名 : string
	版本 : number
}

/** 键值读取结果 */
export type 键值结果 = {
	键 : string
	值 : string | null
	是否存在 : boolean
}

/** 键列表结果 */
export type 键列表结果 = {
	键集合 : Array<string>
	总数 : number
}

/** 数据库列表结果 */
export type 数据库列表结果 = {
	列表 : Array<string>
	总数 : number
}

/** 键值写入参数 */
export type 存键值参数 = {
	数据库名 : string
	键 : string
	值 : string | null
}

/** 键值读取参数 */
export type 取键值参数 = {
	数据库名 : string
	键 : string
}

/** 版本号写入参数 */
export type 设版本参数 = {
	数据库名 : string
	版本 : number
}

/** 批量执行参数 */
export type 批量执行参数 = {
	数据库名 : string
	语句集合 : Array<SQL语句>
	使用事务? : boolean
}

/** 单条执行参数 */
export type 执行SQL参数 = {
	数据库名 : string
	SQL : string
	参数? : Array<SQLite值> | null
}

/** 查询参数 */
export type 查询SQL参数 = {
	数据库名 : string
	SQL : string
	参数? : Array<SQLite值> | null
}

/**
 * 错误码
 * 同步接口以异常形式抛出（message 形如 [9010002]数据库未打开），
 * 业务层可用 解析SQLite错误() 还原成结构化对象
 */
export type SQLite错误码 =
	9010001 | 9010002 | 9010003 | 9010004 | 9010005 | 9010006 | 9010007 |
	9010008 | 9010009 | 9010010 | 9010011 | 9010012 | 9010013 | 9010099

/** 失败对象，符合 uni 错误规范 */
export interface SQLite失败 extends IUniError {
	errCode : SQLite错误码
}

/** 异步回调容器：成功、失败、完成 */
export type 打开数据库异步参数 = {
	数据库名 : string
	版本? : number | null
	路径? : string | null
	只读? : boolean
	预写日志? : boolean
	外键约束? : boolean
	success? : (结果 : 打开数据库结果) => void
	fail? : (错误 : SQLite失败) => void
	complete? : (任意 : any) => void
}

export type 执行SQL异步参数 = {
	数据库名 : string
	SQL : string
	参数? : Array<SQLite值> | null
	success? : (结果 : 执行结果) => void
	fail? : (错误 : SQLite失败) => void
	complete? : (任意 : any) => void
}

export type 批量执行异步参数 = {
	数据库名 : string
	语句集合 : Array<SQL语句>
	使用事务? : boolean
	success? : (结果 : 批量执行结果) => void
	fail? : (错误 : SQLite失败) => void
	complete? : (任意 : any) => void
}

export type 查询SQL异步参数 = {
	数据库名 : string
	SQL : string
	参数? : Array<SQLite值> | null
	success? : (结果 : 查询结果) => void
	fail? : (错误 : SQLite失败) => void
	complete? : (任意 : any) => void
}

export type 存键值异步参数 = {
	数据库名 : string
	键 : string
	值 : string | null
	success? : (结果 : 操作结果) => void
	fail? : (错误 : SQLite失败) => void
	complete? : (任意 : any) => void
}

export type 取键值异步参数 = {
	数据库名 : string
	键 : string
	success? : (结果 : 键值结果) => void
	fail? : (错误 : SQLite失败) => void
	complete? : (任意 : any) => void
}

/** 单库操作的异步参数（关闭、删除、整理、写回日志） */
export type 单库异步参数 = {
	数据库名 : string
	success? : (结果 : 操作结果) => void
	fail? : (错误 : SQLite失败) => void
	complete? : (任意 : any) => void
}

/** 单库同步参数 */
export type 单库参数 = {
	数据库名 : string
}
