export function 打开数据库(参数 : 打开数据库参数) : 打开数据库结果 {
	return 打开联合版核心(参数)
}

export function 打开数据库异步(参数 : 打开并初始化参数) : void {
	异步执行({
		任务: function() : any {
			return 打开联合版核心(参数)
		},
		成功回调: 参数.success ?? null,
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

export function 打开并初始化(参数 : 打开并初始化参数) : 打开数据库结果 {
