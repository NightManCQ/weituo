}

export function 关闭数据库异步(参数 : 关闭回调参数) : void {
	异步执行({
		任务: function() : any {
			关闭核心(参数.数据库名)
			return null
		},
		成功回调: 参数.success ?? null,
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

