/* ============================================================
 * 版本 / 维护
 * ============================================================ */

/** 取 PRAGMA user_version，业务层据此做表结构升级 */
export function 取得用户版本号(数据库名 : string) : number {
	return 取版本(数据库名)
}

/** 设置 PRAGMA user_version */
export function 设置用户版本号(参数 : 设版本参数) : void {
	设版本(参数)
}

/** 整理数据库文件碎片，不能在事务中调用 */
export function 重组数据库(数据库名 : string) : void {
	重组(数据库名)
}

/** 整理数据库文件碎片（异步） */
export function 重组数据库异步(参数 : 单库异步参数) : void {
	const 数据库名 = 参数.数据库名
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			重组(数据库名)
			const 结果 = { 数据库名: 数据库名, 是否成功: true }
			return 结果 as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 操作结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 把 WAL 日志写回主库文件并截断 */
export function 写回预写日志(数据库名 : string) : void {
	写回日志(数据库名)
}

/** 按错误码取错误说明文案 */
export function 取得SQLite错误说明(错误码 : number) : string {
	return 取得错误说明(错误码)
}
