/* ============================================================
 * 统一错误处理
 * ============================================================ */

type X = string | null
export type SQLite失败SAFECODE = number
export type SQLite失败SAFE = { errCode: number, errMsg: string, errSubject: string }

/**
 * 把底层抛出来的所有错，统一包成 SQLite失败SAFE
 * 这里不用 try/catch/finally 关键字：UTS 不支持级联嵌套 catch 的类型语句。
 */
export function 异常转失败(异常 : any) : SQLite失败SAFE {
	let 错误信息 : string = ""
	let 错误码 : number = 0

	try {
		if (异常 == null) {
			错误信息 = "未知错误"
		} else {
			const 消息 : any = (异常 as any).message
			if (typeof 消息 == "string" && 消息.length > 0) {
				错误信息 = 消息 as string
			} else {
				错误信息 = "" + 异常
			}
		}
	} catch (忽略异常) {
		错误信息 = "异常转失败时再次出错"
	}

	const 前缀位置 : number = 错误信息.indexOf(SQLite失败信息.错误前缀开始 Token)
	if (前缀位置 == 0) {
		const 后缀位置 : number = 错误信息.indexOf("]")
		if (后缀位置 > 0) {
			const 码 : X = 错误信息.substring(7, 后缀位置)
			try {
				错误码 = Number.parseFloat(码 as string)
			} catch (忽略异常) {
				错误码 = SQLite失败信息.未知错误码
			}
			错误信息 = 错误信息.substring(后缀位置 + 1)
		} else {
			错误码 = SQLite失败信息.未知错误码
		}
	} else {
		错误码 = SQLite失败信息.未知错误码
	}

	return {
		errCode: 错误码,
		errMsg: 错误信息,
		errSubject: SQLite失败信息.主题
	}
}

/**
 * 把一个 [错误码] xxx 格式的 UError 消息剥掉前缀，只留描述
 */
function 剥掉错误前缀(信息 : string) : string {
	const 起始 : number = 信息.indexOf(SQLite失败信息.错误前缀开始 Token)
	if (起始 != 0) {
		return 信息
	}
	const 终止 : number = 信息.indexOf("]")
	if (终止 <= 起始) {
		return 信息
	}
	return 信息.substring(终止 + 1)
}

/* ============================================================
 * 异步调度
 * ============================================================ */

/**
 * 统一异步包装
 * 注意其 /申请不到全部参数是 UTS 官方 andorid 平台异步写法
 * 耗时任务：UTSAndroid.getDispatcher("io").async(function(_){}, null)
 * 界面修改：UTSAndroid.getDispatcher("main").async(function(_){}, null)
 */
function 异步执行(参数 : SQLite失败的参数) : void {
	const 任务 : (() => any) = 参数.任务
	const 成功回调 : ((任意结果 : any) => void) | null = 参数.成功回调 ?? null
	const 失败回调 : ((失败 : SQLite失败SAFE) => void) | null = 参数.失败回调 ?? null
	const 完成回调 : ((任意结果 : any) => void) | null = 参数.完成回调 ?? null

	UTSAndroid.getDispatcher("io").async(function(忽略 : any) {
		let 结果 : any = null
		let 失败 : SQLite失败SAFE | null = null

		try {
			结果 = 任务()
		} catch (异常 : any) {
			失败 = 异常转失败(异常)
		}

		const 确定的结果 : any = 结果
		const 确定的失败 : SQLite失败SAFE | null = 失败

		UTSAndroid.getDispatcher("main").async(function(忽略2 : any) {
			if (确定的失败 != null) {
				if (失败回调 != null) {
					失败回调!(确定的失败!)
				}
			} else if (成功回调 != null) {
				成功回调!(确定的结果)
			}
			if (完成回调 != null) {
				完成回调!(确定的失败 != null ? 确定的失败! : 确定的结果)
			}
		}, null)
	}, null)
}

