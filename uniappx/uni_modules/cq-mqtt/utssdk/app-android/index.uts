export function 查询SQL返回组(参数 : 打开打开SQLite查询SQL参数) : SQLite原始数据 {
	return 执行查询SQL返回组 WITH 选项的核心(参数)
}

export function 查询单行(参数 : 打开打开SQLite查询SQL参数) : SQLite原始数据 | null {
	const 行组 : SQLite原始数据 = 执行查询SQL返回组 WITH 选项的核心(参数)
	const 行数组 : any[] = 行组.数据
	if (行数组.length == 0) {
		return null
	}
	return 行数组[0] as SQLite原始数据
}

export function 查询单值(参数 : 打开打开SQLite查询SQL参数) : SQLite单一的值 | null {
	const 行组 : SQLite原始数据 = 执行查询SQL返回组 WITH 选项的核心(参数)
	const 行数组 : any[] = 行组.数据
	if (行数组.length == 0) {
		return null
	}
	const 首行 : any = 行数组[0]
	const 键组 : string[] = (首行 as SQLite原始数据).键
	if (键组.length == 0) {
		return null
	}
	return (首行 as SQLite原始数据).取(键组[0])
}

export function 查询数量(参数 : 打开打开SQLite count的参数) : number {
	return count核心(参数)
}

