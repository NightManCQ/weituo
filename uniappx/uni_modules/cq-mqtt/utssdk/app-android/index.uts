/**
 * cq-mqtt 插件 · 前端 SQLite 引擎 · 对外 API 层
 * 平台：Android（uts -> kotlin）
 *
 * 这一层只做三件事：
 * 1. 把 sqlite.uts 的原生能力包成业务层能直接调用的中文函数；
 * 2. 统一错误处理：同步接口抛 Error（业务层 try/catch），
 *    异步接口回调 SQLite失败（errCode / errMsg / errSubject）；
 * 3. 耗时操作提供异步版本：任务投递到 io 线程，回调统一切回 main 线程。
 *
 * 线程说明（参考 uni-app x 官方 UTSAndroid 文档）：
 *   耗时任务 UTSAndroid.getDispatcher("io").async(function(_){ ... }, null)
 *   界面修改 UTSAndroid.getDispatcher("main").async(function(_){ ... }, null)
 */

import { UTSAndroid } from 'io.dcloud.uts'

import {
	SQLite值,
	SQLite数据行,
	SQL语句,
	打开数据库参数,
	打开数据库结果,
	单库参数,
	执行SQL参数,
	批量执行参数,
	查询SQL参数,
	建表参数,
	建索引参数,
	删索引参数,
	表参数,
	列参数,
	存键值参数,
	取键值参数,
	设版本参数,
	执行结果,
	批量执行结果,
	查询结果,
	操作结果,
	SQLite失败,
	打开数据库异步参数,
	执行SQL异步参数,
	批量执行异步参数,
	查询SQL异步参数,
	事务异步参数,
	单库异步参数
} from '../interface.uts'
import { SQLite错误主题, SQLite未知错误码, SQLite错误前缀开始, 取得错误说明 } from '../unierror.uts'
import {
	打开,
	关闭,
	关闭全部,
	删除,
	文件是否存在,
	是否已打开,
	取得路径,
	已打开列表,
	执行,
	批量执行,
	查询,
	查询单值,
	查询数量,
	开始事务,
	提交事务核心,
	回滚事务核心,
	是否在事务中核心,
	执行事务,
	建表,
	表是否存在核心,
	删表,
	清空表核心,
	列是否存在核心,
	建索引,
	删索引,
	存键值,
	读键值,
	删键值,
	清空键值核心,
	列出键核心,
	取版本,
	设版本,
	重组,
	写回日志
} from './sqlite.uts'

/* ============================================================
 * 统一错误处理
 * ============================================================ */

/**
 * 把底层抛出的任意异常，解析成结构化的 SQLite失败
 *
 * 注意两点：
 * 1. 入参是 any，Kotlin 侧是 Any?，不能取 .message（Any 没有这个属性），
 *    因此统一用字符串拼接拿到异常文本，再从里面摘 [错误码] 前缀；
 * 2. UTS 的 throw new Error() 编译成 throw UTSError()，
 *    文本形如 io.dcloud.uts.UTSError: [9010002]数据库 xxx 尚未打开，
 *    所以这里按「任意位置的 [」来定位，而不是要求必须在开头。
 */
export function 解析SQLite异常(异常 : any) : SQLite失败 {
	let 错误信息 = ''
	let 错误码 = SQLite未知错误码

	try {
		if (异常 == null) {
			错误信息 = '未知错误'
		} else {
			错误信息 = '' + 异常
		}
	} catch (忽略异常) {
		错误信息 = '解析异常时再次出错'
	}

	const 前缀位置 = 错误信息.indexOf(SQLite错误前缀开始)
	if (前缀位置 >= 0) {
		const 后半 = 错误信息.substring(前缀位置)
		const 后缀位置 = 后半.indexOf(']')
		if (后缀位置 > 0) {
			const 码文本 = 后半.substring(1, 后缀位置)
			const 解析结果 = Number.parseFloat(码文本)
			if (解析结果 != 解析结果) {
				错误码 = SQLite未知错误码
			} else {
				错误码 = 解析结果
			}
			错误信息 = 后半.substring(后缀位置 + 1)
		}
	}

	if (错误信息.length == 0) {
		错误信息 = 取得错误说明(错误码)
	}

	const 失败 : SQLite失败 = {
		errCode: 错误码,
		errMsg: 错误信息,
		errSubject: SQLite错误主题
	}
	return 失败
}

/** 异步包装的内部参数 */
type 异步回调包 = {
	任务 : (() => any)
	成功回调 : ((任意结果 : any | null) => void) | null
	失败回调 : ((失败 : SQLite失败) => void) | null
	完成回调 : ((任意结果 : any | null) => void) | null
}

/**
 * 统一异步包装：io 线程干活，main 线程回调
 * 返回值的具体类型由各 api 自己保证，这里统一按 any 传递
 */
function 异步执行(包 : 异步回调包) : void {
	const 任务 = 包.任务
	const 成功回调 = 包.成功回调
	const 失败回调 = 包.失败回调
	const 完成回调 = 包.完成回调

	UTSAndroid.getDispatcher('io').async(function(_ : any | null) {
		let 结果 : any | null = null
		let 失败 : SQLite失败 | null = null

		try {
			结果 = 任务()
		} catch (异常) {
			失败 = 解析SQLite异常(异常)
		}

		const 确定的结果 : any | null = 结果
		const 确定的失败 : SQLite失败 | null = 失败

		UTSAndroid.getDispatcher('main').async(function(_ : any | null) {
			if (确定的失败 != null) {
				if (失败回调 != null) {
					失败回调!(确定的失败!)
				}
			} else {
				if (成功回调 != null) {
					成功回调!(确定的结果)
				}
			}
			if (完成回调 != null) {
				if (确定的失败 != null) {
					完成回调!(确定的失败!)
				} else {
					完成回调!(确定的结果)
				}
			}
		}, null)
	}, null)
}

/* ============================================================
 * 打开 / 关闭 / 删除
 * ============================================================ */

/**
 * 打开数据库
 * 同名库只打开一次，重复调用直接返回已有连接的结果
 * 失败时抛出 Error，业务层用 try/catch 捕获
 */
export function 打开数据库(参数 : 打开数据库参数) : 打开数据库结果 {
	return 打开(参数)
}

/** 打开数据库（异步）：在 io 线程打开，回调回 main 线程 */
export function 打开数据库异步(参数 : 打开数据库异步参数) : void {
	const 入参 : 打开数据库参数 = {
		数据库名: 参数.数据库名,
		版本: 参数.版本 ?? null,
		路径: 参数.路径 ?? null,
		只读: 参数.只读 ?? false,
		预写日志: 参数.预写日志 ?? true,
		外键约束: 参数.外键约束 ?? true
	}
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			return 打开(入参) as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 打开数据库结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 关闭数据库，未打开时直接返回 */
export function 关闭数据库(数据库名 : string) : void {
	关闭(数据库名)
}

/** 关闭数据库（异步） */
export function 关闭数据库异步(参数 : 单库异步参数) : void {
	const 数据库名 = 参数.数据库名
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			关闭(数据库名)
			const 结果 = { 数据库名: 数据库名, 是否成功: true }
			return 结果 as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 操作结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 关闭全部已打开的数据库，返回关闭数量 */
export function 关闭全部数据库() : number {
	return 关闭全部()
}

/** 删除数据库文件，已打开的会先关闭 */
export function 删除数据库(数据库名 : string) : void {
	删除(数据库名)
}

/** 删除数据库（异步） */
export function 删除数据库异步(参数 : 单库异步参数) : void {
	const 数据库名 = 参数.数据库名
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			删除(数据库名)
			const 结果 = { 数据库名: 数据库名, 是否成功: true }
			return 结果 as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 操作结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 数据库是否已打开 */
export function 数据库是否已打开(数据库名 : string) : boolean {
	return 是否已打开(数据库名)
}

/** 数据库文件是否存在于磁盘 */
export function 数据库文件是否存在(数据库名 : string) : boolean {
	return 文件是否存在(数据库名)
}

/** 取数据库文件的绝对路径 */
export function 取得数据库文件路径(数据库名 : string) : string {
	return 取得路径(数据库名)
}

/** 取当前已打开的数据库名列表 */
export function 取得已打开数据库名列表() : Array<string> {
	return 已打开列表()
}

/* ============================================================
 * 执行 / 查询
 * ============================================================ */

/** 执行一条写 SQL（INSERT / UPDATE / DELETE / DDL） */
export function 执行SQL(参数 : 执行SQL参数) : 执行结果 {
	return 执行(参数)
}

/** 执行一条写 SQL（异步） */
export function 执行SQL异步(参数 : 执行SQL异步参数) : void {
	const 入参 : 执行SQL参数 = {
		数据库名: 参数.数据库名,
		SQL: 参数.SQL,
		参数: 参数.参数 ?? null
	}
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			return 执行(入参) as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 执行结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 依次执行多条 SQL，不在事务中时自动包一层事务 */
export function 批量执行SQL(参数 : 批量执行参数) : 批量执行结果 {
	return 批量执行(参数)
}

/** 批量执行 SQL（异步） */
export function 批量执行SQL异步(参数 : 批量执行异步参数) : void {
	const 入参 : 批量执行参数 = {
		数据库名: 参数.数据库名,
		语句集合: 参数.语句集合
	}
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			return 批量执行(入参) as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 批量执行结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 执行查询，返回列名与数据行 */
export function 查询SQL(参数 : 查询SQL参数) : 查询结果 {
	return 查询(参数)
}

/** 执行查询（异步） */
export function 查询SQL异步(参数 : 查询SQL异步参数) : void {
	const 入参 : 查询SQL参数 = {
		数据库名: 参数.数据库名,
		SQL: 参数.SQL,
		参数: 参数.参数 ?? null
	}
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			return 查询(入参) as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 查询结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 执行查询，只取第一行；没有结果返回 null */
export function 查询单行(参数 : 查询SQL参数) : SQLite数据行 | null {
	const 结果 = 查询(参数)
	if (结果.行数 == 0) {
		return null
	}
	return 结果.行集合[0]
}

/** 执行查询，只取第一行第一列 */
export function 查询单个值(参数 : 查询SQL参数) : SQLite值 {
	return 查询单值(参数)
}

/** 执行 COUNT 类查询，返回数字 */
export function 查询记录数(参数 : 查询SQL参数) : number {
	return 查询数量(参数)
}

/* ============================================================
 * 事务
 * ============================================================ */

/** 开启手动事务，已开启时抛错 */
export function 开启事务(数据库名 : string) : void {
	开始事务(数据库名)
}

/** 提交事务，未开启时抛错 */
export function 提交事务(数据库名 : string) : void {
	提交事务核心(数据库名)
}

/** 回滚事务，未开启时抛错 */
export function 回滚事务(数据库名 : string) : void {
	回滚事务核心(数据库名)
}

/** 是否处于手动事务中 */
export function 是否在事务中(数据库名 : string) : boolean {
	return 是否在事务中核心(数据库名)
}

/**
 * 在一个事务里执行多条 SQL，全部成功才提交，任意一条失败整体回滚
 * 不能在已经手动开启的事务里调用
 */
export function 在一个事务里执行(参数 : 批量执行参数) : 批量执行结果 {
	return 执行事务(参数)
}

/** 在一个事务里执行多条 SQL（异步） */
export function 在一个事务里执行异步(参数 : 事务异步参数) : void {
	const 入参 : 批量执行参数 = {
		数据库名: 参数.数据库名,
		语句集合: 参数.语句集合
	}
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			return 执行事务(入参) as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 批量执行结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/* ============================================================
 * 表结构
