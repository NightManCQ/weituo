/* ============================================================
 * 事务
 * ============================================================ */

export function 开始事务(参数 : 打开打开SQLite事务参数) : void {
	开始Transaction核心(参数.数据库名)
}

export function 提交事务(参数 : 打开打开SQLite事务参数) : void {
	确认Transaction核心(参数.数据库名)
}

export function 回滚事务(参数 : 打开打开SQLite事务参数) : void {
	抛异常Transaction核心(参数.数据库名)
}

export function 是否在事务中(参数 : 打开打开SQLite事务参数) : boolean {
	return 是否在Transaction核心(参数.数据库名)
}

export function 执行事务(参数 : 打开打开SQLite事务异步参数) : void {
	异步执行({
		任务: function() : any {
			开始Transaction核心(参数.数据库名)
			try {
				for (let 序号 = 0; 序号 < 参数.SQL语句集合.length; 序号++) {
					const 一条 : SQL语句 = 参数.SQL语句集合[序号]
					执行SQL核心({
						数据库名: 参数.数据库名,
						SQL语句: 一条.SQL语句,
						SQL参数: 一条.SQL参数 ?? null
					})
				}
				确认Transaction核心(参数.数据库名)
			} catch (异常 : any) {
				抛异常Transaction核心(参数.数据库名)
				throw 异常
			}
			return null
		},
		成功回调: 参数.success ?? null,
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

