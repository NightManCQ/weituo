/** 建表：已存在则直接返回，不重复执行 DDL */
export function 创建表(参数 : 建表参数) : void {
	建表(参数)
}

/** 判断表是否存在 */
export function 表是否存在(参数 : 表参数) : boolean {
	return 表是否存在核心(参数)
}

/** 删表 */
export function 删除表(参数 : 表参数) : void {
	删表(参数)
}

/** 清空表数据，并重置自增序号 */
export function 清空表(参数 : 表参数) : void {
	清空表核心(参数)
}

/** 判断列是否存在，用于表结构升级时补列 */
export function 列是否存在(参数 : 列参数) : boolean {
	return 列是否存在核心(参数)
}

/** 建索引 */
export function 创建索引(参数 : 建索引参数) : void {
	建索引(参数)
}

/** 删索引 */
export function 删除索引(参数 : 删索引参数) : void {
	删索引(参数)
}

/* ============================================================
 * 键值表
 * ============================================================ */

/** 写键值，键已存在则覆盖；值为 null 表示删除内容 */
export function 存储键值(参数 : 存键值参数) : void {
	存键值(参数)
}

/** 读键值，不存在返回 null */
export function 读取键值(参数 : 取键值参数) : string | null {
	return 读键值(参数)
}

/** 删键值 */
export function 删除键值(参数 : 取键值参数) : void {
	删键值(参数)
