/** 执行一条写 SQL（INSERT / UPDATE / DELETE / DDL） */
export function 执行SQL(参数 : 执行SQL参数) : 执行结果 {
	return 执行(参数)
}

/** 执行一条写 SQL（异步） */
export function 执行SQL异步(参数 : 执行SQL异步参数) : void {
	const 入参 : 执行SQL参数 = {
		数据库名: 参数.数据库名,
		SQL: 参数.SQL,
		参数: 参数.参数 ?? null
	}
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			return 执行(入参) as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 执行结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 依次执行多条 SQL，不在事务中时自动包一层事务 */
export function 批量执行SQL(参数 : 批量执行参数) : 批量执行结果 {
	return 批量执行(参数)
}

/** 批量执行 SQL（异步） */
export function 批量执行SQL异步(参数 : 批量执行异步参数) : void {
	const 入参 : 批量执行参数 = {
		数据库名: 参数.数据库名,
		语句集合: 参数.语句集合
	}
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			return 批量执行(入参) as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 批量执行结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 执行查询，返回列名与数据行 */
export function 查询SQL(参数 : 查询SQL参数) : 查询结果 {
	return 查询(参数)
}

/** 执行查询（异步） */
export function 查询SQL异步(参数 : 查询SQL异步参数) : void {
	const 入参 : 查询SQL参数 = {
		数据库名: 参数.数据库名,
		SQL: 参数.SQL,
		参数: 参数.参数 ?? null
	}
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			return 查询(入参) as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 查询结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 只取第一行，没有结果返回 null */
export function 查询单行(参数 : 查询SQL参数) : SQLite数据行 | null {
	const 结果 = 查询(参数)
	if (结果.行集合.length == 0) {
		return null
	}
	return 结果.行集合[0]
}

/** 只取第一行第一列 */
export function 查询单个值(参数 : 查询SQL参数) : SQLite值 {
	return 查询单值(参数)
}

/** 取 COUNT 类查询的数字结果 */
export function 查询记录数(参数 : 查询SQL参数) : number {
	return 查询数量(参数)
}

