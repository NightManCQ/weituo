/* ============================================================
 * Web 端专属：WASM 初始化
 * ============================================================ */

/**
 * 加载 SQLite 官方 WASM，业务层在调用任何同步 API 之前必须先 await 一次
 * 参数：可选的自定义模块地址（把 index.mjs 与 sqlite3.wasm 放同一目录）
 */
export async function 准备SQLite(地址? : string) : Promise<boolean> {
	if (地址 != null && 地址!.length > 0) {
		设置模块地址(地址!)
	}
	await 加载引擎()
	return 引擎是否已就绪()
}

/** WASM 是否已就绪 */
export function SQLite是否已就绪() : boolean {
	return 引擎是否已就绪()
}

/** 换成自托管的 SQLite WASM 地址（index.mjs + sqlite3.wasm 同目录） */
export function 设置SQLite模块地址(地址 : string) : void {
	设置模块地址(地址)
}

/** 当前 SQLite WASM 地址 */
export function 取得SQLite模块地址() : string {
	return 取得模块地址()
}

/** 实际会依次尝试的地址列表，资源加载出问题时先看这里 */
export function 候选SQLite模块地址() : Array<string> {
	return 候选模块地址()
}

/**
 * 逃生通道：业务层自己 import 官方模块后注入进来，优先级高于地址加载
 * 某些打包器会让 `import(变量)` 失效，这时改成：
 *   import sqlite3Module from '/static/sqlite/index.mjs'
 *   注入SQLite模块(sqlite3Module)
 */
export function 注入SQLite模块(模块 : any) : void {
	注入模块(模块)
}

/** 取 SQLite 库版本号，例如 3.54.1 */
export function 取得SQLite版本号() : string {
	return 取SQLite版本()
}

/** localStorage 里当前占用的字节数（kvvfs 上限约 5MB） */
export function 取得Web存储占用() : number {
	return 取得存储占用()
}

/* ============================================================
 * 统一错误处理
 * ============================================================ */

/**
 * 把底层抛出的任意异常，解析成结构化的 SQLite失败
 * UTS 的 throw new Error() 在 Web 端就是普通 Error，
 * 错误信息以 [错误码] 开头，这里剥掉前缀还原成 errCode + errMsg
 */
export function 解析SQLite异常(异常 : any) : SQLite失败 {
	let 错误信息 = ''
	let 错误码 = SQLite未知错误码

	try {
		if (异常 == null) {
			错误信息 = '未知错误'
		} else {
			错误信息 = '' + 异常
		}
	} catch (忽略异常) {
		错误信息 = '解析异常时再次出错'
	}

	const 前缀位置 = 错误信息.indexOf(SQLite错误前缀开始)
	if (前缀位置 >= 0) {
		const 后半 = 错误信息.substring(前缀位置)
		const 后缀位置 = 后半.indexOf(']')
		if (后缀位置 > 0) {
			const 码文本 = 后半.substring(1, 后缀位置)
			const 解析结果 = Number.parseFloat(码文本)
			if (解析结果 != 解析结果) {
				错误码 = SQLite未知错误码
			} else {
				错误码 = 解析结果
			}
			错误信息 = 后半.substring(后缀位置 + 1)
		}
	}

	if (错误信息.length == 0) {
		错误信息 = 取得错误说明(错误码)
	}

	const 失败 : SQLite失败 = {
		errCode: 错误码,
		errMsg: 错误信息,
		errSubject: SQLite错误主题
	}
	return 失败
}

/* ============================================================
 * 异步包装
 * ============================================================ */

/** 异步包装的内部参数 */
type 异步回调包 = {
	任务 : (() => any)
	成功回调 : ((任意结果 : any | null) => void) | null
	失败回调 : ((失败 : SQLite失败) => void) | null
	完成回调 : ((任意结果 : any | null) => void) | null
}

/**
 * 统一异步包装：先确保 WASM 已加载，再执行任务，最后统一回调
 * JS 是单线程，这里不再做线程切换，只保证回调顺序与 Android 端一致
 */
function 异步执行(包 : 异步回调包) : void {
	void 跑异步(包.任务, 包.成功回调, 包.失败回调, 包.完成回调)
}

async function 跑异步(
	任务 : () => any,
	成功回调 : ((任意结果 : any | null) => void) | null,
	失败回调 : ((失败 : SQLite失败) => void) | null,
	完成回调 : ((任意结果 : any | null) => void) | null
) : Promise<void> {
	let 结果 : any | null = null
	let 失败 : SQLite失败 | null = null

	try {
		await 加载引擎()
		结果 = 任务()
	} catch (异常) {
		失败 = 解析SQLite异常(异常)
	}

	if (失败 != null) {
		if (失败回调 != null) {
			失败回调!(失败!)
		}
	} else {
		if (成功回调 != null) {
			成功回调!(结果)
		}
	}
	if (完成回调 != null) {
		if (失败 != null) {
			完成回调!(失败!)
		} else {
			完成回调!(结果)
		}
	}
}

/* ============================================================
 * 打开 / 关闭 / 删除
 * ============================================================ */

/** 打开数据库，同名库重复调用是幂等的 */
export function 打开数据库(参数 : 打开数据库参数) : 打开数据库结果 {
	return 打开(参数)
}

/** 打开数据库（异步） */
export function 打开数据库异步(参数 : 打开数据库异步参数) : void {
	const 入参 : 打开数据库参数 = {
		数据库名: 参数.数据库名,
		版本: 参数.版本 ?? null,
		路径: 参数.路径 ?? null,
		只读: 参数.只读 ?? false,
		预写日志: 参数.预写日志 ?? null,
		外键约束: 参数.外键约束 ?? null
	}
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			return 打开(入参) as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 打开数据库结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 关闭数据库 */
export function 关闭数据库(数据库名 : string) : void {
	关闭(数据库名)
}

/** 关闭数据库（异步） */
export function 关闭数据库异步(参数 : 单库异步参数) : void {
	const 数据库名 = 参数.数据库名
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			关闭(数据库名)
			const 结果 : 操作结果 = { 数据库名: 数据库名, 是否成功: true }
			return 结果 as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 操作结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 关闭全部数据库，返回关闭的库数量 */
export function 关闭全部数据库() : number {
	return 关闭全部()
}

/** 删除数据库：清空 localStorage 里的 kvvfs 数据 */
export function 删除数据库(数据库名 : string) : void {
	删除(数据库名)
}

/** 删除数据库（异步） */
export function 删除数据库异步(参数 : 单库异步参数) : void {
	const 数据库名 = 参数.数据库名
	const 用户成功 = 参数.success ?? null
	异步执行({
		任务: function() : any {
			删除(数据库名)
			const 结果 : 操作结果 = { 数据库名: 数据库名, 是否成功: true }
			return 结果 as any
		},
		成功回调: function(任意结果 : any | null) : void {
			if (用户成功 != null) {
				用户成功!(任意结果! as 操作结果)
			}
		},
		失败回调: 参数.fail ?? null,
		完成回调: 参数.complete ?? null
	})
}

/** 数据库是否已打开 */
export function 数据库是否已打开(数据库名 : string) : boolean {
