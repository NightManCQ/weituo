/**
 * cq-mqtt 插件 · 前端 SQLite 引擎 · Web 端对外 API 层（utssdk/web）
 *
 * 这一层的导出项与 app-android/index.uts **逐一对齐**，业务层同一份
 * `import { 打开数据库, 执行SQL, ... } from '@/uni_modules/cq-mqtt'`
 * 在 Android 与 H5 上都能编译通过、行为一致。
 *
 * 与 Android 端唯一的差别：Web 端底层是 SQLite 官方 WASM，
 * 模块本身必须异步加载，因此多了一个 `准备SQLite()`。
 * 规则很简单：
 *   1. 任意同步 API 之前，先 `await 准备SQLite()` 一次（幂等，可重复调用）；
 *   2. 没 await 就调同步 API，会抛 [9010014]，提示很明确；
 *   3. 所有 `*异步` 版本内部会自动 await，不用调用方关心。
 *
 * 存储：kvvfs（localStorage），单库、约 5MB 上限，详见 sqlite.uts 头部说明。
 */

import {
	SQLite值,
	SQLite数据行,
	SQL语句,
	打开数据库参数,
	打开数据库结果,
	单库参数,
	执行SQL参数,
	批量执行参数,
	查询SQL参数,
	建表参数,
	建索引参数,
	删索引参数,
	表参数,
	列参数,
	存键值参数,
	取键值参数,
	设版本参数,
	执行结果,
	批量执行结果,
	查询结果,
	操作结果,
	SQLite失败,
	打开数据库异步参数,
	执行SQL异步参数,
	批量执行异步参数,
	查询SQL异步参数,
	事务异步参数,
	单库异步参数
} from '../interface.uts'
import { SQLite错误主题, SQLite未知错误码, SQLite错误前缀开始, 取得错误说明 } from '../unierror.uts'
import {
	设置模块地址,
	取得模块地址,
	引擎是否已就绪,
	加载引擎,
	取连接,
	打开,
	关闭,
	关闭全部,
	删除,
	是否已打开,
	文件是否存在,
	取得路径,
	已打开列表,
	执行,
	批量执行,
	查询,
	查询单值,
	查询数量,
	开始事务,
	提交事务核心,
	回滚事务核心,
	是否在事务中核心,
	执行事务,
	建表,
	表是否存在核心,
	删表,
	清空表核心,
	列是否存在核心,
	建索引,
	删索引,
	存键值,
	读键值,
	删键值,
	清空键值核心,
