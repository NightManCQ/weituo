/**
 * cq-mqtt 插件 · 前端 SQLite 引擎 · 错误定义
 *
 * 按 uni 插件错误码规范，统一以 901xxxx 编号。
 *
 * 注意：UTS 的 UniError 并不是异常对象，不能直接 throw，
 * 因此底层统一 throw Error，错误信息以 [错误码] 开头，
 * 由 index.uts 的 解析SQLite异常() 剥掉前缀、还原成结构化 SQLite失败。
 *
 * 这里刻意不使用模块顶层的 Map 常量表：
 * UTS 会把模块级可执行语句编到 Kotlin 的初始化块里，容易踩坑，
 * 用 switch 形式的函数查表最简单也最稳。
 */

/** 错误主题，对应 uni 的 errSubject */
export const SQLite错误主题 = 'cq-mqtt-sqlite'

/** 归不到具体分类时的兜底错误码 */
export const SQLite未知错误码 = 9010099

/** 错误信息前缀，形如 [9010002]数据库尚未打开 */
export const SQLite错误前缀开始 = '['

/** 按错误码取文案，查不到时返回未知错误 */
export function 取得错误说明(错误码 : number) : string {
	if (错误码 == 9010001) {
		return '参数缺失或不合法'
	}
	if (错误码 == 9010002) {
		return '数据库尚未打开'
	}
	if (错误码 == 9010003) {
		return '获取应用上下文失败'
	}
	if (错误码 == 9010004) {
		return '打开数据库失败'
	}
	if (错误码 == 9010005) {
		return '执行 SQL 失败'
	}
	if (错误码 == 9010006) {
		return '查询失败'
	}
	if (错误码 == 9010007) {
		return '关闭数据库失败'
	}
	if (错误码 == 9010008) {
		return '删除数据库失败'
	}
	if (错误码 == 9010009) {
		return '事务尚未开启'
	}
	if (错误码 == 9010010) {
		return '事务进行中不允许执行该操作'
	}
	if (错误码 == 9010011) {
		return '查询参数不支持 null，请改写 SQL'
	}
	if (错误码 == 9010012) {
		return '键值表操作失败'
	}
	if (错误码 == 9010013) {
		return '事务已经开启，请勿重复开启'
	}
	if (错误码 == 9010014) {
		return 'Web 端 SQLite 尚未就绪，请先 await 准备SQLite()'
	}
	if (错误码 == 9010015) {
		return 'Web 端不支持该操作'
	}
	return '未知错误'
}
