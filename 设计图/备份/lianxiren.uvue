<script setup lang="ts">
import { onShow } from '@dcloudio/uni-app'
import { computed, ref } from 'vue'
import type { 联系人列表数据, 用户 } from '../../common/leixing'
import { 读取当前用户 } from '../../common/wangluo'
import { 联系人列表, 刷新联系人列表 } from './联系人列表'

type 联系人项目 = 联系人列表数据['数据'][number]
const 当前用户 = ref<用户 | null>(null)
const 搜索 = ref('')
const 正在加载 = ref(false)
const 错误 = ref('')
const 联系人项目列表 = computed(() => {
  const 关键字 = 搜索.value.toLowerCase()
  return (联系人列表.value?.数据 || []).filter((项目) => {
    const 名称 = 项目.项目类型 == '好友'
      ? `${项目.昵称} ${项目.登录名}`
      : `${项目.群组名称} ${项目.最近消息 || ''}`
    return 名称.toLowerCase().includes(关键字)
  })
})

async function 刷新() {
  if (当前用户.value == null) return
  正在加载.value = true
  错误.value = ''
  try {
    await 刷新联系人列表()
  } catch (原因) {
    错误.value = 原因 instanceof Error ? 原因.message : '加载联系人失败'
  } finally {
    正在加载.value = false
  }
}

// 联系人行的唯一键：好友用用户编号，群聊用群组编号，前缀用来区分两种类型
function 项目键(项目: 联系人项目): string {
  return 项目.项目类型 == '好友' ? `好友:${项目.用户编号}` : `群聊:${项目.群组编号}`
}

// 进入聊天页：四个参数的结构与「消息」页打开会话时保持一致
// hui_hua = 会话编号，ming_cheng = 会话名称，lei_xing = 会话类型，bian_hao = 业务编号
// 名称必须传真实值并编码，传占位文字会让聊天页顶部一直显示「聊天」
function 进入聊天(会话编号: string, 会话名称: string, 会话类型: string, 业务编号: string) {
  if (!会话编号) {
    uni.showToast({ title: '编号缺失，无法打开聊天', icon: 'none' })
    return
  }
  uni.navigateTo({
    url: `/pages/liaotian/liaotian?hui_hua=${encodeURIComponent(会话编号)}&ming_cheng=${encodeURIComponent(会话名称 || '聊天')}&lei_xing=${会话类型}&bian_hao=${encodeURIComponent(业务编号)}`,
  })
}

// 这里不能写成 @click="打开联系人(项目)"：web 端编译会把带参数的写法做成渲染上下文里的事件缓存，
// 所有行共用第一次迭代创建的那个闭包，点哪一行都会打开第一行。
// 与「消息」页保持一致：行上挂 data-key，处理函数不带参数，从 dataset 取键再回查列表。
function 打开联系人(事件: { currentTarget: { dataset: Record<string, unknown> } }) {
  const 键 = 事件.currentTarget.dataset['key']
  if (typeof 键 != 'string') return
  const 项目 = 联系人项目列表.value.find((候选) => 项目键(候选) == 键)
  if (项目 == null) return
  // 好友：联系人列表只给到好友的用户编号，没有私聊会话编号。
  // 后端 /my/friends/{编号}/messages 两种编号都接受，传用户编号会按好友关系找到（或创建）私聊会话，
  // 所以这里 hui_hua 和 bian_hao 都填好友用户编号。
  if (项目.项目类型 == '好友') {
    进入聊天(项目.用户编号, 项目.昵称, '好友', 项目.用户编号)
    return
  }
  // 群聊：聊天的拉取和发送都走 /groups/{群组编号}/messages，编号就是群组编号
  进入聊天(项目.群组编号, 项目.群组名称, '群聊', 项目.群组编号)
}

onShow(() => {
  当前用户.value = 读取当前用户()
})
</script>

<template>
  <view class="ye_mian">
    <view class="ye_mian_biao_ti liang_duan_dui_qi">
      <view><text class="biao_ti">联系人</text></view>
      <button class="ci_yao_an_niu" @click="刷新">刷新</button>
    </view>
    <view v-if="当前用户 == null" class="kong_zhuang_tai">
      <text>登录后查看联系人</text>
      <button class="zhu_yao_an_niu" @click="uni.switchTab({ url: '/pages/wode/wode' })">前往登录</button>
    </view>
    <template v-else>
      <input v-model="搜索" class="shu_ru_kuang" placeholder="搜索联系人" />
      <view class="cao_zuo_zu">
        <button class="zhu_yao_an_niu" @click="uni.navigateTo({ url: '/pages/chuanjianqun/chuanjianqun' })">创建群聊</button>
        <button class="ci_yao_an_niu" @click="uni.navigateTo({ url: '/pages/tianjiahaoyou/tianjiahaoyou' })">添加好友</button>
      </view>
      <view v-if="错误" class="ti_shi_xin_xi cuo_wu">{{ 错误 }}</view>
      <view
        v-for="项目 in 联系人项目列表"
        :key="项目键(项目)"
        class="lie_biao_hang ke_dian_ji"
        :data-key="项目键(项目)"
        @click="打开联系人"
      >
        <view class="zhan_kai">
          <text class="ka_pian_biao_ti">{{ 项目.项目类型 == '好友' ? 项目.昵称 : 项目.群组名称 }}</text>
          <text class="fu_zhu_wen_ben">
            {{ 项目.项目类型 == '好友' ? `@${项目.登录名}` : 项目.最近消息 || 项目.群组公告 || '还没有消息' }}
          </text>
        </view>
        <text class="jian_tou">›</text>
      </view>
      <view v-if="正在加载" class="kong_zhuang_tai">正在同步联系人…</view>
    </template>
  </view>
</template>
